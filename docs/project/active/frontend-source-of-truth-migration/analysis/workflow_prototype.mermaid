flowchart TD
    %% Base Styles
    classDef startFill fill:#fed7aa,stroke:#c2410c,stroke-width:2px;
    classDef decisionFill fill:#fef3c7,stroke:#b45309,stroke-width:2px;
    classDef processFill fill:#3b82f6,stroke:#1e3a5f,stroke-width:2px,color:#fff;
    classDef successFill fill:#a7f3d0,stroke:#047857,stroke-width:2px;

    start_node(("Start: User Lands on careercopilot.com")):::startFill

    auth["Sign Up / Create Account (/register)"]:::processFill
    goals["Set Career Goals & Target Roles (/onboarding)"]:::processFill

    create_resume{"Create Base Resume"}:::decisionFill

    import_li["Import via LinkedIn (/career/ingest)"]:::processFill
    upload_res["Upload Existing Resume (/career/ingest)"]:::processFill
    scratch["Build from Scratch (/career/ingest)"]:::processFill

    db["Centralised Career History Database"]:::processFill

    browse["Browse External Job Boards (e.g., Seek, LinkedIn)"]:::processFill
    save_job["Save Job Postings to Application Tracker (/tracker)"]:::processFill

    select_job["Select a Target Job in Job Queue (/job-queue)"]:::processFill
    analyze_jd["Analyse Job Description (/analysis)"]:::processFill
    match_score["View Match Score & Keyword Gaps (/analysis)"]:::processFill

    tailor["Tailor Resume for Specific Role"]:::processFill

    subgraph Tailoring["AI Tailoring Suite"]
        toggle["Manually Toggle Skills & Experiences"]:::processFill
        bullets["Use AI to Refine Bullet Points (/ksc-generator)"]:::processFill
        cover["Use AI to Generate Custom Cover Letter"]:::processFill
    end

    format["Format with ATS-Friendly Templates (/documents)"]:::processFill

    subs{"Subscription Level"}:::decisionFill
    free["Free Tier: Basic Templates & Limited AI"]:::processFill
    premium["Premium: Advanced Designs & Unlimited AI"]:::processFill

    download["Download Tailored PDF Resume (/documents)"]:::processFill
    apply["Manually Apply for the Job"]:::processFill
    update_tracker["Update Status in Kanban Tracker (/kanban)"]:::processFill
    practice["Utilise Interview Practice Hub"]:::successFill

    %% Flow
    start_node --> auth
    auth --> goals
    goals --> create_resume

    create_resume -- "Option 1" --> import_li
    create_resume -- "Option 2" --> upload_res
    create_resume -- "Option 3" --> scratch

    import_li & upload_res & scratch --> db

    db --> browse
    browse --> save_job
    save_job --> select_job
    select_job --> analyze_jd
    analyze_jd --> match_score
    match_score --> tailor

    tailor --> Tailoring
    Tailoring --> format

    format --> subs
    subs -- "Free" --> free
    subs -- "Premium" --> premium

    free & premium --> download
    download --> apply
    apply --> update_tracker
    update_tracker --> practice

    %% Layout Summary
    style Tailoring fill:#f8fafc,stroke:#cbd5e1,stroke-dasharray: 5 5
