    classDef route fill:#2A2420,stroke:#F14714,color:#DAF6B3,rx:4
    classDef layout fill:#1E1C19,stroke:#DAF674,color:#DAF674,rx:4
    classDef api fill:#1A2A1A,stroke:#48DA8B,color:#48DA8B,rx:8
    classDef store fill:#1A1A2A,stroke:#48B3DA,color:#48B3DA,rx:4
