    class BROWSER entry
    class GUARD guard
    class P1,P2,P3,P4,P5,P99 route
    class KR1,KR2,KR3,KR4,KR5 route
    class DASHBOARD,WELCOME,ONBOARD_PAGE,INGEST route
    class ANALYSIS_P,TRACKER_P,DOCS_P,OPPS_P route
    class CL_P,CL1,CL2,CL3,CL4 route
    class KSC_P,KSC1,KSC2,KSC3 route
