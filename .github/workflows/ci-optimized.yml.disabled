# .github/workflows/ci-optimized.yml
# Optimized CI workflow with better caching, parallel execution, and M3 compliance
name: CI - Optimized Build and Test

on:
  pull_request:
    branches: [develop, main]
  push:
    branches: [develop, main]
  workflow_dispatch:
    inputs:
      run_e2e_tests:
        description: "Run E2E tests"
        required: false
        default: true
        type: boolean
      run_performance_tests:
        description: "Run performance tests"
        required: false
        default: false
        type: boolean
      run_m3_compliance:
        description: "Run M3 compliance checks"
        required: false
        default: true
        type: boolean

permissions:
  contents: read
  pull-requests: write
  checks: write

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

env:
  NODE_VERSION: "20"
  PYTHON_VERSION: "3.13"
  PYTHONUNBUFFERED: "1"
  PYTHONDONTWRITEBYTECODE: "1"
  PIP_DISABLE_PIP_VERSION_CHECK: "1"

  # Docker registry configuration
  GCP_REGION: us-central1
  GCP_REGISTRY: us-central1-docker.pkg.dev
  GCP_IMAGE_NAME: backend
  GCP_PROJECT_ID: careercopilot-468811
  GCP_REPOSITORY: careercopilot

jobs:
  # ============================================================
  # CHANGE DETECTION (Optimized)
  # ============================================================
  changes:
    name: Detect Code Changes
    runs-on: ubuntu-latest
    outputs:
      frontend: ${{ steps.filter.outputs.frontend }}
      backend: ${{ steps.filter.outputs.backend }}
      functions: ${{ steps.filter.outputs.functions }}
      firestore_rules: ${{ steps.filter.outputs.firestore_rules }}
      e2e: ${{ steps.filter.outputs.e2e }}
      performance: ${{ steps.filter.outputs.performance }}
      m3_components: ${{ steps.filter.outputs.m3_components }}
    if: github.event_name != 'workflow_dispatch'
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 2

      - name: Calculate paths
        id: filter
        uses: dorny/paths-filter@v3
        with:
          filters: |
            frontend: &frontend-paths
              - 'frontend/**'
              - '.github/actions/setup-frontend/**'
              - 'yarn.lock'
              - 'package.json'
            backend: &backend-paths
              - 'backend/**'
              - '.github/actions/setup-backend/**'
            functions: &functions-paths
              - 'functions/**'
            firestore_rules: &firestore-paths
              - 'firestore.rules'
              - 'tests/**'
            e2e:
              - *frontend-paths
              - *backend-paths
              - 'docker-compose.e2e.yml'
            performance:
              - *backend-paths
            m3_components:
              - 'frontend/src/components/**'
              - 'frontend/src/styles/design-tokens.css'
              - '.claude/skills/frontend-migration/**'

  # ============================================================
  # SECURITY SCANNING (CodeQL)
  # ============================================================
  codeql:
    name: CodeQL Security Analysis
    runs-on: ubuntu-latest
    permissions:
      security-events: write
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.backend == 'true' || needs.changes.outputs.frontend == 'true'
    needs: [changes]
    strategy:
      fail-fast: false
      matrix:
        language: ["python", "javascript"]
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: ${{ matrix.language }}
          queries: security-extended,security-and-quality

      - name: Autobuild
        uses: github/codeql-action/autobuild@v3

      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3
        with:
          category: "/language:${{matrix.language}}"

  # ============================================================
  # FRONTEND CHECKS (Parallelized)
  # ============================================================
  frontend-checks:
    name: Frontend - ${{ matrix.check-type }}
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.frontend == 'true'
    needs: [changes]
    strategy:
      fail-fast: false
      matrix:
        check-type: [lint, type-check, test]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Enable Corepack for Yarn 4+
        run: corepack enable

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "yarn"
          cache-dependency-path: yarn.lock

      # Cache TypeScript build info
      - name: Cache TypeScript build info
        if: matrix.check-type == 'type-check'
        uses: actions/cache@v4
        with:
          path: |
            frontend/tsconfig.tsbuildinfo
            frontend/.tsbuildinfo
          key: ${{ runner.os }}-tsbuildinfo-${{ hashFiles('frontend/tsconfig.json', 'frontend/src/**/*.ts', 'frontend/src/**/*.tsx') }}
          restore-keys: |
            ${{ runner.os }}-tsbuildinfo-

      # Cache Jest cache
      - name: Cache Jest cache
        if: matrix.check-type == 'test'
        uses: actions/cache@v4
        with:
          path: |
            frontend/.jest-cache
            frontend/coverage
          key: ${{ runner.os }}-jest-${{ hashFiles('frontend/jest.config.mjs', 'frontend/src/**/*.test.ts', 'frontend/src/**/*.test.tsx') }}
          restore-keys: |
            ${{ runner.os }}-jest-

      - name: Install dependencies
        run: yarn install --immutable

      - name: Run checks
        run: |
          case ${{ matrix.check-type }} in
            lint)
              echo "🔍 Running ESLint..."
              yarn workspace careercopilot-frontend lint
              ;;
            type-check)
              echo "🔷 Running TypeScript type checking..."
              yarn workspace careercopilot-frontend type-check
              ;;
            test)
              echo "🧪 Running Jest tests..."
              yarn workspace careercopilot-frontend test:ci
              ;;
          esac

      - name: Upload test coverage
        if: matrix.check-type == 'test'
        uses: codecov/codecov-action@v4
        with:
          files: frontend/coverage/coverage-final.json
          flags: frontend
          token: ${{ secrets.CODECOV_TOKEN }}
          fail_ci_if_error: false

  # ============================================================
  # FRONTEND BUILD (with Vite cache optimization)
  # ============================================================
  frontend-build:
    name: Frontend Build
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.frontend == 'true'
    needs: [changes, frontend-checks]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Enable Corepack for Yarn 4+
        run: corepack enable

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "yarn"
          cache-dependency-path: yarn.lock

      # Cache Vite build cache
      - name: Cache Vite build
        uses: actions/cache@v4
        with:
          path: |
            frontend/node_modules/.vite
            frontend/.vite
          key: ${{ runner.os }}-vite-${{ hashFiles('frontend/vite.config.ts', 'frontend/src/**') }}
          restore-keys: |
            ${{ runner.os }}-vite-

      - name: Install dependencies
        run: yarn install --immutable

      - name: Build frontend
        run: yarn workspace careercopilot-frontend build

      - name: Analyze bundle size
        run: |
          echo "📦 Bundle size analysis:"
          du -sh frontend/dist/
          echo ""
          echo "Top 10 largest files:"
          find frontend/dist -type f -exec du -h {} + | sort -rh | head -10

      - name: Upload frontend build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: frontend-dist
          path: frontend/dist/
          retention-days: 1

  # ============================================================
  # M3 COMPLIANCE CHECKS (NEW)
  # ============================================================
  m3-compliance:
    name: M3 Design Token Compliance
    runs-on: ubuntu-latest
    if: |
      (github.event_name == 'workflow_dispatch' && github.event.inputs.run_m3_compliance == 'true') ||
      (needs.changes.outputs.m3_components == 'true')
    needs: [changes]
    permissions:
      pull-requests: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check M3 Token Usage
        id: m3-analysis
        run: |
          echo "🎨 Analyzing M3 token compliance..."

          # Count M3 token usage
          M3_TOKEN_USAGE=$(grep -r "var(--sys-" frontend/src/components --include="*.tsx" --include="*.css" | wc -l)

          # Count hardcoded values
          HARDCODED_COLORS=$(grep -rn "color:\s*#[0-9a-fA-F]\{3,6\}\|color:\s*rgb\|color:\s*rgba" frontend/src/components --include="*.tsx" --include="*.css" | wc -l)
          HARDCODED_SPACING=$(grep -rn "padding:\s*[0-9]\+px\|margin:\s*[0-9]\+px\|gap:\s*[0-9]\+px" frontend/src/components --include="*.tsx" --include="*.css" | wc -l)
          HARDCODED_RADIUS=$(grep -rn "border-radius:\s*[0-9]\+px" frontend/src/components --include="*.tsx" --include="*.css" | wc -l)
          HARDCODED_SHADOWS=$(grep -rn "box-shadow:" frontend/src/components --include="*.tsx" --include="*.css" | grep -v "var(--" | wc -l)

          # Calculate compliance score (0-100%)
          TOTAL_STYLE_DECLARATIONS=$((M3_TOKEN_USAGE + HARDCODED_COLORS + HARDCODED_SPACING + HARDCODED_RADIUS + HARDCODED_SHADOWS))
          if [ $TOTAL_STYLE_DECLARATIONS -gt 0 ]; then
            COMPLIANCE_SCORE=$(( (M3_TOKEN_USAGE * 100) / TOTAL_STYLE_DECLARATIONS ))
          else
            COMPLIANCE_SCORE=0
          fi

          echo "📊 M3 Compliance Report:"
          echo "  ✅ M3 Token Usage: $M3_TOKEN_USAGE"
          echo "  ❌ Hardcoded Colors: $HARDCODED_COLORS"
          echo "  ❌ Hardcoded Spacing: $HARDCODED_SPACING"
          echo "  ❌ Hardcoded Border Radius: $HARDCODED_RADIUS"
          echo "  ❌ Hardcoded Shadows: $HARDCODED_SHADOWS"
          echo "  📈 Compliance Score: $COMPLIANCE_SCORE%"

          # Export for PR comment
          echo "m3_usage=$M3_TOKEN_USAGE" >> $GITHUB_OUTPUT
          echo "hardcoded_colors=$HARDCODED_COLORS" >> $GITHUB_OUTPUT
          echo "hardcoded_spacing=$HARDCODED_SPACING" >> $GITHUB_OUTPUT
          echo "hardcoded_radius=$HARDCODED_RADIUS" >> $GITHUB_OUTPUT
          echo "hardcoded_shadows=$HARDCODED_SHADOWS" >> $GITHUB_OUTPUT
          echo "compliance_score=$COMPLIANCE_SCORE" >> $GITHUB_OUTPUT

          # Fail if compliance is below threshold
          if [ $COMPLIANCE_SCORE -lt 50 ]; then
            echo "::warning::M3 compliance score is below 50% ($COMPLIANCE_SCORE%)"
          fi

      - name: Comment M3 Compliance Report on PR
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const m3Usage = '${{ steps.m3-analysis.outputs.m3_usage }}';
            const hardcodedColors = '${{ steps.m3-analysis.outputs.hardcoded_colors }}';
            const hardcodedSpacing = '${{ steps.m3-analysis.outputs.hardcoded_spacing }}';
            const hardcodedRadius = '${{ steps.m3-analysis.outputs.hardcoded_radius }}';
            const hardcodedShadows = '${{ steps.m3-analysis.outputs.hardcoded_shadows }}';
            const complianceScore = '${{ steps.m3-analysis.outputs.compliance_score }}';

            const emoji = complianceScore >= 80 ? '🎉' : complianceScore >= 50 ? '⚠️' : '❌';

            const body = `${emoji} **M3 Design Token Compliance Report**

            **Compliance Score: ${complianceScore}%**

            | Metric | Count |
            |--------|-------|
            | ✅ M3 Token Usage | ${m3Usage} |
            | ❌ Hardcoded Colors | ${hardcodedColors} |
            | ❌ Hardcoded Spacing | ${hardcodedSpacing} |
            | ❌ Hardcoded Border Radius | ${hardcodedRadius} |
            | ❌ Hardcoded Shadows | ${hardcodedShadows} |

            ${complianceScore < 50 ? `
            ### 🚨 Action Required

            Your compliance score is below 50%. Please migrate components to use M3 design tokens.

            **Available M3 Migration Skills:**
            - \`m3-color-themer\` - Migrate colors to tokens
            - \`m3-layout-refactor\` - Migrate spacing to tokens
            - \`m3-shape-refactor\` - Migrate border-radius to tokens
            - \`m3-elevation-refactor\` - Migrate shadows to tokens
            - \`batch-migration-orchestrator\` - Batch migrate multiple components

            **Example usage:**
            \`\`\`bash
            # Ask Claude to migrate components
            "Migrate the Button component to M3 Expressive design tokens"
            \`\`\`

            See \`.claude/skills/frontend-migration/\` for more details.
            ` : `
            ### ✅ Great Work!

            Your M3 compliance is ${complianceScore >= 80 ? 'excellent' : 'good'}. Keep using design tokens for consistency.
            `}

            ---
            *M3 Design System Infrastructure: 8 migration skills available*
            `;

            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: body,
            });

  # ============================================================
  # BACKEND CHECKS (existing, optimized)
  # ============================================================
  backend-static-checks:
    name: Backend - ${{ matrix.test-group }}
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.backend == 'true'
    needs: [changes]
    strategy:
      fail-fast: false
      matrix:
        test-group: [lint, format, security, mypy]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Backend Environment
        uses: ./.github/actions/setup-backend
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          install-mode: "full"
          cache-prefix: ${{ matrix.test-group }}

      - name: Run checks
        run: |
          case ${{ matrix.test-group }} in
            lint)
              flake8 backend/app/ --show-source --statistics --format=github
              ;;
            format)
              black --check backend/ --line-length=100 --diff
              ;;
            security)
              bandit -r backend/ -f json -o bandit-report.json || true
              ;;
            mypy)
              mypy backend/ --ignore-missing-imports --show-error-codes
              ;;
          esac

      - name: Upload bandit report
        if: matrix.test-group == 'security'
        uses: actions/upload-artifact@v4
        with:
          name: bandit-security-report
          path: bandit-report.json
          if-no-files-found: warn

  backend-tests:
    name: Backend Tests
    runs-on: ubuntu-latest
    environment: staging
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.backend == 'true'
    needs: [changes]
    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_USER: test
          POSTGRES_PASSWORD: test
          POSTGRES_DB: test_db
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U test -d test_db"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Backend Environment
        uses: ./.github/actions/setup-backend
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          install-mode: "full"
          cache-prefix: "tests"

      - name: Setup Testcontainers Cloud Client
        uses: AtomicJar/testcontainers-cloud-setup-action@v1
        with:
          token: ${{ secrets.TC_CLOUD_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build test image with cache
        uses: docker/build-push-action@v5
        with:
          context: ./backend
          load: true
          tags: backend-test:latest
          target: test
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Run all backend tests in container
        run: |
          docker run --network="host" \
            -e DATABASE_URL="postgresql://test:test@localhost:5432/test_db" \
            -e ENVIRONMENT="test" \
            -e GEMINI_API_KEY="${{ secrets.GEMINI_API_KEY_STAGING }}" \
            backend-test:latest

      - name: Upload coverage to Codecov
        uses: codecov/codecov-action@v4
        with:
          file: backend/coverage.xml
          flags: backend
          token: ${{ secrets.CODECOV_TOKEN }}
          fail_ci_if_error: false

  # ============================================================
  # FUNCTIONS TESTS
  # ============================================================
  functions:
    name: Functions Tests
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.functions == 'true'
    needs: [changes]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: "temurin"
          java-version: "17"

      - name: Enable Corepack for Yarn 4+
        run: corepack enable

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "yarn"
          cache-dependency-path: yarn.lock

      - name: Install dependencies
        run: yarn install --immutable

      - name: Lint functions
        run: yarn workspace functions lint

      - name: Build functions
        run: yarn workspace functions build

      - name: Run functions tests
        run: yarn workspace functions test:ci

  # ============================================================
  # FIRESTORE RULES TESTS
  # ============================================================
  test-firestore-rules:
    name: Test Firestore Rules
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.firestore_rules == 'true'
    needs: [changes]

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: "temurin"
          java-version: "17"

      - name: Enable Corepack for Yarn 4+
        run: corepack enable

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "npm"
          cache-dependency-path: tests/package-lock.json

      - name: Install Firebase Tools and test dependencies
        run: npm install -g firebase-tools && cd tests && npm ci

      - name: Start Firebase Emulators and run tests
        run: |
          cd tests
          firebase emulators:exec "npm test" --only firestore --project=careercopilot-test
        env:
          FIRESTORE_EMULATOR_HOST: localhost:8080
          FIREBASE_PROJECT: careercopilot-test

  # ============================================================
  # E2E TESTS
  # ============================================================
  e2e-tests:
    name: E2E Tests
    runs-on: ubuntu-latest
    timeout-minutes: 25
    needs: [changes, frontend-build, backend-tests]
    if: |
      (github.event_name == 'workflow_dispatch' && github.event.inputs.run_e2e_tests == 'true') ||
      (needs.changes.outputs.e2e == 'true')
    environment: staging

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download frontend artifact
        uses: actions/download-artifact@v4
        with:
          name: frontend-dist
          path: frontend/dist

      - name: Enable Corepack for Yarn 4+
        run: corepack enable

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "yarn"
          cache-dependency-path: yarn.lock

      - name: Install dependencies
        run: yarn install --immutable

      - name: Cache and Install Playwright browsers
        uses: actions/cache@v4
        with:
          path: ~/.cache/ms-playwright
          key: ${{ runner.os }}-playwright-${{ hashFiles('**/yarn.lock') }}
          restore-keys: |
            ${{ runner.os }}-playwright-

      - name: Start the stack
        run: docker compose -f docker-compose.e2e.yml up -d --build

      - name: Wait for services to be healthy
        run: |
          timeout 120 bash -c 'until docker compose -f docker-compose.e2e.yml ps | grep -q "Up (healthy)"; do sleep 2; done'

      - name: Run Playwright tests
        run: |
          yarn workspace careercopilot-frontend playwright install --with-deps
          yarn workspace careercopilot-frontend playwright test

      - name: Upload E2E test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: e2e-test-results
          path: |
            frontend/test-results/
            frontend/playwright-report/
          if-no-files-found: warn

      - name: Cleanup services
        if: always()
        run: docker compose -f docker-compose.e2e.yml down

  # ============================================================
  # PERFORMANCE TESTS
  # ============================================================
  performance-tests:
    name: Performance Tests
    runs-on: ubuntu-latest
    if: |
      (github.event_name == 'workflow_dispatch' && github.event.inputs.run_performance_tests == 'true') ||
      (needs.changes.outputs.performance == 'true')
    needs: [changes, backend-tests]
    environment: staging

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Backend
        uses: ./.github/actions/setup-backend
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          install-mode: "full"

      - name: Run performance tests
        run: |
          cd backend
          python -m pytest app/tests/performance/ -v --tb=short --disable-warnings --benchmark-only
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY_STAGING }}

  # ============================================================
  # QUALITY GATE
  # ============================================================
  quality-gate:
    name: Quality Gate
    runs-on: ubuntu-latest
    if: always()
    needs: [
      changes,
      codeql,
      frontend-checks,
      frontend-build,
      m3-compliance,
      backend-static-checks,
      backend-tests,
      functions,
      e2e-tests,
      test-firestore-rules
    ]
    timeout-minutes: 5
    permissions:
      pull-requests: write

    steps:
      - name: Check results
        run: |
          echo "📊 Checking all test results..."
          if [[ "${{ needs.codeql.result }}" == "failure" ]]; then exit 1; fi
          if [[ "${{ needs.frontend-checks.result }}" == "failure" ]]; then exit 1; fi
          if [[ "${{ needs.frontend-build.result }}" == "failure" ]]; then exit 1; fi
          if [[ "${{ needs.backend-static-checks.result }}" == "failure" ]]; then exit 1; fi
          if [[ "${{ needs.backend-tests.result }}" == "failure" ]]; then exit 1; fi
          if [[ "${{ needs.functions.result }}" == "failure" ]]; then exit 1; fi
          if [[ "${{ needs.e2e-tests.result }}" == "failure" ]]; then exit 1; fi
          if [[ "${{ needs.test-firestore-rules.result }}" == "failure" ]]; then exit 1; fi
          echo "✅ All required quality checks passed (or were skipped)!"

      - name: PR comment on failure
        if: failure()
        uses: actions/github-script@v7
        with:
          script: |
            const failedJobs = [];
            if ('${{ needs.codeql.result }}' === 'failure') failedJobs.push('CodeQL Security Analysis');
            if ('${{ needs.frontend-checks.result }}' === 'failure') failedJobs.push('Frontend Checks');
            if ('${{ needs.frontend-build.result }}' === 'failure') failedJobs.push('Frontend Build');
            if ('${{ needs.m3-compliance.result }}' === 'failure') failedJobs.push('M3 Compliance');
            if ('${{ needs.backend-static-checks.result }}' === 'failure') failedJobs.push('Backend Static Checks');
            if ('${{ needs.backend-tests.result }}' === 'failure') failedJobs.push('Backend Tests');
            if ('${{ needs.functions.result }}' === 'failure') failedJobs.push('Functions Tests');
            if ('${{ needs.e2e-tests.result }}' === 'failure') failedJobs.push('E2E Tests');
            if ('${{ needs.test-firestore-rules.result }}' === 'failure') failedJobs.push('Firestore Rules Tests');

            const failedList = failedJobs.map(job => `- ❌ ${job}`).join('\n');
            const comment = `## ❌ Quality Gate Failed\n\nThe following test suites failed:\n\n${failedList}\n\nPlease review the [workflow run](https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}) and fix the issues.`;

            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: comment,
            });

  # ============================================================
  # BUILD AND PUSH BACKEND IMAGE
  # ============================================================
  build-and-push-backend:
    name: Build and Push Backend Image
    runs-on: ubuntu-latest
    needs: [changes, frontend-build, backend-tests, backend-static-checks]
    if: |
      always() &&
      !cancelled() &&
      (needs.frontend-build.result == 'success' || needs.frontend-build.result == 'skipped') &&
      (needs.backend-static-checks.result == 'success' || needs.backend-static-checks.result == 'skipped') &&
      (github.event_name == 'workflow_dispatch' || needs.changes.outputs.backend == 'true' || needs.changes.outputs.frontend == 'true') &&
      (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/develop')
    permissions:
      id-token: write
      contents: read

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Download frontend artifact
        uses: actions/download-artifact@v4
        with:
          name: frontend-dist
          path: backend/dist

      - name: Determine Target Environment
        id: env-vars
        run: |
          if [[ "${{ github.ref }}" == "refs/heads/main" ]]; then
            echo "TARGET_PROJECT_ID=${{ env.GCP_PROJECT_ID }}" >> $GITHUB_ENV
            echo "TARGET_REPOSITORY=${{ env.GCP_REPOSITORY }}" >> $GITHUB_ENV
            echo "GCP_WORKLOAD_IDENTITY_PROVIDER=${{ secrets.GCP_WORKLOAD_IDENTITY_PROVIDER }}" >> $GITHUB_ENV
            echo "GCP_SERVICE_ACCOUNT=${{ secrets.GCP_SERVICE_ACCOUNT }}" >> $GITHUB_ENV
          elif [[ "${{ github.ref }}" == "refs/heads/develop" ]]; then
            echo "TARGET_PROJECT_ID=careercopilot-staging" >> $GITHUB_ENV
            echo "TARGET_REPOSITORY=careercopilot-repo" >> $GITHUB_ENV
            echo "GCP_WORKLOAD_IDENTITY_PROVIDER=${{ secrets.GCP_STAGING_WORKLOAD_IDENTITY_PROVIDER }}" >> $GITHUB_ENV
            echo "GCP_SERVICE_ACCOUNT=${{ secrets.GCP_STAGING_SERVICE_ACCOUNT }}" >> $GITHUB_ENV
          fi

      - name: Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ env.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ env.GCP_SERVICE_ACCOUNT }}

      - name: Setup Google Cloud SDK
        uses: google-github-actions/setup-gcloud@v2
        with:
          version: 'latest'
          project_id: ${{ env.TARGET_PROJECT_ID }}

      - name: Configure Docker for GCR
        run: gcloud auth configure-docker ${{ env.GCP_REGISTRY }} --quiet

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build and push Docker image
        run: |
          IMAGE_BASE="${{ env.GCP_REGISTRY }}/${{ env.TARGET_PROJECT_ID }}/${{ env.TARGET_REPOSITORY }}/${{ env.GCP_IMAGE_NAME }}"
          SHORT_SHA="${{ github.sha }}"
          SHORT_SHA="${SHORT_SHA:0:7}"
          IMAGE_SHA="${IMAGE_BASE}:${SHORT_SHA}"
          IMAGE_LATEST="${IMAGE_BASE}:latest"

          echo "🐳 Building Docker image..."
          docker build \
            --target final \
            --tag "${IMAGE_SHA}" \
            --tag "${IMAGE_LATEST}" \
            --cache-from type=gha \
            --cache-to type=gha,mode=max \
            ./backend

          echo "📤 Pushing Docker image to Artifact Registry..."
          docker push "${IMAGE_SHA}"
          docker push "${IMAGE_LATEST}"

          echo "IMAGE_SHA=${IMAGE_SHA}" >> $GITHUB_OUTPUT
          echo "IMAGE_LATEST=${IMAGE_LATEST}" >> $GITHUB_OUTPUT

      - name: Add build summary
        run: |
          IMAGE_BASE="${{ env.GCP_REGISTRY }}/${{ env.TARGET_PROJECT_ID }}/${{ env.TARGET_REPOSITORY }}/${{ env.GCP_IMAGE_NAME }}"
          echo "### 🐳 Backend Image Pushed (${{ github.ref_name }})" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "✅ Image successfully pushed to Google Artifact Registry." >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Target Project:** ${{ env.TARGET_PROJECT_ID }}" >> $GITHUB_STEP_SUMMARY
          echo "**Target Repository:** ${{ env.TARGET_REPOSITORY }}" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Image Tags:**" >> $GITHUB_STEP_SUMMARY
          echo '```' >> $GITHUB_STEP_SUMMARY
          echo "${IMAGE_BASE}:${{ github.sha:0:7 }}" >> $GITHUB_STEP_SUMMARY
          echo "${IMAGE_BASE}:latest" >> $GITHUB_STEP_SUMMARY
          echo '```' >> $GITHUB_STEP_SUMMARY
