# CareerCopilot Backend Environment Configuration
# Copy this file to .env.local for local development

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Firebase/Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/firebase-key.json
GCP_PROJECT_ID=careercopilot-468811
GOOGLE_CLOUD_PROJECT=careercopilot-468811
GOOGLE_CLOUD_REGION=us-central1
FIREBASE_PROJECT_ID=careercopilot-468811

# Database Configuration (Local SQLite for Development)
DATABASE_URL=sqlite:///data/careercopilot-dev.db

# AI Service API Keys
# These are now automatically loaded from Google Secret Manager
# No need to set them in environment files
# OPENAI_API_KEY=<loaded from Secret Manager>
# ANTHROPIC_API_KEY=<loaded from Secret Manager>
# GEMINI_API_KEY=<loaded from Secret Manager>

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Performance Settings (Development)
MAX_WORKERS=2
DB_POOL_SIZE=3
ENABLE_NLP_PRELOAD=true

# Feature Flags (Development)
ENABLE_MULTI_AGENT=true
ENABLE_ML_ANALYSIS=true
ENABLE_WEB_SEARCH=true
ENABLE_EMAIL_NOTIFICATIONS=false

# Development Features
ENABLE_HOT_RELOAD=true
SHOW_DEBUG_INFO=true

# Genkit AI Configuration
ENABLE_GENKIT_FLOWS=true
DEFAULT_AI_MODEL=gemini-1.5-pro
GENKIT_ENV=development
GENKIT_LOG_LEVEL=INFO
ENABLE_TELEMETRY=true

# =======================================================
# SECURITY NOTES:
# =======================================================
# - AI API keys are automatically loaded from Google Secret Manager
# - Never commit real API keys to version control
# - Use separate projects for dev/staging/production
# - Configure proper IAM permissions for Secret Manager access
# =======================================================