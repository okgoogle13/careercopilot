# .dockerignore for the backend service
# Optimizes Docker build context by excluding unnecessary files
# Reduces image build time and size

# Ignore Git and other version control files
.git
.gitignore

# Ignore IDE and editor files
.idea/
.vscode/

# Ignore Python cache and virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env

# Ignore test artifacts and reports
.pytest_cache/
.coverage
coverage.xml
htmlcov/
bandit-report.json

# Ignore local development files
.env.example
.env.test

# Ignore documentation
docs/

# CRITICAL: Ignore the entire frontend directory and node_modules
# This is the most important exclusion to keep the build context small.
../frontend/
../node_modules/
