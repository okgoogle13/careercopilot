# CareerCopilot Production Environment Variables
# Copy this file to .env.production and fill in the values

# Core Environment
GCP_PROJECT_ID=careercopilot-468811
ENV=production
USE_SECRET_MANAGER=true

# Optional: Environment Variable Overrides
# (Secrets will be loaded from Secret Manager if not set here)

# OpenAI API Key (CRITICAL)
# OPENAI_API_KEY=your-openai_api_key_value

# Anthropic Claude API Key (CRITICAL)
# ANTHROPIC_API_KEY=your-anthropic_api_key_value

# Google Gemini API Key (CRITICAL)
# GEMINI_API_KEY=your-gemini_api_key_value

# JWT Secret Key (CRITICAL)
# JWT_SECRET_KEY=your-jwt_secret_key_value

# Database URL (CRITICAL)
# DATABASE_URL=your-database_url_value

# Redis Password (OPTIONAL)
# REDIS_PASSWORD=your-redis_password_value

# Firebase Admin SDK Credentials (CRITICAL)
# FIREBASE_CREDENTIALS_JSON=your-firebase_credentials_json_value

# Firebase Project ID (CRITICAL)
# FIREBASE_PROJECT_ID=your-firebase_project_id_value

# Firebase Storage Bucket (CRITICAL)
# FIREBASE_STORAGE_BUCKET=your-firebase_storage_bucket_value

# SendGrid API Key (OPTIONAL)
# SENDGRID_API_KEY=your-sendgrid_api_key_value
