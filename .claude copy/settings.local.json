{
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(jobs:*)",
      "Bash(xargs kill:*)",
      "Bash(cat:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npx tsc:*)",
      "Bash(yarn install:*)",
      "Bash(test:*)",
      "Bash(chmod:*)",
      "Bash(/Applications/careercopilot/setup-agent-infrasturcutre.sh)",
      "Bash(git push:*)",
      "Bash(yarn test:coverage:*)",
      "Bash(yarn test:*)",
      "Bash(while IFS= read -r line)",
      "Bash(do jules remote new --repo . --session \"$line\" done)",
      "Bash(xargs:*)",
      "Bash(do echo \"Launching Jules session for: $line:0:80...\" jules remote new --repo . --session \"$line\" done)",
      "Bash(npm test:*)"
    ],
    "deny": [],
    "ask": []
  },
  "outputStyle": "default"
}
