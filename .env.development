# CareerCopilot Development Environment
# Generated from .env.template

# ====================================
# ENVIRONMENT IDENTIFICATION
# ====================================
ENVIRONMENT=development

# ====================================
# FIREBASE/GOOGLE CLOUD CONFIGURATION
# ====================================
GOOGLE_APPLICATION_CREDENTIALS=firebase-staging-key.json
GCP_PROJECT_ID=careercopilot-staging
GOOGLE_CLOUD_PROJECT=careercopilot-staging
FIREBASE_PROJECT_ID=careercopilot-staging
FIREBASE_STORAGE_BUCKET=careercopilot-staging.appspot.com

# ====================================
# DATABASE CONFIGURATION
# ====================================
DATABASE_URL=sqlite:///data/careercopilot.db

# ====================================
# AI SERVICE API KEYS
# ====================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# ====================================
# VECTOR DATABASE
# ====================================
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment-here
PINECONE_INDEX_NAME=careercopilot-dev

# ====================================
# SEARCH APIS
# ====================================
SERP_API_KEY=your-serp-api-key-here

# ====================================
# APPLICATION SETTINGS
# ====================================
DEBUG=true
LOG_LEVEL=DEBUG

# ====================================
# SECURITY SETTINGS
# ====================================
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====================================
# DATABASE CREDENTIALS
# ====================================
DB_USER=dev_user
DB_PASS=dev_password

# ====================================
# REDIS CONFIGURATION
# ====================================
REDIS_PASSWORD=dev-redis-password
REDIS_URL=redis://localhost:6379/0

# ====================================
# PERFORMANCE SETTINGS
# ====================================
MAX_WORKERS=2
DB_POOL_SIZE=3

# ====================================
# FEATURE FLAGS
# ====================================
ENABLE_MULTI_AGENT=true
ENABLE_ML_ANALYSIS=true
ENABLE_WEB_SEARCH=true
ENABLE_EMAIL_NOTIFICATIONS=false

# ====================================
# MONITORING
# ====================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=dev-grafana-password

# ====================================
# RATE LIMITING
# ====================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
