  "typography": {
    "families": {
      "hologram": "Nabla",
      "hero": "Roboto Flex",
      "human": "Roboto Serif",
      "ai": "Roboto Flex",
      "data": "Roboto Flex",
      "brand": "'Poppins', -apple-system, BlinkMacSystemFont, sans-serif",
      "plain": "'Plus Jakarta Sans Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "code": "'JetBrains Mono', 'SF Mono', 'Consolas', 'Monaco', monospace"
    },
    "axes": {
      "hero": {
        "wdth": 150,
        "wght": 800,
        "YTUC": 760,
        "GRAD": 0,
        "opsz": 24
      },
      "human": {
        "wdth": 100,
        "wght": 400,
        "opsz": 24,
        "GRAD": -25
      },
      "ai": {
        "wdth": 92,
        "wght": 450,
        "opsz": 16,
        "GRAD": 20
      },
      "data": {
        "wdth": 110,
        "wght": 500,
        "opsz": 8,
        "GRAD": 0
      }
    },
    "size": {
      "display-lg": "4.5rem",
      "display-md": "3.375rem",
      "display-sm": "2.5rem",
      "headline-lg": "2rem",
      "headline-md": "1.5rem",
      "body-md": "1rem",
      "body-sm": "0.875rem",
      "displayLarge": "57px",
