{
  "version": "2.0.0-m3-expressive",
  "description": "M3 Expressive Design System (Dark Mode with Motion Tokens)",
  "color": {
    "primary": "#A78BFA",
    "primary_light": "#C084FC",
    "primary_dark": "#7C3AED",
    "primary_contrast": "#1E1B4B",
    "secondary": "#C9C3DC",
    "secondary_light": "#D8D4E6",
    "secondary_dark": "#474459",
    "secondary_contrast": "#312E41",
    "tertiary": "#F472B6",
    "tertiary_light": "#F9A8D4",
    "tertiary_dark": "#EC4899",
    "tertiary_contrast": "#831843",
    "error": "#FFB4AB",
    "error_light": "#FFC9C2",
    "error_dark": "#93000A",
    "error_contrast": "#690005",
    "success": "#86EFAC",
    "success_light": "#BBF7D0",
    "success_dark": "#22C55E",
    "warning": "#FDE047",
    "warning_light": "#FEF08A",
    "warning_dark": "#FACC15",
    "info": "#67E8F9",
    "info_light": "#A5F3FC",
    "info_dark": "#06B6D4",
    "text_primary": "#F8FAFC",
    "text_secondary": "#E2E8F0",
    "text_disabled": "#928F99",
    "bg_default": "#131318",
    "bg_paper": "#1E1E23",
    "bg_elevated": "#262629",
    "divider": "#48464F",
