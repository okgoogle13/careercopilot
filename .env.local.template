# CareerCopilot API Keys Configuration
# Copy this file to .env.local and fill in your actual API keys
# DO NOT commit .env.local to version control

# ===========================================
# REQUIRED API KEYS - Add your actual keys
# ===========================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (for Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# ===========================================
# OPTIONAL API KEYS - For enhanced features
# ===========================================

# Perplexity API Key (for web search)
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# Pinecone API Key (alternative vector DB)
# Get from: https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment-here
PINECONE_INDEX_NAME=your-pinecone-index-name-here

# SERP API Key (for search results)
# Get from: https://serpapi.com/
SERP_API_KEY=your-serp-api-key-here

# ===========================================
# GOOGLE CLOUD SERVICE ACCOUNT
# ===========================================

# Service Account JSON (as a single line string)
# Get from: Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id",...}
