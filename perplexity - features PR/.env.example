# ================================
# PERSONAL CAREERCOPILOT CONFIGURATION
# ================================

# Personal Information
USER_NAME=Your Name
USER_EMAIL=nishantdougall@gmail.com
USER_ID=personal_user
USER_LOCATION=Northcote, VIC, Australia

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GEMINI_API_KEY=your-gemini-api-key-here
GENKIT_ENV=dev

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_DATABASE=careercopilot-personal
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_CREDENTIALS_PATH=path/to/your/firebase-credentials.json

# Gmail Integration
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# Personal Settings
ENVIRONMENT=personal
DEBUG_MODE=true
LOG_LEVEL=INFO

# Job Search Preferences
TARGET_LOCATIONS=Melbourne,Victoria,Remote
TARGET_ROLES=Social Worker,Case Manager,Community Services Worker,Program Coordinator
SALARY_RANGE_MIN=60000
SALARY_RANGE_MAX=85000
CURRENCY=AUD

# Automation Settings
DAILY_JOB_SCAN=true
AUTO_GENERATE_DOCUMENTS=true
EMAIL_NOTIFICATIONS=true
MORNING_SCAN_TIME=09:00
WEEKLY_REVIEW_DAY=friday

# Cache and Performance
ENABLE_CACHING=true
CACHE_TTL_HOURS=24
MAX_CONCURRENT_REQUESTS=5
API_TIMEOUT_SECONDS=30

# Job Board Sources (RSS feeds and APIs)
SEEK_RSS_URL=https://www.seek.com.au/jobs-in-social-work/rss
INDEED_RSS_URL=https://au.indeed.com/rss?q=social+work+melbourne
ETHICAL_JOBS_RSS=https://www.ethicaljobs.com.au/rss/jobs?category=social-services
APS_JOBS_RSS=https://www.apsjobs.gov.au/rss

# Document Templates
DEFAULT_RESUME_TEMPLATE=finance_to_social_work_resume
DEFAULT_COVER_LETTER_TEMPLATE=career_transition_cover_letter

# AI Model Settings
PRIMARY_MODEL=gemini-1.5-pro
SECONDARY_MODEL=gemini-1.5-flash
MAX_TOKENS=8192
TEMPERATURE=0.7

# Personal Career Story (for AI context)
CAREER_TRANSITION_FROM=Finance
CAREER_TRANSITION_TO=Social Work/Community Services
CAREER_MOTIVATION=Direct community impact and social justice
KEY_TRANSFERABLE_SKILLS=Financial analysis,Data analysis,Project management,Client relations

# Security and Privacy
ENCRYPT_LOCAL_DATA=true
DATA_RETENTION_DAYS=365
BACKUP_ENABLED=true
BACKUP_FREQUENCY=weekly

# Development Settings (set to false in production)
MOCK_EXTERNAL_APIS=false
SKIP_EMAIL_SENDING=false
VERBOSE_LOGGING=true