{
  "name": "careercopilot-plugin",
  "version": "1.0.0",
  "displayName": "Career Copilot Assistant",
  "description": "AI-powered plugin for career assistance workflows including resume optimization, cover letter generation, and job application management",
  "author": "Career Copilot Team",
  "license": "MIT",
  "homepage": "https://github.com/okgoogle13/careercopilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/okgoogle13/careercopilot.git"
  },
  "capabilities": [
    "resume-optimization",
    "cover-letter-generation",
    "ksc-response-generation",
    "job-description-analysis",
    "ats-scoring",
    "keyword-extraction"
  ],
  "requiredPermissions": [
    "filesystem:read",
    "filesystem:write",
    "api:call",
    "git:operations",
    "workspace:read"
  ],
  "entrypoint": {
    "script": "dist/plugin.js",
    "className": "CareerCopilotPlugin"
  },
  "configuration": {
    "apiBaseUrl": {
      "type": "string",
      "default": "http://localhost:8000",
      "description": "Backend API base URL for Career Copilot services",
      "scope": "machine-overridable"
    },
    "enableGenkit": {
      "type": "boolean",
      "default": true,
      "description": "Enable Genkit AI flows for advanced capabilities"
    },
    "enableNLPPreload": {
      "type": "boolean",
      "default": true,
      "description": "Enable NLP model preloading for better performance"
    },
    "defaultTone": {
      "type": "string",
      "enum": ["professional", "casual", "formal", "friendly"],
      "default": "professional",
      "description": "Default tone for AI-generated content"
    },
    "autoSaveEnabled": {
      "type": "boolean",
      "default": true,
      "description": "Automatically save generated content"
    },
    "debugMode": {
      "type": "boolean",
      "default": false,
      "description": "Enable debug logging and diagnostics"
    }
  },
  "commands": [
    {
      "id": "careercopilot.generateResume",
      "title": "Generate Tailored Resume",
      "category": "Career Copilot",
      "description": "Generate a resume optimized for a specific job description"
    },
    {
      "id": "careercopilot.generateCoverLetter",
      "title": "Generate Cover Letter",
      "category": "Career Copilot",
      "description": "Generate a customized cover letter with specified tone"
    },
    {
      "id": "careercopilot.analyzeJobDescription",
      "title": "Analyze Job Description",
      "category": "Career Copilot",
      "description": "Extract KSC criteria and key requirements from job description"
    },
    {
      "id": "careercopilot.generateKscResponses",
      "title": "Generate KSC Responses",
      "category": "Career Copilot",
      "description": "Generate Key Selection Criteria responses for a job"
    },
    {
      "id": "careercopilot.scoreAts",
      "title": "Score ATS Compatibility",
      "category": "Career Copilot",
      "description": "Analyze resume ATS compatibility and scoring"
    }
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "careercopilot-explorer",
          "title": "Career Copilot",
          "icon": "$(briefcase)"
        }
      ]
    },
    "views": {
      "careercopilot-explorer": [
        {
          "id": "careercopilot.projects",
          "name": "My Applications"
        },
        {
          "id": "careercopilot.generators",
          "name": "Generators"
        },
        {
          "id": "careercopilot.help",
          "name": "Help & Documentation"
        }
      ]
    }
  },
  "keybindings": [
    {
      "command": "careercopilot.generateResume",
      "key": "ctrl+alt+r",
      "mac": "cmd+alt+r",
      "when": "editorTextFocus"
    },
    {
      "command": "careercopilot.generateCoverLetter",
      "key": "ctrl+alt+c",
      "mac": "cmd+alt+c",
      "when": "editorTextFocus"
    }
  ],
  "dependencies": {
    "axios": "^1.13.2",
    "typescript": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "esbuild": "^0.18.0"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/plugin.ts --bundle --outfile=dist/plugin.js --platform=node --external:axios",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "validate": "node scripts/validate-manifest.js"
  },
  "manifest": {
    "schemaVersion": "1.0.0",
    "minClaudeVersion": "1.0.0",
    "maxClaudeVersion": "*",
    "compatibility": {
      "os": ["darwin", "linux", "win32"],
      "architecture": ["x64", "arm64"]
    }
  }
}
