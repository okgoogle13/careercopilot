{
  "name": "careercopilot",
  "version": "1.0.0",
  "description": "CareerCopilot application - AI-powered career management platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "frontend/packages/*",
    "functions"
  ],
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  },
  "resolutions": {
    "write-file-atomic": "^6.0.0",
    "strip-ansi": "6.0.1",
    "pretty-format": "^30.0.0",
    "minimatch": "^5.1.6",
    "esbuild": "^0.18.20",
    "@vitest/utils": "^4.0.6",
    "@vitest/pretty-format": "^4.0.6",
    "@vitest/runner": "^4.0.6",
    "@vitest/expect": "^4.0.6",
    "@vitest/snapshot": "^4.0.6",
    "@vitest/spy": "^4.0.6",
    "@vitest/ui": "^4.0.6",
    "pathe": "2.0.3",
    "sirv": "3.0.2",
    "ts-api-utils": "^2.4.0",
    "@joshwooding/vite-plugin-react-docgen-typescript": "0.6.2"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "cd frontend && yarn dev",
    "dev:functions": "cd functions && npm run serve",
    "build": "cd frontend && yarn build && cd ../functions && npm run build",
    "build:frontend": "cd frontend && yarn build",
    "build:functions": "cd functions && npm run build",
    "lint": "cd frontend && yarn lint && cd ../functions && npm run lint",
    "lint:ci": "cd frontend && yarn lint:ci && cd ../functions && npm run lint",
    "lint:fix": "cd frontend && yarn lint:fix && cd ../functions && npm run lint:fix",
    "lint:autofix": "./scripts/lint-autofix.sh",
    "test": "cd frontend && yarn test",
    "test:frontend": "cd frontend && yarn test",
    "test:functions": "cd functions && npm test",
    "test:e2e": "cd frontend && npx playwright test",
    "test:generate": "python3 scripts/run_test_automation_specialist.py",
    "test:backend": "cd backend && python -m pytest app/tests/ -v",
    "test:all": "npm run test:frontend && npm run test:functions && npm run test:backend && npm run test:e2e",
    "test:all:parallel": "npm-run-all --parallel test:frontend test:functions test:backend test:e2e",
    "build-and-test:parallel": "npm-run-all --parallel build test:all:parallel",
    "test:rules": "firebase emulators:exec --only firestore \"jest tests/firestore.rules.test.js --forceExit\"",
    "clean": "cd frontend && yarn clean && cd ../functions && npm run clean",
    "start": "cd frontend && yarn preview",
    "commit": "git-cz",
    "commitlint": "commitlint --edit $1",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit --pretty",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs": "jsdoc -c jsdoc.config.json",
    "docs:serve": "serve docs/api",
    "docs:clean": "rimraf docs/api",
    "docs:build": "yarn docs:clean && yarn docs"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [
    "career",
    "ai",
    "job-search",
    "resume",
    "applications",
    "automation"
  ],
  "author": "CareerCopilot Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/careercopilot/careercopilot.git"
  },
  "bugs": {
    "url": "https://github.com/careercopilot/careercopilot/issues"
  },
  "homepage": "https://github.com/careercopilot/careercopilot#readme",
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/lab": "^6.0.0-beta.19",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.6.0",
    "framer-motion": "^12.23.26",
    "input-otp": "^1.4.2",
    "lightningcss": "1.30.2",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.69.0",
    "react-resizable-panels": "^4.0.15",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@storybook/addon-links": "^8.1.11",
    "@storybook/addon-onboarding": "^8.1.11",
    "@storybook/blocks": "^8.1.11",
    "@storybook/core-server": "^7.6.21",
    "@storybook/jest": "^0.2.3",
    "@storybook/react": "^8.1.11",
    "@storybook/react-vite": "^8.1.11",
    "@storybook/testing-library": "^0.2.2",
    "@tailwindcss/oxide-darwin-x64": "^4.1.18",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "chromatic": "^13.3.5",
    "clean-jsdoc-theme": "^4.3.0",
    "husky": "^9.0.11",
    "jsdoc": "^4.0.3",
    "playwright": "^1.45.0",
    "prettier": "^3.3.2",
    "rimraf": "^6.0.1",
    "storybook": "^8.1.11",
    "ts-morph": "^23.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vitest": "^4.0.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
