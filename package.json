{
  "name": "careercopilot",
  "version": "1.0.0",
  "description": "CareerCopilot application - AI-powered career management platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "functions"
  ],
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:functions": "npm run serve --workspace=functions",
    "build": "npm run build --workspace=frontend && npm run build --workspace=functions",
    "build:frontend": "npm run build --workspace=frontend",
    "build:functions": "npm run deploy --workspace=functions",
    "type-check": "npm run type-check --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "lint:fix": "npm run lint:fix --workspace=frontend",
    "format": "npm run format --workspace=frontend",
    "format:check": "npm run format:check --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright-visual.config.ts",
    "test:all": "npm run test && npm run test:e2e",
    "install:all": "npm install && npm install --workspace=frontend && npm install --workspace=functions",
    "clean": "npm run clean --workspace=frontend && npm run clean --workspace=functions",
    "start": "npm run preview --workspace=frontend"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "dlv": "^1.1.3",
    "firebase": "^12.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.55.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@typescript-eslint/eslint-plugin": "8.40.0",
    "@typescript-eslint/parser": "8.40.0",
    "@vitejs/plugin-react": "5.0.1",
    "autoprefixer": "^10.4.21",
    "canvas": "3.2.0",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jest": "30.0.5",
    "jiti": "2.5.1",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.12",
    "terser": "5.43.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "7.1.3"
  },
  "keywords": [
    "career",
    "ai",
    "job-search",
    "resume",
    "applications",
    "automation"
  ],
  "author": "CareerCopilot Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/careercopilot/careercopilot.git"
  },
  "bugs": {
    "url": "https://github.com/careercopilot/careercopilot/issues"
  },
  "homepage": "https://github.com/careercopilot/careercopilot#readme"
}
