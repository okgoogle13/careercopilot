{
  "name": "careercopilot",
  "version": "1.0.0",
  "description": "CareerCopilot application - AI-powered career management platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "frontend/packages/*",
    "functions"
  ],
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  },
  "resolutions": {
    "write-file-atomic": "^6.0.0",
    "strip-ansi": "6.0.1",
    "pretty-format": "^30.0.0",
    "minimatch": "^9.0.5",
    "esbuild": "^0.18.20",
    "@vitest/utils": "^4.0.6",
    "@vitest/pretty-format": "^4.0.6",
    "@vitest/runner": "^4.0.6",
    "@vitest/expect": "^4.0.6",
    "@vitest/snapshot": "^4.0.6",
    "@vitest/spy": "^4.0.6",
    "@vitest/ui": "^4.0.6"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "cd frontend && yarn dev",
    "dev:functions": "cd functions && npm run serve",
    "build": "cd frontend && yarn build && cd ../functions && npm run build",
    "build:frontend": "cd frontend && yarn build",
    "build:functions": "cd functions && npm run build",
    "lint": "cd frontend && yarn lint && cd ../functions && npm run lint",
    "lint:ci": "cd frontend && yarn lint:ci && cd ../functions && npm run lint",
    "lint:fix": "cd frontend && yarn lint:fix && cd ../functions && npm run lint:fix",
    "lint:autofix": "./scripts/lint-autofix.sh",
    "test": "cd frontend && yarn test",
    "test:frontend": "cd frontend && yarn test",
    "test:functions": "cd functions && npm test",
    "test:e2e": "cd frontend && npx playwright test",
    "test:backend": "cd backend && python -m pytest app/tests/ -v",
    "test:all": "npm run test:frontend && npm run test:functions && npm run test:backend && npm run test:e2e",
    "test:rules": "firebase emulators:exec --only firestore \"jest tests/firestore.rules.test.js --forceExit\"",
    "clean": "cd frontend && yarn clean && cd ../functions && npm run clean",
    "start": "cd frontend && yarn preview",
    "commit": "git-cz",
    "commitlint": "commitlint --edit $1",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit --pretty",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.2",
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.2.2",
    "@firebase/app": "^0.10.14",
    "@firebase/auth": "^1.8.0",
    "@firebase/firestore": "^4.6.0",
    "@firebase/functions": "^0.13.0",
    "@firebase/storage": "^0.13.2",
    "@playwright/test": "1.55.0",
    "@storybook/addon-a11y": "^10.0.2",
    "@storybook/addon-docs": "^10.0.2",
    "@storybook/addon-essentials": "7.6.17",
    "@storybook/addon-interactions": "7.6.17",
    "@storybook/addon-links": "7.6.17",
    "@storybook/addon-onboarding": "^10.0.2",
    "@storybook/addon-vitest": "^10.0.2",
    "@storybook/blocks": "7.6.17",
    "@storybook/jest": "0.2.3",
    "@storybook/react": "7.6.17",
    "@storybook/react-vite": "^10.0.2",
    "@storybook/testing-library": "0.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/browser-playwright": "^4.0.6",
    "@vitest/coverage-v8": "^4.0.6",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.18.20",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-storybook": "^10.0.2",
    "firebase": "^12.2.1",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^6.4.0",
    "firebase-functions-test": "^3.4.1",
    "genkit": "^1.19.1",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "knip": "^5.63.0",
    "lint-staged": "^15.2.2",
    "playwright": "^1.56.1",
    "prettier": "^3.2.4",
    "storybook": "^10.0.2",
    "ts-morph": "^27.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [
    "career",
    "ai",
    "job-search",
    "resume",
    "applications",
    "automation"
  ],
  "author": "CareerCopilot Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/careercopilot/careercopilot.git"
  },
  "bugs": {
    "url": "https://github.com/careercopilot/careercopilot/issues"
  },
  "homepage": "https://github.com/careercopilot/careercopilot#readme",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "eslint": "^9.15.0",
    "react": "^19.1.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
