{
  "name": "careercopilot",
  "version": "1.0.0",
  "description": "CareerCopilot application - AI-powered career management platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "functions"
  ],
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  },
  "scripts": {
    "dev": "yarn workspace careercopilot-frontend run dev",
    "dev:functions": "cd functions && npm run serve",
    "build": "yarn workspace careercopilot-frontend run build && cd functions && npm run build",
    "build:frontend": "yarn workspace careercopilot-frontend run build",
    "build:functions": "cd functions && npm run build",
    "lint": "yarn workspace careercopilot-frontend run lint && cd functions && npm run lint",
    "lint:ci": "yarn workspace careercopilot-frontend run lint:ci && cd functions && npm run lint",
    "lint:fix": "yarn workspace careercopilot-frontend run lint:fix && cd functions && npm run lint:fix",
    "lint:autofix": "./scripts/lint-autofix.sh",
    "test": "yarn workspace careercopilot-frontend run test",
    "test:rules": "firebase emulators:exec --only firestore \"jest tests/firestore.rules.test.js --forceExit\"",
    "clean": "yarn workspace careercopilot-frontend run clean && cd functions && npm run clean",
    "start": "yarn workspace careercopilot-frontend run preview"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "1.55.0",
    "@types/node": "20",
    "firebase-admin": "^13.5.0",
    "firebase-functions-test": "^3.4.1",
    "genkit": "^1.19.1",
    "jest": "^30.1.3",
    "knip": "^5.63.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "career",
    "ai",
    "job-search",
    "resume",
    "applications",
    "automation"
  ],
  "author": "CareerCopilot Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/careercopilot/careercopilot.git"
  },
  "bugs": {
    "url": "https://github.com/careercopilot/careercopilot/issues"
  },
  "homepage": "https://github.com/careercopilot/careercopilot#readme",
  "dependencies": {
    "eslint": "^9.35.0"
  }
}
