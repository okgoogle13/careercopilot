{
  "handover_version": "1.0",
  "target_agent": "codex-cli",
  "task_id": "stage2_todo_marker_replacement",
  "priority": "P0",
  "estimated_duration_minutes": 60,
  "dependencies": ["stage1_complete"],

  "context": {
    "objective": "Replace 40 TODO[asset] markers in hi-fi blueprints with canonical token references from kr-solidarity-ui-token-map.json",
    "motivation": "Enable Stage 3 mockup generation by resolving all asset placeholders to production file paths",
    "related_docs": [
      "/docs/design/06b-asset-placement.md",
      "/frontend/public/assets/kr-solidarity-ui-token-map.json"
    ]
  },

  "tasks": [
    {
      "step": 1,
      "name": "pre_flight_validation",
      "description": "Validate prerequisites before making changes",
      "commands": [
        {
          "cmd": "test -f frontend/public/assets/kr-solidarity-ui-token-map.json",
          "description": "Verify token map exists",
          "required": true
        },
        {
          "cmd": "jq '.version' frontend/public/assets/kr-solidarity-ui-token-map.json",
          "description": "Check token map version",
          "expected_output_contains": "1.0"
        },
        {
          "cmd": "grep -r 'TODO\\[asset\\]' docs/design/hifi/ | wc -l",
          "description": "Count TODO markers to replace",
          "expected_output": "40",
          "store_as": "initial_todo_count"
        },
        {
          "cmd": "git status --porcelain docs/design/hifi/",
          "description": "Check for uncommitted changes",
          "expected_output": "",
          "warn_if_not_empty": true
        }
      ],
      "on_failure": "abort"
    },

    {
      "step": 2,
      "name": "create_backup",
      "description": "Backup hi-fi blueprints before modification",
      "commands": [
        {
          "cmd": "mkdir -p .backups/stage2-$(date +%Y%m%d-%H%M%S)",
          "description": "Create timestamped backup directory",
          "store_as": "backup_dir"
        },
        {
          "cmd": "cp -r docs/design/hifi/ $backup_dir/",
          "description": "Copy all hi-fi blueprints to backup"
        },
        {
          "cmd": "ls -la $backup_dir/hifi/ | wc -l",
          "description": "Verify backup contains 14 files",
          "expected_output_contains": "14"
        }
      ],
      "on_failure": "abort"
    },

    {
      "step": 3,
      "name": "load_token_map",
      "description": "Parse token map into memory for semantic matching",
      "script": "scripts/kr/load-token-map.js",
      "input": "frontend/public/assets/kr-solidarity-ui-token-map.json",
      "output": {
        "format": "json",
        "schema": {
          "tokens": "array of {id, name, description, path, status}",
          "ready_count": "number of status='ready' assets",
          "planned_count": "number of status='planned' assets"
        }
      },
      "validation": {
        "ready_count": ">=3",
        "planned_count": ">=7"
      }
    },

    {
      "step": 4,
      "name": "semantic_matching_config",
      "description": "Define semantic matching rules for TODO text → token ID",
      "config": {
        "matching_rules": [
          {
            "pattern": "Melbourne Laneway|substrate texture|concrete",
            "token_id": "KR-SOLID-033",
            "confidence": "high"
          },
          {
            "pattern": "Abstract Solidarity|resistance|fist",
            "token_id": "KR-SOLID-011",
            "confidence": "high"
          },
          {
            "pattern": "Halo Disk|radiant circle|navigation marker",
            "token_id": "KR-UI-002",
            "confidence": "high",
            "requires_generation": true
          },
          {
            "pattern": "Screenprint Grit|particles|dust|atmospheric",
            "token_id": "KR-UI-003",
            "confidence": "high",
            "requires_generation": true
          },
          {
            "pattern": "Blueprint Grid|technical grid",
            "token_id": "KR-UI-004",
            "confidence": "high",
            "requires_generation": true
          },
          {
            "pattern": "Charcoal Paper|substrate|stable background",
            "token_id": "KR-UI-005",
            "confidence": "medium",
            "requires_generation": true
          },
          {
            "pattern": "Blueprint Watermark|documentation context",
            "token_id": "KR-UI-006",
            "confidence": "medium",
            "requires_generation": true
          },
          {
            "pattern": "Wheat Paste|torn poster|edge texture",
            "token_id": "KR-UI-001",
            "confidence": "low",
            "requires_generation": true
          },
          {
            "pattern": "Screenprint Stamp|VERIFIED|approval",
            "token_id": "KR-UI-007",
            "confidence": "medium",
            "requires_generation": true
          }
        ],
        "fallback_strategy": "log_unmatched_for_manual_review"
      }
    },

    {
      "step": 5,
      "name": "execute_replacement",
      "description": "Replace TODO markers with token references across all hi-fi files",
      "script": "scripts/kr/replace-asset-tokens.mjs",
      "input_files": [
        "docs/design/hifi/SolidarityLanding-hifi.md",
        "docs/design/hifi/Authentication-hifi.md",
        "docs/design/hifi/Onboarding-hifi.md",
        "docs/design/hifi/Ingestion-hifi.md",
        "docs/design/hifi/AnalysisDashboard-hifi.md",
        "docs/design/hifi/OpportunityFeed-hifi.md",
        "docs/design/hifi/KanbanBoard-hifi.md",
        "docs/design/hifi/SplitScreenEditor-hifi.md",
        "docs/design/hifi/StudioDesigner-hifi.md",
        "docs/design/hifi/Settings-hifi.md",
        "docs/design/hifi/DashboardOverview-hifi.md",
        "docs/design/hifi/ApplicationFormFlow-hifi.md",
        "docs/design/hifi/JobSearchFlow-hifi.md",
        "docs/design/hifi/ProfileSettings-hifi.md"
      ],
      "replacement_logic": {
        "match_pattern": "// TODO\\[asset\\]:\\s*(.+?)(?:\\(Z-([0-9.]+)(?:,\\s*([0-9]+)%\\s*opacity)?\\))?",
        "extract_groups": {
          "1": "description",
          "2": "z_index",
          "3": "opacity"
        },
        "replacement_template": "- `{{{TOKEN_ID}}}` {{DESCRIPTION}}{{#Z_INDEX}} (Z-{{Z_INDEX}}{{#OPACITY}}, {{OPACITY}}% opacity{{/OPACITY}}){{/Z_INDEX}}{{#REQUIRES_GENERATION}} **[REQUIRES GENERATION]**{{/REQUIRES_GENERATION}}",
        "preserve_context": {
          "indent": true,
          "surrounding_lines": 2
        }
      },
      "output": {
        "replaced_count": "number",
        "unmatched_count": "number",
        "unmatched_list": "array of {file, line, text}"
      },
      "on_failure": "rollback_from_backup"
    },

    {
      "step": 6,
      "name": "validate_replacement",
      "description": "Verify all TODO markers replaced and files valid",
      "commands": [
        {
          "cmd": "grep -r 'TODO\\[asset\\]' docs/design/hifi/ | wc -l",
          "description": "Count remaining TODO markers",
          "expected_output": "0",
          "store_as": "remaining_todo_count"
        },
        {
          "cmd": "grep -r '{KR-SOLID-' docs/design/hifi/ | wc -l",
          "description": "Count KR-SOLID token references",
          "expected_output_min": 10,
          "store_as": "solid_token_count"
        },
        {
          "cmd": "grep -r '{KR-UI-' docs/design/hifi/ | wc -l",
          "description": "Count KR-UI token references",
          "expected_output_min": 20,
          "store_as": "ui_token_count"
        },
        {
          "cmd": "for file in docs/design/hifi/*.md; do markdown-lint $file || echo \"LINT_ERROR: $file\"; done",
          "description": "Validate markdown syntax",
          "allow_warnings": true
        }
      ],
      "acceptance_criteria": {
        "remaining_todo_count": 0,
        "solid_token_count": ">=10",
        "ui_token_count": ">=20",
        "total_references": ">=30"
      },
      "on_failure": "rollback_from_backup"
    },

    {
      "step": 7,
      "name": "generate_report",
      "description": "Create replacement report for review",
      "output_file": "reports/stage2-replacement-report.md",
      "template": {
        "sections": [
          {
            "title": "Replacement Summary",
            "content": [
              "Initial TODO markers: {{initial_todo_count}}",
              "Replaced successfully: {{replaced_count}}",
              "Unmatched (manual review needed): {{unmatched_count}}",
              "KR-SOLID references added: {{solid_token_count}}",
              "KR-UI references added: {{ui_token_count}}"
            ]
          },
          {
            "title": "Files Modified",
            "content": "{{modified_files_list}}"
          },
          {
            "title": "Unmatched TODO Markers",
            "content": "{{unmatched_list}}"
          },
          {
            "title": "Token Status",
            "content": [
              "Ready assets (can be used immediately): {{ready_tokens_list}}",
              "Planned assets (require Stage 1 generation): {{planned_tokens_list}}"
            ]
          }
        ]
      }
    },

    {
      "step": 8,
      "name": "git_commit",
      "description": "Commit changes with conventional commit message",
      "commands": [
        {
          "cmd": "git add docs/design/hifi/*.md",
          "description": "Stage modified hi-fi blueprints"
        },
        {
          "cmd": "git status --short",
          "description": "Show staged changes",
          "expected_output_contains": "M docs/design/hifi/"
        },
        {
          "cmd": "git commit -m 'docs(hifi): replace TODO[asset] markers with token references\n\nReplaced {{replaced_count}} asset placeholders with canonical token references:\n- {{solid_token_count}} KR-SOLID assets (ready)\n- {{ui_token_count}} KR-UI assets (require Stage 1 generation)\n\nUnmatched markers: {{unmatched_count}} (logged for manual review)\n\nCo-Authored-By: Codex CLI <codex@cli.agent>'",
          "description": "Create conventional commit"
        }
      ],
      "on_failure": "manual_intervention_required"
    },

    {
      "step": 9,
      "name": "cleanup",
      "description": "Clean up temporary files and validate final state",
      "commands": [
        {
          "cmd": "rm -rf /tmp/token-map-cache-*",
          "description": "Remove temporary token map cache"
        },
        {
          "cmd": "echo 'Stage 2 Complete: {{replaced_count}} markers replaced, {{unmatched_count}} require manual review'",
          "description": "Output completion message"
        }
      ]
    }
  ],

  "rollback_procedure": {
    "trigger_conditions": [
      "validation_failure",
      "unexpected_error",
      "manual_abort"
    ],
    "steps": [
      {
        "cmd": "git reset --hard HEAD",
        "description": "Discard all uncommitted changes"
      },
      {
        "cmd": "cp -r $backup_dir/hifi/* docs/design/hifi/",
        "description": "Restore from backup"
      },
      {
        "cmd": "echo 'ROLLBACK COMPLETE: Restored from $backup_dir'",
        "description": "Confirm rollback"
      }
    ]
  },

  "success_criteria": {
    "required": [
      "remaining_todo_count == 0",
      "solid_token_count >= 10",
      "ui_token_count >= 20",
      "git_commit_successful == true"
    ],
    "optional": [
      "unmatched_count == 0",
      "markdown_lint_warnings == 0"
    ]
  },

  "handover_to_next_stage": {
    "next_stage": "stage3_mockup_generation",
    "next_agent": "claude-code",
    "deliverables": [
      "14 updated hi-fi blueprints with token references",
      "reports/stage2-replacement-report.md",
      "git commit SHA",
      "List of unmatched markers for manual review"
    ],
    "blockers": [
      "If unmatched_count > 10, requires manual intervention before Stage 3",
      "If markdown_lint errors found, requires fixes before Stage 3"
    ]
  },

  "monitoring": {
    "progress_checkpoints": [
      "After step 3: Token map loaded",
      "After step 5: Replacements executed",
      "After step 6: Validation passed",
      "After step 8: Git commit created"
    ],
    "estimated_time_per_step": {
      "1": "30s",
      "2": "10s",
      "3": "20s",
      "4": "5s",
      "5": "3-5min",
      "6": "1min",
      "7": "30s",
      "8": "20s",
      "9": "10s"
    }
  }
}
