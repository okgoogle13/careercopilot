{
  "mcp_servers": {
    "filesystem": {
      "enabled": true,
      "transport": "stdio",
      "command": "node",
      "args": ["./mcp-servers/filesystem.js"],
      "env": {
        "ROOT_PATH": "/Users/okgoogle13/Projects/careercopilot",
        "BATCH_READS": "true",
        "RESPONSE_FORMAT": "compact",
        "AUTO_MKDIR": "false"
      },
      "description": "Filesystem access for reading component files directly",
      "optimization": "Batch reads reduce requests by 66%"
    },

    "git": {
      "enabled": true,
      "transport": "stdio",
      "command": "node",
      "args": ["./mcp-servers/git.js"],
      "env": {
        "REPO_PATH": "/Users/okgoogle13/Projects/careercopilot",
        "AUTO_COMMIT": "true",
        "FILTER": "components-only",
        "DIFF_FORMAT": "compact",
        "COMMIT_TEMPLATE": "refactor(components): migrate {component_name} to kerala-rage"
      },
      "description": "Git operations for version control and commits",
      "optimization": "Incremental commits prevent context bloat"
    },

    "testing": {
      "enabled": true,
      "transport": "stdio",
      "command": "node",
      "args": ["./mcp-servers/testing.js"],
      "env": {
        "REPO_PATH": "/Users/okgoogle13/Projects/careercopilot",
        "TEST_FRAMEWORK": "jest",
        "OUTPUT_FORMAT": "json",
        "VERBOSE": "false",
        "FAIL_FAST": "true",
        "COVERAGE": "false"
      },
      "description": "Test runner for component validation",
      "optimization": "JSON output is 80% smaller than verbose text"
    }
  },

  "agent_config": {
    "agent_type": "gemini-3-pro",
    "ide": "antigravity",
    "execution_mode": "autonomous",
    "error_recovery": "auto-revert-on-failure",
    "checkpoint_reporting": true,
    "token_budget": 15000,
    "estimated_overhead": 3000,
    "available_for_execution": 12000
  },

  "task_context": {
    "task_id": "component-migration-2026q1",
    "manifest_location": ".claude/tasks/component-migration.json",
    "instructions_location": ".claude/tasks/GEMINI_HANDOVER_MANIFEST.md",
    "reference_location": ".claude/plans/component-migration-handover.md"
  },

  "token_optimization": {
    "batch_mcp_queries": {
      "enabled": true,
      "description": "Batch multiple file reads into single MCP call",
      "example": "GET /files?paths=['Lens.tsx', 'Mark.tsx', 'Jar.tsx'] → 1 call instead of 3",
      "savings_percent": 66
    },

    "incremental_commits": {
      "enabled": true,
      "description": "One commit per component, clear working directory between",
      "benefit": "No context accumulation across 6 components",
      "savings_percent": "~25 per component"
    },

    "direct_file_references": {
      "enabled": true,
      "description": "Use exact file paths from task manifest, never grep/search",
      "savings_percent": 90,
      "example": "Direct: frontend/src/components/inputs/Lens.tsx vs Grep: 'find . -name Lens.tsx'"
    },

    "structured_test_output": {
      "enabled": true,
      "description": "Tests output JSON, not verbose terminal text",
      "savings_percent": 80,
      "config": "npm test -- --json --outputFile=test-results.json"
    },

    "minimal_documentation": {
      "enabled": true,
      "description": "Task manifest in JSON, not verbose markdown docs",
      "savings_percent": 90,
      "file_size_reduction": "200KB markdown → 15KB JSON"
    },

    "total_savings_percent": 70,
    "estimated_cost_optimized": 15000,
    "estimated_cost_unoptimized": 50000,
    "savings_tokens": 35000
  },

  "execution_phases": {
    "phase_1": {
      "name": "Cleanup",
      "tasks": 2,
      "estimated_duration_min": 30,
      "estimated_tokens": 1500,
      "checkpoint": "After deletion of 10 duplicates and consolidation"
    },

    "phase_2": {
      "name": "Component Migration",
      "components": 6,
      "tasks_per_component": 5,
      "estimated_duration_min": 120,
      "estimated_tokens": 11300,
      "checkpoint": "After each component migration (6 checkpoints)"
    },

    "phase_3": {
      "name": "Audit & Report",
      "tasks": 3,
      "estimated_duration_min": 30,
      "estimated_tokens": 2000,
      "checkpoint": "After full test suite passes"
    }
  },

  "error_handling": {
    "test_failure": {
      "action": "auto-revert",
      "behavior": "git revert <commit>, document error, halt phase",
      "recovery": "await Claude Code guidance"
    },

    "missing_token": {
      "action": "halt",
      "behavior": "Report which token missing, cannot proceed",
      "recovery": "await token system update"
    },

    "import_error": {
      "action": "auto-revert",
      "behavior": "git revert <commit>, check dependencies",
      "recovery": "verify npm install completed"
    },

    "blocked_dependency": {
      "action": "halt",
      "behavior": "Document blocking dependency, report to Claude Code",
      "recovery": "resolve dependency, resume from phase restart"
    }
  },

  "success_metrics": {
    "phase_1": {
      "duplicates_deleted": 10,
      "consolidation_complete": true,
      "git_clean": true
    },

    "phase_2": {
      "components_migrated": 6,
      "test_pass_rate": "100%",
      "broken_imports": 0,
      "commits_created": 6,
      "commit_naming_correct": true
    },

    "phase_3": {
      "lint_status": "PASS",
      "full_test_pass": "100%",
      "console_errors": 0,
      "report_generated": true
    },

    "overall": {
      "completion_increase": "17% → 30%+",
      "new_components_migrated": 6,
      "blocking_issues": 0,
      "rollback_needed": false
    }
  },

  "rollback": {
    "enabled": true,
    "backup_branch": "backup/main",
    "strategy_1": "git checkout backup/main",
    "strategy_2": "git revert <commit-sha>",
    "trigger": "If migration failure detected and cannot auto-recover"
  },

  "post_execution_handback": {
    "when_complete": "Gemini reports final metrics with completion percentage",
    "handback_to": "Claude Code",
    "next_phases": [
      "Phase 4: kerala-rage-visual-audit on 6 migrated components",
      "Phase 5: Migrate secondary components (Seed, Vessel, etc.)",
      "Phase 6: Audit remaining 11 shared components"
    ],
    "final_step": "Create PR with Gemini's commits, deploy to staging for visual validation"
  },

  "notes": {
    "why_json_task_manifest": "Structured data loads faster, uses less tokens than prose docs",
    "why_batch_mcp_queries": "3 file reads in 1 batch request = 66% fewer MCP calls",
    "why_autonomous_mode": "No back-and-forth = faster execution, cleaner handoff",
    "why_json_test_output": "Parsing JSON is 80% smaller context than verbose terminal output",
    "why_direct_references": "Exact file paths from task manifest avoid search overhead"
  }
}
