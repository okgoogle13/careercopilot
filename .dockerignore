# Dependencies (will be installed inside container)
node_modules/
.pnp.*
.yarn/install-state.gz

# Python virtual environment (Linux binaries won't work on Mac)
.venv/
__pycache__/
*.py[cod]
*$py.class

# Build outputs
dist/
build/
.cache/
.next/

# Test artifacts
test-results/
playwright-report/
coverage/
.nyc_output/
htmlcov/
.coverage

# Environment files (use docker-compose env instead)
.env
.env.*
!.env.example
*-service-account-key.json
service-account-*.json
*_key.json
*-key.json
firebase-adminsdk-*.json

# Version control
.git/
.gitignore
.github/

# IDE and editor files
.vscode/
.idea/
.windsurf/
.idx/
*.swp
*.swo

# OS-specific files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*storybook.log

# Firebase
.firebase/

# Temporary and backup folders
tmp/
temp/
.tmp.driveupload/
_legacy_archive_*/
cleanup_backup_*/
.archive/
.archive_legacy/
.ai_reports/
.ai_batches/
claude-artifact-runner/
.claude-backup-*.tar.gz
*.bak.*

# Databases and archives
*.db
*.zip

# Documentation
docs/
README.md

# Storybook
storybook-static/

# Cache
.eslintcache
.npm
.rpt2_cache/
.tsbuildinfo

# Docker files themselves (no need to copy into image)
Dockerfile*
docker-compose*.yml
.dockerignore
