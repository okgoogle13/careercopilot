{
  "$schema": "https://vercel.com/static/schema.json",
  "version": 2,
  "installCommand": "corepack enable && yarn install --immutable",
  "buildCommand": "yarn build:frontend",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
