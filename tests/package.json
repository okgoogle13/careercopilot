{
  "name": "careercopilot-firestore-rules-tests",
  "version": "1.0.0",
  "description": "Firebase Firestore security rules unit tests",
  "scripts": {
    "test": "jest firestore.rules.test.js",
    "test:watch": "jest firestore.rules.test.js --watch",
    "test:coverage": "jest firestore.rules.test.js --coverage",
    "emulators:start": "firebase emulators:start --only firestore --project careercopilot-test",
    "emulators:kill": "firebase emulators:exec --only firestore 'echo \"Stopping emulators\"' --project careercopilot-test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "firebase": "^10.7.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 30000,
    "verbose": true,
    "collectCoverageFrom": [
      "../firestore.rules"
    ]
  }
}
