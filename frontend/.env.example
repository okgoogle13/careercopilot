# Firebase Configuration - CareerCopilot
# 
# Required Firebase environment variables for authentication and services
# Copy this file to .env and replace placeholder values with real credentials
#
# Get these values from: 
# Firebase Console > Project Settings > General > Your apps > Firebase SDK snippet

# Firebase Web API Key (required for authentication)
# Format: AIzaSy... (starts with AIzaSy, ~39 characters)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here

# Firebase Auth Domain (required for authentication)
# Format: your-project-id.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID (required for all services)
# Format: your-project-id (lowercase, can contain hyphens)
VITE_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket (required for file storage)
# Format: your-project-id.appspot.com or your-project-id.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Messaging Sender ID (required for cloud messaging)
# Format: numeric string, ~12 digits
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase App ID (required for app identification)
# Format: 1:numbers:web:hexadecimal
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789

# Development Environment Variables (optional)
# VITE_ENV=development
# VITE_DEBUG_FIREBASE=true

# Production Environment Variables (optional)
# VITE_ENV=production
# VITE_DEBUG_FIREBASE=false

# ========================================
# IMPORTANT SECURITY NOTES:
# ========================================
# 1. Never commit .env files with real credentials to version control
# 2. Use different Firebase projects for development/staging/production
# 3. Configure Firebase security rules to restrict data access
# 4. Set up proper authentication and authorization
# 5. Monitor Firebase usage and set up billing alerts
# ========================================