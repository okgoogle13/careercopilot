# Use an official Node.js runtime as a parent image
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Enable corepack to use the correct Yarn version (4.10.3)
RUN corepack enable

# Copy workspace configuration files
COPY package*.json ./
COPY yarn.lock ./
COPY frontend/package*.json ./frontend/

# Install dependencies using Yarn 4.x
# This will handle peer dependencies according to the project's package.json settings
RUN yarn install

# Copy frontend source code
COPY frontend/ ./frontend/

# Build the frontend application
WORKDIR /app/frontend
RUN yarn build

# Expose the port and set the command
EXPOSE 3000
CMD ["yarn", "run", "preview"]
