{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "./dist",
    "strict": true
  },
  "include": ["src"],
  "exclude": ["**/node_modules", "**/.*/", "**/*.test.*", "**/*.spec.*"]
}
