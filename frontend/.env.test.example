# E2E Test Environment Configuration
# Copy this to .env.test and fill in your test credentials

# Frontend URL
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Firebase Configuration (same as production)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Test User Credentials
# IMPORTANT: Create a dedicated test user in Firebase Authentication
# DO NOT use a real user account for testing
TEST_USER_EMAIL=test@careercopilot.dev
TEST_USER_PASSWORD=TestPassword123!

# Backend API URL
VITE_API_URL=http://localhost:8081/api

# Test Configuration
TEST_TIMEOUT=120000
TEST_RETRIES=1
