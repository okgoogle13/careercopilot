# Use an official Node.js runtime as a parent image
FROM node:18-alpine

# Enable Yarn's strict mode and set working directory
ENV YARN_SILENT=0
WORKDIR /app

# Copy workspace configuration files
COPY package*.json ./
COPY yarn.lock ./
COPY frontend/package*.json ./frontend/

# Install dependencies using Yarn with legacy peer deps
# This handles the workspace structure and dependency conflicts
RUN yarn install --legacy-peer-deps --frozen-lockfile

# Copy frontend source code
COPY frontend/ ./frontend/

# Build the frontend application
WORKDIR /app/frontend
RUN yarn build

# Expose the port and set the command
EXPOSE 3000
CMD ["yarn", "run", "preview"]
