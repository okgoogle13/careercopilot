{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M3-styled Wireframe Schema",
  "description": "Schema for defining kerala-rage kr-solidarity layout blueprints using M3 wireframing components.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "layout": {
      "type": "object",
      "properties": {
        "grid": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/component"
          }
        }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
