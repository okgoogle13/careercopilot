{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "kerala-rage kr-solidarity Motion Library",
  "version": "1.0.0",
  "description": "Comprehensive motion token library quantifying 'Viscous Breeze' physics for kr-dark and kr-dark modes",
  "motion": {
    "physics": {
      "$description": "Spring physics parameters for natural, physics-based animations",
      "kr-dark": {
        "stiffness": {
          "$value": 500,
          "$type": "number",
          "$description": "kr-dark mode spring stiffness — gentle, expressive"
        },
        "damping": {
          "$value": 27,
          "$type": "number",
          "$description": "kr-dark mode damping — allows overshoot, air resistance"
        },
        "mass": {
          "$value": 1,
          "$type": "number",
          "$description": "Default mass for all animations"
        },
        "velocity": {
          "$value": 0,
          "$type": "number",
          "$description": "Initial velocity"
        }
      },
      "standard": {
        "stiffness": {
          "$value": 800,
          "$type": "number",
          "$description": "Standard mode spring stiffness — precise, controlled"
        },
        "damping": {
          "$value": 40,
          "$type": "number",
          "$description": "Standard mode damping — minimal overshoot, clinical precision"
        },
        "mass": {
          "$value": 1,
          "$type": "number",
          "$description": "Default mass for all animations"
        },
        "velocity": {
          "$value": 0,
          "$type": "number",
          "$description": "Initial velocity"
        }
      }
    },
    "easing": {
      "$description": "Cubic bezier easing curves for different motion personalities",
      "viscous": {
        "$value": "0.34, 1.56, 0.64, 1",
        "$type": "cubicBezier",
        "$description": "Viscous Breeze — kr-dark mode primary"
      },
      "precise": {
        "$value": "0.25, 0.46, 0.45, 0.94",
        "$type": "cubicBezier",
        "$description": "kr-dark mode — no overshoot"
      },
      "settle": {
        "$value": "0.25, 0.46, 0.45, 0.94",
        "$type": "cubicBezier",
        "$description": "Finding rest position"
      },
      "snap": {
        "$value": "0.4, 0, 0.2, 1",
        "$type": "cubicBezier",
        "$description": "Quick movements"
      },
      "elastic": {
        "$value": "0.68, -0.55, 0.265, 1.55",
        "$type": "cubicBezier",
        "$description": "Pronounced bounce"
      },
      "linear": {
        "$value": "0, 0, 1, 1",
        "$type": "cubicBezier",
        "$description": "Reduced motion fallback"
      }
    },
    "duration": {
      "$description": "Semantic duration scale for consistent timing",
      "instant": {
        "$value": "100ms",
        "$type": "duration",
        "$description": "Micro-interactions, immediate feedback"
      },
      "fast": {
        "$value": "180ms",
        "$type": "duration",
        "$description": "Hover states, focus rings, quick transitions"
      },
      "standard": {
        "$value": "280ms",
        "$type": "duration",
        "$description": "Button press, typography bloom, standard interactions"
      },
      "moderate": {
        "$value": "450ms",
        "$type": "duration",
        "$description": "Card lift, panel slide, moderate complexity"
      },
      "slow": {
        "$value": "600ms",
        "$type": "duration",
        "$description": "Mode transition, page change, complex choreography"
      },
      "deliberate": {
        "$value": "900ms",
        "$type": "duration",
        "$description": "Hero animations, entrance moments"
      }
    },
    "interactions": {
      "$description": "Pre-defined interaction patterns for common UI elements",
      "hover": {
        "card": {
          "transform": {
            "$value": "-4px",
            "$type": "string"
          },
          "shadow": {
            "$value": "0 8px 40px #14121099, 0 2px 8px #00000040",
            "$type": "shadow"
          },
          "duration": {
            "$value": "{motion.duration.standard}",
            "$type": "duration"
          },
          "easing": {
            "$value": "{motion.easing.viscous}",
            "$type": "cubicBezier"
          }
        },
        "button": {
          "scale": {
            "$value": "1.02",
            "$type": "number"
          },
          "shadow": {
            "$value": "0 0 40px #D4A84B26",
            "$type": "shadow"
          },
          "duration": {
            "$value": "{motion.duration.fast}",
            "$type": "duration"
          },
          "easing": {
            "$value": "{motion.easing.viscous}",
            "$type": "cubicBezier"
          }
        },
        "link": {
          "color": {
            "$value": "{color.primary.inkGlow}",
            "$type": "color"
          },
          "underlineOffset": {
            "$value": "4px",
            "$type": "dimension"
          },
          "duration": {
            "$value": "{motion.duration.fast}",
            "$type": "duration"
          },
          "easing": {
            "$value": "{motion.easing.settle}",
            "$type": "cubicBezier"
          }
        }
      },
      "press": {
        "button": {
          "scale": {
            "$value": "0.98",
            "$type": "number"
          },
          "shadow": {
            "$value": "0 2px 8px #14121066",
            "$type": "shadow"
          },
          "duration": {
            "$value": "{motion.duration.instant}",
            "$type": "duration"
          },
          "easing": {
            "$value": "{motion.easing.snap}",
            "$type": "cubicBezier"
          }
        },
        "chip": {
          "scale": {
            "$value": "0.95",
            "$type": "number"
          },
          "opacity": {
            "$value": "0.8",
            "$type": "number"
          },
          "duration": {
            "$value": "{motion.duration.instant}",
            "$type": "duration"
          },
          "easing": {
            "$value": "{motion.easing.snap}",
            "$type": "cubicBezier"
          }
        }
      },
      "focus": {
        "input": {
          "ring": {
            "$value": "0 0 0 3px #D4A84B4D",
            "$type": "shadow"
          },
          "borderColor": {
            "$value": "{color.primary.kr-ink-gold}",
            "$type": "color"
          },
          "duration": {
            "$value": "{motion.duration.fast}",
            "$type": "duration"
          },
          "easing": {
            "$value": "{motion.easing.settle}",
            "$type": "cubicBezier"
          }
        },
        "button": {
          "ring": {
            "$value": "0 0 0 3px #D4A84B4D",
            "$type": "shadow"
          },
          "duration": {
            "$value": "{motion.duration.fast}",
            "$type": "duration"
          },
          "easing": {
            "$value": "{motion.easing.settle}",
            "$type": "cubicBezier"
          }
        }
      },
      "drag": {
        "card": {
          "scale": {
            "$value": "1.05",
            "$type": "number"
          },
          "opacity": {
            "$value": "0.9",
            "$type": "number"
          },
          "shadow": {
            "$value": "0 16px 48px #141210B3",
            "$type": "shadow"
          },
          "easing": {
            "$value": "{motion.easing.viscous}",
            "$type": "cubicBezier"
          }
        },
        "modal": {
          "scale": {
            "$value": "0.95",
            "$type": "number"
          },
          "backdropBlur": {
            "$value": "8px",
            "$type": "dimension"
          },
          "easing": {
            "$value": "{motion.easing.settle}",
            "$type": "cubicBezier"
          }
        }
      },
      "scroll": {
        "parallax": {
          "speed": {
            "$value": "0.5",
            "$type": "number",
            "$description": "Parallax scroll speed multiplier"
          },
          "easing": {
            "$value": "{motion.easing.linear}",
            "$type": "cubicBezier"
          }
        },
        "reveal": {
          "opacity": {
            "from": {
              "$value": "0",
              "$type": "number"
            },
            "to": {
              "$value": "1",
              "$type": "number"
            }
          },
          "transform": {
            "from": {
              "$value": "24px",
              "$type": "string"
            },
            "to": {
              "$value": "0px",
              "$type": "string"
            }
          },
          "duration": {
            "$value": "{motion.duration.moderate}",
            "$type": "duration"
          },
          "easing": {
            "$value": "{motion.easing.settle}",
            "$type": "cubicBezier"
          }
        }
      }
    },
    "modeSpecific": {
      "$description": "Mode-specific motion overrides",
      "kr-dark": {
        "defaultEasing": {
          "$value": "{motion.easing.viscous}",
          "$type": "cubicBezier"
        },
        "defaultDuration": {
          "$value": "{motion.duration.standard}",
          "$type": "duration"
        },
        "allowOvershoot": {
          "$value": true,
          "$type": "boolean"
        }
      },
      "kr-precise": {
        "defaultEasing": {
          "$value": "{motion.easing.precise}",
          "$type": "cubicBezier"
        },
        "defaultDuration": {
          "$value": "{motion.duration.fast}",
          "$type": "duration"
        },
        "allowOvershoot": {
          "$value": false,
          "$type": "boolean"
        }
      }
    },
    "accessibility": {
      "$description": "Reduced motion support for accessibility",
      "reducedMotion": {
        "duration": {
          "$value": "50ms",
          "$type": "duration",
          "$description": "Minimal duration for reduced motion"
        },
        "easing": {
          "$value": "{motion.easing.linear}",
          "$type": "cubicBezier",
          "$description": "Linear easing for reduced motion"
        },
        "disableTransforms": {
          "$value": true,
          "$type": "boolean",
          "$description": "Disable scale/rotate transforms"
        },
        "disableParallax": {
          "$value": true,
          "$type": "boolean",
          "$description": "Disable parallax effects"
        }
      }
    }
  }
}
