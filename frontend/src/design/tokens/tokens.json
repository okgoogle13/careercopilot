{
  "name": "Northcote Curio",
  "version": "2.0.0",
  "$description": "Authoritative Design Tokens for the Northcote Curio Design System. Inspired by Victorian naturalist field stations.",
  "metadata": {
    "centralMetaphor": "Victorian Naturalist Field Station",
    "modes": [
      "gallery",
      "laboratory"
    ],
    "authors": [
      "Northcote Curio Team"
    ]
  },
  "color": {
    "semantic": {
      "specimen-night": {
        "$value": "#1A1714",
        "role": "Background",
        "$description": "Warm charcoal background, the velvet behind the specimen case.",
        "usage": "Page backgrounds, containers",
        "$type": "color"
      },
      "wattle-gold": {
        "$value": "#D4A84B",
        "role": "Primary",
        "$description": "Luminous botanical accent (Acacia pycnantha).",
        "usage": "Buttons, highlights, gallery mode primary",
        "$type": "color"
      },
      "waratah-crimson": {
        "$value": "#C45C4B",
        "role": "Alert/Destructive",
        "$description": "Rich crimson (Telopea speciosissima).",
        "usage": "Error states, destructive actions, high priority alerts",
        "$type": "color"
      },
      "eucalypt-smoke": {
        "$value": "#2C2723",
        "role": "Surface",
        "$description": "Woodsmoke at dusk.",
        "usage": "Card surfaces, secondary backgrounds",
        "$type": "color"
      },
      "flannel-flower": {
        "$value": "#E6E1D6",
        "role": "Secondary/Neutral",
        "$description": "Soft tactile white (Actinotus helianthi).",
        "usage": "Laboratory mode primary, text on dark surfaces",
        "$type": "color"
      },
      "parchment": {
        "$value": "#F0EAD6",
        "role": "Text/Foreground",
        "$description": "Aged field note paper.",
        "usage": "Body text, primary content",
        "$type": "color"
      }
    },
    "families": {
      "specimen-night": {
        "lightest": "#3D3A36",
        "light": "#2C2925",
        "base": "#1A1714",
        "dark": "#0F0C0A",
        "darkest": "#050403"
      },
      "wattle-gold": {
        "lightest": "#E8C77A",
        "light": "#E0BD61",
        "base": "#D4A84B",
        "dark": "#C8983A",
        "darkest": "#B88A2E"
      },
      "waratah-crimson": {
        "lightest": "#E08A7D",
        "light": "#D27364",
        "base": "#C45C4B",
        "dark": "#A64536",
        "darkest": "#873023"
      },
      "eucalypt-smoke": {
        "lightest": "#4A433D",
        "light": "#3D3632",
        "base": "#2C2723",
        "dark": "#1F1B18",
        "darkest": "#120F0D"
      },
      "flannel-flower": {
        "lightest": "#F5F2EA",
        "light": "#EEEBE3",
        "base": "#E6E1D6",
        "dark": "#D1C9B8",
        "darkest": "#BDB39F"
      }
    }
  },
  "spacing": {
    "xs": {
      "$value": "4px",
      "rem": "0.25rem",
      "$type": "dimension"
    },
    "sm": {
      "$value": "8px",
      "rem": "0.5rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "12px",
      "rem": "0.75rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "16px",
      "rem": "1rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "24px",
      "rem": "1.5rem",
      "$type": "dimension"
    },
    "xxl": {
      "$value": "32px",
      "rem": "2rem",
      "$type": "dimension"
    },
    "xxxl": {
      "$value": "48px",
      "rem": "3rem",
      "$type": "dimension"
    }
  },
  "radius": {
    "pebble": {
      "$value": "20px 6px 16px 28px",
      "$description": "Organic asymmetry for Buttons",
      "$type": "dimension"
    },
    "stone": {
      "$value": "16px 4px 12px 24px",
      "$description": "Organic asymmetry for Cards",
      "$type": "dimension"
    },
    "leaf": {
      "$value": "24px 8px 20px 4px",
      "$description": "Organic asymmetry for Containers",
      "$type": "dimension"
    },
    "seed": {
      "$value": "8px 4px 10px 6px",
      "$description": "Organic asymmetry for Badges/Tags",
      "$type": "dimension"
    },
    "sentry": {
      "$value": "98%",
      "$description": "Near-circle for Avatars",
      "$type": "dimension"
    }
  },
  "typography": {
    "fontFamily": {
      "proclamation": {
        "$value": "'Libre Bodoni', serif",
        "role": "Display Headline",
        "$type": "fontFamily"
      },
      "bloom": {
        "$value": "'Fraunces', serif",
        "role": "Expressive Title",
        "$type": "fontFamily"
      },
      "field-note": {
        "$value": "'Work Sans', sans-serif",
        "role": "Body Text",
        "$type": "fontFamily"
      },
      "annotation": {
        "$value": "'JetBrains Mono', monospace",
        "role": "Code/Technical",
        "$type": "fontFamily"
      }
    },
    "axes": {
      "bloom": {
        "rest": {
          "SOFT": 50,
          "WONK": 0
        },
        "hover": {
          "SOFT": 30,
          "WONK": 0.5
        },
        "active": {
          "SOFT": 0,
          "WONK": 0.8
        }
      }
    }
  },
  "shadow": {
    "subtle": {
      "$value": "0 2px 4px rgba(0,0,0,0.15)",
      "$type": "shadow"
    },
    "standard": {
      "$value": "0 4px 8px rgba(0,0,0,0.20)",
      "$type": "shadow"
    },
    "elevated": {
      "$value": "0 8px 16px rgba(0,0,0,0.25)",
      "$type": "shadow"
    },
    "maximum": {
      "$value": "0 16px 32px rgba(0,0,0,0.30)",
      "$type": "shadow"
    },
    "rest": {
      "$value": "0 4px 24px rgba(20, 18, 16, 0.5)",
      "$type": "shadow"
    },
    "hover": {
      "$value": "0 8px 40px rgba(20, 18, 16, 0.6)",
      "$type": "shadow"
    },
    "glow-gold": {
      "$value": "0 0 40px rgba(212, 168, 75, 0.15)",
      "$type": "shadow"
    }
  },
  "motion": {
    "easing": {
      "viscous-breeze": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "duration": {
      "fast": "150ms",
      "standard": "300ms",
      "slow": "500ms"
    }
  }
}