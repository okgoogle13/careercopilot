    "motifs": {
      "$description": {
        "$type": "other",
        "$value": "Motif system designed for icon-scale clarity and street-kr-dark screenprint aesthetic. No crowns. No bureaucratic forms, passports, IDs, border gates. First Nations solidarity appears only in situ (placards/posters), without aesthetic appropriation."
      },
      "sources": {
        "$type": "string[]",
        "$value": [
          "Kerala motifs: houseboat (kettuvalam), backwater ripples",
          "Naarm place motifs: laneway brick, wheat-paste posters, tram silhouette",
          "Devotional anchor: Shiva (statue-inspired Nataraja presence) + Option A icon: trishula + damru (icon-scale)",
          "Anti-colonial street truth: graffiti phrases (English-only)",
          "Resistance lineage: Tipu Sultan portrait (green turban, tiger motifs), Bhagat Singh portrait (profile + hat + martyr halo) with Latin-script 'INQUILAB ZINDABAD'"
        ],
        "$description": "Reference motifs used in the moodboard and brand direction."
      }
    },
