{
  "$schema": "https://json-schema.org/draft-07/schema",
  "version": "4.2",
  "system": "Electric Alchemist - Solid State / Poly-Body",
  "colors": {
    "seed": {
      "shadow": "#6750A4"
    },
    "primary": {
      "DEFAULT": "#D0BCFF",
      "container": "#EADDFF",
      "onContainer": "#21005D"
    },
    "tertiary": {
      "DEFAULT": "#EFB8C8",
      "container": "#FFD8E4",
      "on": "#492532"
    },
    "surface": {
      "DEFAULT": "#141218",
      "containerLow": "#1D1B20",
      "container": "#211F26",
      "containerHigh": "#2B2930"
    },
    "outline": {
      "DEFAULT": "#938F99",
      "variant": "#49454F"
    }
  },
  "typography": {
    "families": {
      "hologram": "Nabla",
      "hero": "Roboto Flex",
      "human": "Roboto Serif",
      "ai": "Roboto Flex",
      "data": "Roboto Flex"
    },
    "axes": {
      "hero": {
        "wdth": 150,
        "wght": 800,
        "YTUC": 760,
        "XTRA": 600,
        "GRAD": 0,
        "opsz": 24
      },
      "human": {
        "wdth": 100,
        "wght": 400,
        "opsz": 24,
        "GRAD": -25
      },
      "ai": {
        "wdth": 92,
        "wght": 450,
        "opsz": 16,
        "GRAD": 20
      },
      "data": {
        "wdth": 110,
        "wght": 500,
        "opsz": 8,
        "GRAD": 0
      }
    },
    "interactions": {
      "dataGlitch": {
        "rest": 500,
        "hover": 600
      }
    }
  },
  "shape": {
    "radius": {
      "card": "28px",
      "button": "24px",
      "badge": "8px",
      "asymmetric": "0 28px 28px 0"
    }
  },
  "spacing": {
    "grid": "24px",
    "cardPadding": "24px",
    "cardPaddingTop": "48px"
  },
  "motion": {
    "tactilePress": {
      "hover": {
        "scale": 0.98,
        "stiffness": 400,
        "damping": 25
      },
      "tap": {
        "scale": 0.95
      }
    },
    "popOut": {
      "rest": {
        "y": 0,
        "rotate": 0,
        "scale": 1
      },
      "hover": {
        "y": -15,
        "rotate": 5,
        "scale": 1.1,
        "stiffness": 300,
        "damping": 20
      }
    },
    "springs": {
      "tactile": {
        "stiffness": 400,
        "damping": 25
      },
      "popOut": {
        "stiffness": 300,
        "damping": 20
      }
    }
  },
  "texture": {
    "noise": {
      "opacity": 0.04,
      "blendMode": "overlay"
    },
    "dotGrid": {
      "dotSize": "1.5px",
      "spacing": "24px",
      "color": "#49454F"
    }
  },
  "elevation": {
    "popOutOffset": "-40px",
    "zIndex": {
      "base": 1,
      "popOut": 20,
      "modal": 50
    }
  }
}
