          }
        },
        "to": {
          "fontVariationSettings": {
            "$value": "'wght' 750, 'SOFT' 80, 'WONK' 1"
          }
        },
        "transition": {
          "$value": "font-variation-settings 280ms cubic-bezier(0.34, 1.56, 0.64, 1)"
        }
      }
    }
