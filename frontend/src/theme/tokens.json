{
  "$schema": "https://json-schema.org/draft-07/schema",
  "version": "4.4",
  "system": "Electric Alchemist - Tailwind Optimized",
  "color": {
    "primary": "#D0BCFF",
    "primary-container": "#EADDFF",
    "on-primary": "#21005D",
    "on-primary-container": "#21005D",
    "secondary": "#9D88D4",
    "secondary-container": "#E6DEFF",
    "on-secondary": "#2A2042",
    "tertiary": "#EFB8C8",
    "tertiary-container": "#FFD8E4",
    "on-tertiary": "#492532",
    "error": "#FF6B9D",
    "on-error": "#3E001D",
    "error-container": "#FFD9E2",
    "surface": "#141218",
    "surface-container": "#211F26",
    "surface-container-low": "#1D1B20",
    "surface-container-high": "#2B2930",
    "outline": "#938F99",
    "outline-variant": "#49454F",
    "background": "{color.surface}",
    "on-background": "{color.on-surface}",
    "on-surface": "#E6E0E9",
    "on-surface-variant": "{color.outline}",
    "shadow": "#6750A4",
    "disabled-text": "rgba(234, 221, 255, 0.38)",
    "disabled-surface": "rgba(234, 221, 255, 0.12)"
  },
  "typography": {
    "families": {
      "hologram": "Nabla",
      "hero": "Roboto Flex",
      "human": "Roboto Serif",
      "ai": "Roboto Flex",
      "data": "Roboto Flex"
    },
    "axes": {
      "hero": {
        "wdth": 150,
        "wght": 800,
        "YTUC": 760,
        "GRAD": 0,
        "opsz": 24
      },
      "human": {
        "wdth": 100,
        "wght": 400,
        "opsz": 24,
        "GRAD": -25
      },
      "ai": {
        "wdth": 92,
        "wght": 450,
        "opsz": 16,
        "GRAD": 20
      },
      "data": {
        "wdth": 110,
        "wght": 500,
        "opsz": 8,
        "GRAD": 0
      }
    },
    "size": {
      "display-lg": "4.5rem",
      "display-md": "3.375rem",
      "display-sm": "2.5rem",
      "headline-lg": "2rem",
      "headline-md": "1.5rem",
      "body-md": "1rem",
      "body-sm": "0.875rem"
    },
    "interactions": {
      "dataGlitch": {
        "rest": 500,
        "hover": 600
      }
    }
  },
  "shape": {
    "radius": {
      "card": "28px",
      "button": "24px",
      "badge": "8px",
      "asymmetric": "0 28px 28px 0"
    }
  },
  "spacing": {
    "grid": "24px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "base": "16px",
    "lg": "24px",
    "xl": "48px",
    "2xl": "72px",
    "3xl": "96px",
    "cardPadding": "24px",
    "cardPaddingTop": "48px"
  },
  "motion": {
    "tactilePress": {
      "hover": {
        "scale": 0.98,
        "stiffness": 400,
        "damping": 25
      },
      "tap": {
        "scale": 0.95
      }
    },
    "popOut": {
      "rest": {
        "y": 0,
        "rotate": 0,
        "scale": 1
      },
      "hover": {
        "y": -15,
        "rotate": 5,
        "scale": 1.1,
        "stiffness": 300,
        "damping": 20
      }
    },
    "springs": {
      "tactile": {
        "stiffness": 400,
        "damping": 25
      },
      "popOut": {
        "stiffness": 300,
        "damping": 20
      }
    }
  },
  "texture": {
    "noise": {
      "opacity": 0.04,
      "blendMode": "overlay"
    },
    "dotGrid": {
      "dotSize": "1.5px",
      "spacing": "24px",
      "color": "#49454F"
    }
  },
  "elevation": {
    "popOutOffset": "-40px",
    "zIndex": {
      "base": 1,
      "popOut": 20,
      "scrim": 39,
      "modal": 50,
      "tooltip": 60
    },
    "borderWidth": {
      "card": "1px",
      "cardHover": "2px",
      "modal": "3px"
    }
  },
  "breakpoint": {
    "mobile": "480px",
    "tablet": "768px",
    "desktopSidebar": "1024px"
  }
}
