{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Northcote Curio",
  "version": "2.0.0",
  "description": "A design system for CareerCopilot inspired by Victorian naturalist field stations—where the front parlour displays pressed specimens on velvet (The Gallery), and the back room contains dissection tables and meticulous anatomical notes (The Laboratory).",
  "metadata": {
    "centralMetaphor": "A Victorian naturalist's field station in the Australian bush",
    "modes": {
      "gallery": {
        "name": "The Gallery",
        "description": "Emotional, colourful, 'Nocturnal Garden' — for Landing, Opportunities, Dashboard Hero",
        "atmosphere": "Wonder and possibility",
        "texture": "Gouache on Dark Ironbark"
      },
      "laboratory": {
        "name": "The Laboratory",
        "description": "Technical, structural, 'The Audit' — for Resume Analysis, Skills Extraction, Document Parsing",
        "atmosphere": "Clarity and investigation",
        "texture": "Aged Field Note Paper"
      }
    },
    "botanicalReferences": {
      "wattleGold": "Acacia pycnantha (Golden Wattle)",
      "waratahCrimson": "Telopea speciosissima (Waratah)",
      "ghostGum": "Corymbia aparrerinja (Ghost Gum)",
      "nativeViolet": "Viola hederacea (Native Violet)",
      "banksiaOrange": "Banksia serrata (Old Man Banksia)",
      "flannelFlower": "Actinotus helianthi (Flannel Flower)"
    }
  },
