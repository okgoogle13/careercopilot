  "elevation": {
    "shadow": {
      "rest": {
        "$value": "0 4px 24px rgba(20, 18, 16, 0.5), 0 1px 4px rgba(0, 0, 0, 0.2)",
        "$type": "shadow",
        "$description": "Ink pool at rest"
      },
      "hover": {
        "$value": "0 8px 40px rgba(20, 18, 16, 0.6), 0 2px 8px rgba(0, 0, 0, 0.25)",
        "$type": "shadow",
        "$description": "Deepened ink pool on hover"
      },
      "glowGold": {
        "$value": "0 0 40px rgba(212, 168, 75, 0.15)",
        "$type": "shadow",
        "$description": "Wattle Gold ambient glow"
      }
    }
  },
  "motion": {
    "easing": {
      "viscous": {
        "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
        "$type": "cubicBezier",
        "$description": "Gallery mode — air resistance, gentle overshoot"
      },
      "settle": {
        "$value": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
        "$type": "cubicBezier",
        "$description": "Finding rest position"
      },
      "precise": {
        "$value": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
        "$type": "cubicBezier",
        "$description": "Laboratory mode — controlled, no overshoot"
      },
      "snap": {
        "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
        "$type": "cubicBezier",
        "$description": "Quick, decisive movements"
      }
    },
    "duration": {
      "micro": {
        "$value": "180ms",
        "$type": "duration",
        "$description": "Hover states, focus rings"
      },
      "short": {
        "$value": "280ms",
        "$type": "duration",
        "$description": "Button presses, typography bloom"
      },
      "medium": {
        "$value": "450ms",
        "$type": "duration",
        "$description": "Card transitions, panel slides"
      },
      "long": {
        "$value": "600ms",
        "$type": "duration",
        "$description": "Mode transitions, page changes"
      }
    },
    "interactions": {
      "cardHover": {
        "transform": {
          "$value": "translateY(-4px)"
        },
        "transition": {
          "$value": "transform 350ms {motion.easing.viscous}, box-shadow 350ms {motion.easing.settle}"
        }
      },
      "buttonHover": {
        "transform": {
          "$value": "translateY(-2px)"
        },
        "transition": {
          "$value": "transform 180ms {motion.easing.viscous}, background-color 180ms {motion.easing.settle}"
        }
      },
      "navItemHover": {
        "transform": {
          "$value": "translateX(4px)"
        },
        "transition": {
          "$value": "transform 200ms {motion.easing.viscous}, background-color 150ms {motion.easing.snap}"
        }
      }
    }
  },
