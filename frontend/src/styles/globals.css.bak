/* Base styles */
:root {
  --font-size: 16px;

  /* Google-Inspired Brand Colors */
  --primary: #4285f4;
  --primary-light: #8ab4f8;
  --primary-dark: #1a73e8;

  /* Dark Background Colors */
  --background: #0a0a0a;
  --background-section: #1a1a1a;
  --background-card: #2a2a2a;
  --background-elevated: #2a2a2a;

  /* Text Colors */
  --foreground: #fff;
  --foreground-secondary: #b0b0b0;
  --foreground-muted: #666;

  /* Google Brand Colors */
  --accent-blue: #4285f4;
  --accent-blue-light: #8ab4f8;
  --accent-green: #34a853;
  --accent-yellow: #fbbc04;
  --accent-red: #ea4335;

  /* Border Colors */
  --border-primary: rgb(66, 133, 244, 0.2);
  --border-subtle: rgb(255, 255, 255, 0.1);
  
  /* Theme variables */
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--background-card);
  --color-card-foreground: var(--foreground);
  --color-popover: var(--background-elevated);
  --color-popover-foreground: var(--foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--foreground);
  --color-secondary: var(--foreground-secondary);
  --color-secondary-foreground: var(--foreground);
  --color-muted: var(--foreground-muted);
  --color-muted-foreground: var(--foreground-muted);
  --color-accent: var(--accent-blue);
  --color-accent-foreground: var(--foreground);
  --color-destructive: var(--accent-red);
  --color-destructive-foreground: var(--foreground);
  --color-border: var(--border-subtle);
  --color-input: var(--border-subtle);
  --color-ring: var(--primary);

  /* Updated mappings for compatibility */
  --card: var(--background-card);
  --card-foreground: var(--foreground);
  --popover: var(--background-card);
  --popover-foreground: var(--foreground);
  --primary-foreground: var(--foreground);
  --secondary: var(--background-section);
  --secondary-foreground: var(--foreground);
  --muted: var(--background-section);
  --muted-foreground: var(--foreground-muted);
  --accent: var(--primary);
  --accent-foreground: var(--foreground);
  --destructive: var(--accent-red);
  --destructive-foreground: var(--foreground);
  --border: var(--border-subtle);
  --input: var(--background-section);
  --input-background: var(--background-section);
  --switch-background: var(--background-section);
  --font-weight-medium: 500;
  --font-weight-normal: 400;
  --ring: var(--primary);
  --chart-1: var(--primary);
  --chart-2: var(--primary-light);
  --chart-3: var(--accent-green);
  --chart-4: var(--accent-yellow);
  --chart-5: var(--accent-red);
  --radius: 0.5rem;
  --sidebar: var(--background);
  --sidebar-foreground: var(--foreground);
  --sidebar-primary: var(--primary);
  --sidebar-primary-foreground: var(--foreground);
  --sidebar-accent: var(--background-section);
  --sidebar-accent-foreground: var(--foreground);
  --sidebar-border: var(--border-subtle);
  --sidebar-ring: var(--primary);
}

.dark {
  /* Same as root for dark theme */
  --primary: #4285f4;
  --primary-light: #8ab4f8;
  --primary-dark: #1a73e8;
  --background: #0a0a0a;
  --background-section: #1a1a1a;
  --background-card: #2a2a2a;
  --background-elevated: #2a2a2a;
  --foreground: #fff;
  --foreground-secondary: #b0b0b0;
  --foreground-muted: #666;
  --accent-blue: #4285f4;
  --accent-blue-light: #8ab4f8;
  --accent-green: #34a853;
  --accent-yellow: #fbbc04;
  --accent-red: #ea4335;
  --border-primary: rgb(66, 133, 244, 0.2);
  --border-subtle: rgb(255, 255, 255, 0.1);

  /* Updated mappings */
  --card: var(--background-card);
  --card-foreground: var(--foreground);
  --popover: var(--background-card);
  --popover-foreground: var(--foreground);
  --primary-foreground: var(--foreground);
  --secondary: var(--background-section);
  --secondary-foreground: var(--foreground);
  --muted: var(--background-section);
  --muted-foreground: var(--foreground-muted);
  --accent: var(--primary);
  --accent-foreground: var(--foreground);
  --destructive: var(--accent-red);
  --destructive-foreground: var(--foreground);
  --border: var(--border-subtle);
  --input: var(--background-section);
  --ring: var(--primary);
  --font-weight-medium: 500;
  --font-weight-normal: 400;
  --chart-1: var(--primary);
  --chart-2: var(--primary-light);
  --chart-3: var(--accent-green);
  --chart-4: var(--accent-yellow);
  --chart-5: var(--accent-red);
  --sidebar: var(--background);
  --sidebar-foreground: var(--foreground);
  --sidebar-primary: var(--primary);
  --sidebar-primary-foreground: var(--foreground);
  --sidebar-accent: var(--background-section);
  --sidebar-accent-foreground: var(--foreground);
  --sidebar-border: var(--border-subtle);
  --sidebar-ring: var(--primary);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);
}

/* Base styles */
* {
  box-sizing: border-box;
  border-color: var(--color-border);
  outline-color: color-mix(in srgb, var(--color-ring) 50%, transparent);
}

body {
  background-color: var(--color-background);
  color: var(--color-foreground);
  font-feature-settings: "rlig" 1, "calt" 1;
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  line-height: 1.5;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
  font-weight: 700;
  line-height: 1.2;
  margin-top: 0;
  margin-bottom: 0.5em;
  letter-spacing: -0.025em;
}

h1 { font-size: 2.5rem; }
h2 { font-size: 2rem; }
h3 { font-size: 1.75rem; }
h4 { font-size: 1.5rem; }
h5 { font-size: 1.25rem; }
h6 { font-size: 1rem; }

p {
  margin-top: 0;
  margin-bottom: 1rem;
  line-height: 1.6;
  color: color-mix(in srgb, var(--color-foreground) 90%, transparent);
}

a {
  color: var(--color-primary);
  text-decoration: none;
  transition: color 0.2s ease;
}

a:hover {
  text-decoration: underline;
}

button {
  cursor: pointer;
  outline: none;
}

button:focus {
  outline: 2px solid var(--color-ring);
  outline-offset: 2px;
}

input,
textarea,
select {
  width: 100%;
  border-radius: 0.375rem;
  border: 1px solid var(--color-input);
  background-color: var(--color-background);
  color: var(--color-foreground);
  padding: 0.5rem 0.75rem;
  font-size: 1rem;
  line-height: 1.5;
  transition: border-color 0.2s, box-shadow 0.2s;
}

input:focus,
textarea:focus,
select:focus {
  border-color: var(--color-ring);
  box-shadow: 0 0 0 2px var(--color-ring);
  outline: none;
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--color-background);
}

::-webkit-scrollbar-thumb {
  background: var(--color-muted);
  border-radius: 9999px;
}

::-webkit-scrollbar-thumb:hover {
  background: color-mix(in srgb, var(--color-muted-foreground) 50%, transparent);
}

  background-size: 400px 400px;
  background-repeat: no-repeat;
  background-position: center center;
  background-attachment: fixed;
  opacity: 0.02;
  pointer-events: none;
  z-index: -1;
  filter: grayscale(1) brightness(0.8);
}

/* Google Brand Colors */
.bg-brand-blue {
  background-color: var(--accent-blue);
}
  .bg-brand-blue-light {
    background-color: var(--accent-blue-light);
  }
  .bg-brand-green {
    background-color: var(--accent-green);
  }
  .bg-brand-yellow {
    background-color: var(--accent-yellow);
  }
  .bg-brand-red {
    background-color: var(--accent-red);
  }
  .text-brand-blue {
    color: var(--accent-blue);
  }
  .text-brand-blue-light {
    color: var(--accent-blue-light);
  }
  .text-brand-green {
    color: var(--accent-green);
  }
  .text-brand-yellow {
    color: var(--accent-yellow);
  }
  .text-brand-red {
    color: var(--accent-red);
  }
  .border-brand-blue {
    border-color: var(--border-primary);
  }

  /* Background Colors */
  .bg-surface-base {
    background-color: var(--background);
  }
  .bg-surface-section {
    background-color: var(--background-section);
  }
  .bg-surface-card {
    background-color: var(--background-card);
  }
  .bg-surface-elevated {
    background-color: var(--background-elevated);
  }

  /* Text Colors */
  .text-content-primary {
    color: var(--foreground);
  }
  .text-content-secondary {
    color: var(--foreground-secondary);
  }
  .text-content-muted {
    color: var(--foreground-muted);
  }

  /* Border Colors */
  .border-subtle {
    border-color: var(--border-subtle);
  }

  /* Button Gradients */
  .btn-gradient {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    transition-property: all;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }
  
  .btn-gradient:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 15px -3px rgb(0, 0, 0, 0.1), 
                0 4px 6px -4px rgb(0, 0, 0, 0.1),
                0 0 16px rgb(66, 133, 244, 0.4);
  }

  /* Card Effects */
  .card-surface {
    background-color: var(--background-card);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 1px 3px rgb(0, 0, 0, 0.3);
    border-radius: 0.5rem;
  }
  .card-surface:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgb(0, 0, 0, 0.4);
    border-color: var(--primary);
  }

  /* Glow Effects */
  .glow-primary {
    box-shadow: 0 0 16px rgb(66, 133, 244, 0.3);
  }

  /* Typography Utilities */
  .text-xs {
    font-size: 12px;
  }
  .text-sm {
    font-size: 14px;
  }
  .text-base {
    font-size: 16px;
  }
  .text-lg {
    font-size: 18px;
  }
  .text-xl {
    font-size: 24px;
  }
  .text-2xl {
    font-size: 32px;
  }
  .text-3xl {
    font-size: 48px;
  }
  .text-4xl {
    font-size: 64px;
  }

  .leading-tight {
    line-height: 120%;
  }
  .leading-base {
    line-height: 150%;
  }
  .leading-relaxed {
    line-height: 160%;
  }

  .font-regular {
    font-weight: 400;
  }
  .font-medium {
    font-weight: 500;
  }
  .font-semibold {
    font-weight: 600;
  }

  /* Spacing */
  .space-xs {
    margin: 8px;
  }
  .space-sm {
    margin: 16px;
  }
  .space-md {
    margin: 24px;
  }
  .space-lg {
    margin: 32px;
  }
  .space-xl {
    margin: 48px;
  }
  .space-2xl {
    margin: 64px;
  }
  .space-3xl {
    margin: 96px;
  }

  /* Border Radius */
  .rounded-sm {
    border-radius: 4px;
  }
  .rounded-md {
    border-radius: 8px;
  }
  .rounded-lg {
    border-radius: 16px;
  }
  .rounded-xl {
    border-radius: 24px;
  }

  /* Box Shadows */
  .shadow-sm {
    box-shadow: 0 1px 3px rgb(0, 0, 0, 0.3);
  }
  .shadow-md {
    box-shadow: 0 4px 16px rgb(0, 0, 0, 0.4);
  }
  .shadow-lg {
    box-shadow: 0 8px 32px rgb(0, 0, 0, 0.5);
  }

/*
 * Base typography. This is not applied to elements which have an ancestor with a Tailwind text class.
 */
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) h1,
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) h2,
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) h3,
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) h4,
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) p,
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) label,
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) button,
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) input {
  line-height: 1.5;
}

:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) h1 {
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-medium);
}

:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) h2 {
  font-size: var(--text-xl);
  font-weight: var(--font-weight-medium);
}

:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) h3 {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-medium);
}

:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) h4 {
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
}

:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) p,
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) input {
  font-size: var(--text-base);
  font-weight: var(--font-weight-normal);
}

:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) label,
:where(html:not(:has([class*=' text-'])):not(:has([class^='text-']))) button {
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
}

html {
  font-size: var(--font-size);
}
