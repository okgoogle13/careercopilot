<?xml version="1.0" encoding="UTF-8"?>
<wireframe version="6.0.0" screen_id="kanban" design_system="kr-solidarity" mode="solidarity-only">
  <meta>
    <title>Application Kanban Board</title>
    <description>Drag-drop Kanban board for managing job applications across stages (Applied, Interviewing, Offered, Rejected, Archived). Placard-based cards with Strike CTAs for stage transitions.</description>
    <user_story>As a user, I can visually track my applications across multiple stages and take action on each opportunity.</user_story>
    <emotional_register>Control</emotional_register>
    <viewport base_width="1440" base_height="900" />
  </meta>

  <layout><![CDATA[
+------------------------------------------------------------------+
| [SCAFFOLD: TopNav — shared shell, not route-owned]               |
+------------------------------------------------------------------+
| [Scaffold: Col 1] | [Scaffold: Col 2] | [Scaffold: Col 3]       |
| Applied            | Interviewing       | Offered                |
| +---+  +---+       | +---+  +---+       | +---+                  |
| |Card| |Card|      | |Card| |Card|      | |Card|                 |
| +---+  +---+       | +---+  +---+       | +---+                  |
|                     |                    |                        |
| [Scaffold: Col 4]  | [Scaffold: Col 5]  |                        |
| Rejected            | Archived           |                        |
| +---+               | +---+              |                        |
| |Card|              | |Card|             |                        |
| +---+               | +---+              |                        |
+------------------------------------------------------------------+
| [Megaphone: Detail Modal — overlays board when card clicked]     |
| +-------------------------------+  +---------------------------+ |
| | ApplicationDetailPanel        |  | ApplicationStatusActions  | |
| | [tabs: timeline|notes|details]|  | [Strike: Schedule]        | |
| |                               |  | [Strike: Accept]          | |
| | [Scaffold: ApplicationEdit    |  | [Strike: Reject]          | |
| |  Form — notes, salary, meta]  |  | [Strike: Archive]         | |
| +-------------------------------+  +---------------------------+ |
+------------------------------------------------------------------+
  ]]></layout>

  <layout_structure>
    <grid type="kanban" columns="5" gap="16px" overflow="horizontal-scroll" />
    <column_sizing min_width="280px" max_width="320px" height="calc(100vh - 160px)" />
    <card_sizing width="100%" min_height="100px" max_height="160px" />
  </layout_structure>

  <layout_binding>
    <binding element="kanban-topnav" layout_slot="page-header" sticky="true" />
    <binding element="kanban-column-applied" layout_slot="grid-column-1" />
    <binding element="kanban-column-interview" layout_slot="grid-column-2" />
    <binding element="kanban-column-offered" layout_slot="grid-column-3" />
    <binding element="kanban-column-rejected" layout_slot="grid-column-4" />
    <binding element="kanban-column-archived" layout_slot="grid-column-5" />
    <binding element="kanban-card-*" layout_slot="column-child" stack="vertical" gap="8px" />
    <binding element="kanban-detail-panel" layout_slot="overlay" />
    <binding element="kanban-edit-form" layout_slot="detail-panel-left" />
    <binding element="kanban-status-actions" layout_slot="detail-panel-right" />
    <binding element="kanban-archive-action" layout_slot="detail-panel-right-bottom" />
  </layout_binding>

  <responsive_rules>
    <rule breakpoint="mobile" max_width="640px">
      <change>Columns stack vertically, one visible at a time with horizontal swipe navigation</change>
      <change>Cards expand to full width</change>
      <change>Detail panel becomes full-screen bottom sheet</change>
    </rule>
    <rule breakpoint="tablet" min_width="641px" max_width="1024px">
      <change>Show 2-3 columns at a time with horizontal scroll</change>
      <change>Detail panel becomes side sheet at 50% viewport width</change>
    </rule>
    <rule breakpoint="desktop" min_width="1025px">
      <change>All 5 columns visible simultaneously</change>
      <change>Detail panel is centered modal overlay</change>
    </rule>
  </responsive_rules>

