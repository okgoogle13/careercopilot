      <content content_type="static" label="Application Tracker" i18n_label_key="nav.tracker.title" />
      <functionality intent="Route-level navigation and view mode switching." action="Toggle between kanban and list view. Navigate to other product routes." />
      <interaction patterns="click" states="default" />
      <tokens color_token="--sys-color-charcoalBackground-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-scaffoldSlab01" z_layer="Z-3" />
      <accessibility label_source="aria-label" aria_role="navigation" />
      <test_ids primary="kanban-topnav" />
      <ownership_note>Shared shell component owned by App.tsx layout. Not route-owned by /tracker.</ownership_note>
    </element>

