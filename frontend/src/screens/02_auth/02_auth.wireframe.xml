<?xml version="1.0" encoding="UTF-8"?>
<wireframe
  version="6.0.0"
  screen_id="auth"
  design_system="kr-solidarity"
  mode="solidarity-only"
>

  <meta>
    <title>Authentication (Login / Register)</title>
    <description>Unified auth entry point with trust-focused UX. Minimal, clear form with email/password or OAuth options. Single-screen registration and login flow with error recovery.</description>
    <user_story>As a new/returning user, I can quickly register or log in with clear error feedback and secure password handling.</user_story>
    <emotional_register>Trust</emotional_register>
    <viewport base_width="1440" base_height="900" />
    <breakpoints values="xs,sm,md,lg" />
  </meta>

  <layout>
    <![CDATA[
+------------------------------------------------------------------+
| [SUBSTRATE: Dark gradient background]                            |
|                                                                  |
|                   +---------------------------+                |
|                   | [PLACARD: Auth Panel]     |                |
|                   |                           |                |
|                   |  [STRIKE: Logo]           |                |
|                   |  [H2: Login/Register]     |                |
|                   |                           |                |
|                   |  [SCAFFOLD: Email Input]  |                |
|                   |  [SCAFFOLD: Password]     |                |
|                   |                           |                |
|                   |  [STRIKE: Primary CTA]    |                |
|                   |  [MARCH: Link Toggle]     |                |
|                   |                           |                |
|                   |  [SCAFFOLD: OAuth divider]|                |
|                   |  [STRIKE: Google OAuth]   |                |
|                   |  [STRIKE: Apple OAuth]    |                |
|                   +---------------------------+                |
|                                                                  |
+------------------------------------------------------------------+
    ]]>
  </layout>

  <elements>

    <!-- Auth Panel Container -->
    <element
      id="auth-panel"
      element_type="card"
      archetype="Placard"
      role="region"
      layout_role="form-container"
      x="440" y="200" width="560" height="700"
    >
      <component_mapping
        design_system_component="KR/Card/Placard"
        code_component="Placard"
        props_interface="PlacardProps"
        variant="panel"
      />
      <content
        content_type="static"
        sample_text="Authentication Panel"
      />
      <tokens
        color_token="--sys-color-charcoalBackground-base"
        typography_token="--sys-type-font-work-sans"
        shape_token="--sys-shape-placardTorn01"
        z_layer="Z-2"
      />
      <interaction
        patterns="none"
        states="default"
      />
      <accessibility
        role="region"
        aria_label="Login or Register"
      />
      <test_ids primary="auth-panel" />
      <ux_rationale>
        Placard archetype contains auth form. Torn asymmetric shape reinforces brand while maintaining clarity for sensitive form data.
      </ux_rationale>
    </element>

    <!-- Logo / Brand Mark -->
    <element
      id="auth-logo"
      element_type="text"
      archetype="Strike"
      role="heading"
      layout_role="brand-logo"
      x="480" y="240" width="480" height="60"
    >
      <component_mapping
        design_system_component="KR/Typography/Brand"
        code_component="Typography"
        props_interface="TypographyProps"
        variant="brand-logo"
      />
      <content
        content_type="static"
        sample_text="CareerCopilot"
        i18n_label_key="auth.brand.logo"
      />
      <tokens
        color_token="--sys-color-inkGold-base"
        typography_token="--sys-type-font-fraunces"
        z_layer="Z-3"
      />
      <interaction
        patterns="click"
        states="default,hover"
        on_click="Navigate to /"
      />
      <accessibility
        label_source="visible-text"
        heading_level="1"
      />
      <test_ids primary="auth-logo" />
      <ux_rationale>
        Brand mark at top of form. Fraunces emphasizes identity. Clickable to return to landing.
      </ux_rationale>
    </element>

    <!-- Form Title / Toggle -->
