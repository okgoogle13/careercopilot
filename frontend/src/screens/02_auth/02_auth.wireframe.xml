      id="auth-title"
      element_type="text"
      archetype="March"
      role="heading"
      layout_role="form-title"
      x="480" y="320" width="480" height="50"
    >
      <component_mapping
        design_system_component="KR/Typography/H2"
        code_component="Typography"
        props_interface="TypographyProps"
        variant="h2"
      />
      <content
        content_type="static"
        sample_text="Log in to your account"
        i18n_label_key="auth.form.title"
      />
      <tokens
        color_token="--sys-color-paperWhite"
        typography_token="--sys-type-font-fraunces"
        z_layer="Z-3"
      />
      <interaction
        patterns="static"
        states="default"
      />
      <accessibility
        label_source="visible-text"
        heading_level="2"
      />
      <test_ids primary="auth-title" />
      <ux_rationale>
        March archetype for form labeling. Clear, hierarchical heading. Dynamic text switches between "Log in" / "Register".
