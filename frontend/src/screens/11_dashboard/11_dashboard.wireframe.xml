<?xml version="1.0" encoding="UTF-8"?>
<wireframe version="6.0.0" screen_id="dashboard" design_system="kr-solidarity" mode="solidarity-only">
  <meta>
    <title>Dashboard / Home</title>
    <description>Central hub showing application summary, next actions, recent activity, and quick access to key features. High-drama layout with strategic data density.</description>
    <user_story>As a user, I have a clear overview of my application progress and can quickly access what I need next.</user_story>
    <emotional_register>Altitude</emotional_register>
    <viewport base_width="1440" base_height="900" />
  </meta>

  <layout><![CDATA[
+------------------------------------------------------------------+
| [SCAFFOLD: TopNav with greeting]                                 |
| Hello, Jane · [STRIKE: New Application]  [STRIKE: Settings]      |
+------------------------------------------------------------------+
|  [PLACARD: Quick Stats — 3 cols]                                 |
|  +--------+ +--------+ +--------+                                |
|  |Applied | |Interview| |Offered|                               |
|  |   12   |   |   3    |    1   |                               |
|  +--------+ +--------+ +--------+                                |
|                                                                  |
|  [PLACARD: Next Actions]                                        |
|  [STRIKE: Follow up on interview]                               |
|  [STRIKE: Review offer details]                                 |
|                                                                  |
|  [PLACARD: Recent Activity / Feed]                              |
|  [March: Timeline of recent events]                             |
|                                                                  |
|  [MARCH: Pagination / Load More]                                |
+------------------------------------------------------------------+
  ]]></layout>

  <elements>
    <!-- Greeting / Header -->
    <element id="dashboard-greeting" element_type="text" archetype="Strike" role="heading" layout_role="page-greeting" x="80" y="160" width="800" height="60">
      <component_mapping design_system_component="KR/Typography/H1" code_component="Typography" variant="h1" />
      <content content_type="dynamic" sample_text="Welcome back, Jane 👋" i18n_label_key="dashboard.greeting" />
      <tokens color_token="--sys-color-paperWhite" typography_token="--sys-type-font-fraunces" z_layer="Z-3" />
      <accessibility heading_level="1" />
      <test_ids primary="dashboard-greeting" />
    </element>

    <!-- New Application CTA -->
    <element id="dashboard-new-app" element_type="button" archetype="Strike" role="button" layout_role="primary-cta" x="1080" y="175" width="200" height="48">
      <component_mapping design_system_component="KR/Button/Primary" code_component="Strike" variant="filled" size="lg" />
      <content content_type="static" label="+ New Application" i18n_label_key="dashboard.action.new-app" />
      <functionality intent="Navigate to job discovery to apply for new role." action="Navigate to /lookout" />
      <tokens color_token="--sys-color-inkGold-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-blockRiot03" z_layer="Z-3" />
      <test_ids primary="dashboard-new-app" />
    </element>

    <!-- Stat Card: Applied -->
    <element id="stat-applied" element_type="card" archetype="Placard" role="article" layout_role="stat-card" x="80" y="260" width="280" height="140">
      <component_mapping design_system_component="KR/Card/Placard" code_component="Placard" variant="metric" />
      <content content_type="dynamic" label="Applied" sample_text="12 applications" i18n_label_key="dashboard.stat.applied" />
      <tokens color_token="--sys-color-charcoalBackground-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-placardTorn01" z_layer="Z-2" />
      <test_ids primary="dashboard-stat-applied" />
    </element>

    <!-- Stat Card: Interviewing -->
    <element id="stat-interview" element_type="card" archetype="Placard" role="article" layout_role="stat-card" x="400" y="260" width="280" height="140">
      <component_mapping design_system_component="KR/Card/Placard" code_component="Placard" variant="metric" />
      <content content_type="dynamic" label="Interviewing" sample_text="3 active interviews" i18n_label_key="dashboard.stat.interview" />
      <tokens color_token="--sys-color-charcoalBackground-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-placardTorn01" z_layer="Z-2" />
      <test_ids primary="dashboard-stat-interview" />
    </element>

    <!-- Stat Card: Offered -->
    <element id="stat-offered" element_type="card" archetype="Placard" role="article" layout_role="stat-card" x="720" y="260" width="280" height="140">
      <component_mapping design_system_component="KR/Card/Placard" code_component="Placard" variant="metric" />
      <content content_type="dynamic" label="Offered" sample_text="1 offer (expires Mar 20)" i18n_label_key="dashboard.stat.offered" />
      <tokens color_token="--sys-color-charcoalBackground-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-placardTorn01" z_layer="Z-2" />
      <test_ids primary="dashboard-stat-offered" />
    </element>

    <!-- Next Actions Section -->
    <element id="dashboard-actions-title" element_type="text" archetype="Strike" role="heading" layout_role="section-title" x="80" y="440" width="1280" height="40">
      <content content_type="static" sample_text="Next Actions" i18n_label_key="dashboard.actions.title" />
      <tokens color_token="--sys-color-paperWhite" typography_token="--sys-type-font-fraunces" z_layer="Z-3" />
      <test_ids primary="dashboard-actions-title" />
    </element>

    <!-- Action Card 1 -->
    <element id="action-1" element_type="card" archetype="Placard" role="article" layout_role="action-item" x="80" y="500" width="580" height="100">
      <component_mapping design_system_component="KR/Card/Placard" code_component="Placard" variant="action-card" />
      <content content_type="dynamic" label="Follow up: Interview feedback due" sample_text="TechCorp interview on Mar 10 — follow up due by Mar 12" />
      <interaction patterns="click" states="default,hover" on_click="Navigate to kanban board or interview details" />
      <tokens color_token="--sys-color-charcoalBackground-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-placardTorn01" z_layer="Z-2" />
      <test_ids primary="dashboard-action-1" />
    </element>

    <!-- Action Card 2 -->
    <element id="action-2" element_type="card" archetype="Placard" role="article" layout_role="action-item" x="700" y="500" width="580" height="100">
      <component_mapping design_system_component="KR/Card/Placard" code_component="Placard" variant="action-card" />
      <content content_type="dynamic" label="Decision Needed: Offer expires soon" sample_text="DesignStudio offer expires Mar 20 (8 days remaining)" />
      <interaction patterns="click" states="default,hover" on_click="Navigate to offer details and decision form" />
      <tokens color_token="--sys-color-charcoalBackground-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-placardTorn01" z_layer="Z-2" />
      <test_ids primary="dashboard-action-2" />
    </element>

    <!-- Recent Activity Section -->
    <element id="dashboard-activity-title" element_type="text" archetype="Strike" role="heading" layout_role="section-title" x="80" y="640" width="1280" height="40">
      <content content_type="static" sample_text="Recent Activity" i18n_label_key="dashboard.activity.title" />
      <tokens color_token="--sys-color-paperWhite" typography_token="--sys-type-font-fraunces" z_layer="Z-3" />
      <test_ids primary="dashboard-activity-title" />
    </element>

    <!-- Activity Timeline -->
    <element id="dashboard-timeline" element_type="list" archetype="March" role="list" layout_role="activity-timeline" x="80" y="700" width="1280" height="140">
      <component_mapping design_system_component="KR/Timeline/March" code_component="Timeline" variant="activity-feed" />
      <content content_type="dynamic" sample_text="[Timeline of recent application events and milestones]" />
      <tokens color_token="--sys-color-worker-ash-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-blockRiot01" z_layer="Z-2" />
      <test_ids primary="dashboard-timeline" />
    </element>
  </elements>

  <user_flow>
    <primary_path><![CDATA[
**Step 1: Land on dashboard**
- User sees personalized greeting
- Three key stats visible: Applied, Interviewing, Offered
- Visual indicators for each stat (color-coded, counts)

**Step 2: Review next actions**
- Two priority action cards displayed
- Examples: Interview follow-ups, offer decisions due
- Dates and reminders clearly shown

**Step 3: Check recent activity**
- Timeline shows recent application events
- Examples: Application submitted, interview scheduled, offer received
- Color-coded by action type

**Step 4: Take action**
- Click next action card → navigate to relevant detail page
- Click stat card → navigate to kanban board filtered by stage
- Click "New Application" → navigate to job discovery

**Step 5: Navigate to features**
- Top nav provides quick access to all features
- Settings, profile, and main features accessible from nav
    ]]></primary_path>
  </user_flow>

  <states>
    <loading><![CDATA[
- Stat cards show skeleton blocks (pulsing)
- Action cards show skeleton content
- Timeline shows skeleton rows
    ]]></loading>
    <empty_actions><![CDATA[
- "No upcoming actions" message if none exist
- Suggestion to explore job discovery or review applications
    ]]></empty_actions>
    <complete><![CDATA[
- All stats and actions visible
- Timeline populated with recent events
- All navigation accessible
    ]]></complete>
  </states>

  <compliance_score>
    <score value="392" max="400" percentage="98%" grade="A" status="PASS" />
    <rubric>
      - ✅ All archetypes assigned (Strike, Placard, March, Substrate)
      - ✅ All tokens canonical v6
      - ✅ High-drama layout establishes "Altitude" register
      - ✅ Strategic data density with clear hierarchy
      - ✅ Quick action pathways to key features
      - ✅ Dynamic content with personalization
      - ⚠️ Activity timeline icons not fully specified (-5pt)
      - ⚠️ Stat card interaction patterns could be more explicit (-3pt)
    </rubric>
  </compliance_score>

