    <!-- Job Card 1 -->
    <element id="job-card-1" element_type="card" archetype="Placard" role="article" layout_role="job-item" x="420" y="160" width="1000" height="160">
      <component_mapping design_system_component="KR/Card/Placard" code_component="Placard" variant="job-listing" />
      <content content_type="dynamic" label="Senior Product Designer" sample_text="TechCorp · San Francisco, CA · $130K-$160K · Design, Leadership" i18n_label_key="lookout.job.title" />
      <tokens color_token="--sys-color-charcoalBackground-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-placardTorn01" z_layer="Z-2" />
      <test_ids primary="lookout-job-1" />
    </element>

    <!-- Job Card 1 Apply Button -->
    <element id="job-card-1-apply" element_type="button" archetype="Strike" role="button" layout_role="apply-cta" x="1320" y="200" width="100" height="40">
      <component_mapping design_system_component="KR/Button/Chip" code_component="Strike" variant="compact" />
      <content content_type="static" label="Apply" i18n_label_key="lookout.job.apply" />
      <functionality intent="Apply to job listing." action="Show application modal or navigate to application form" />
      <interaction patterns="click" states="default,hover,pressed,loading" />
      <tokens color_token="--sys-color-inkGold-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-blockRiot03" z_layer="Z-3" />
      <test_ids primary="lookout-job-1-apply" />
    </element>

    <!-- Job Card 2 -->
    <element id="job-card-2" element_type="card" archetype="Placard" role="article" layout_role="job-item" x="420" y="340" width="1000" height="160">
      <component_mapping design_system_component="KR/Card/Placard" code_component="Placard" variant="job-listing" />
      <content content_type="dynamic" label="UX Researcher" sample_text="StartupLabs · Remote · $100K-$125K · Research, User Testing" i18n_label_key="lookout.job.title" />
      <tokens color_token="--sys-color-charcoalBackground-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-placardTorn01" z_layer="Z-2" />
      <test_ids primary="lookout-job-2" />
    </element>

    <!-- Job Card 2 Apply Button -->
    <element id="job-card-2-apply" element_type="button" archetype="Strike" role="button" layout_role="apply-cta" x="1320" y="380" width="100" height="40">
      <component_mapping design_system_component="KR/Button/Chip" code_component="Strike" variant="compact" />
      <content content_type="static" label="Apply" i18n_label_key="lookout.job.apply" />
      <functionality intent="Apply to job listing." action="Show application modal or navigate to application form" />
      <tokens color_token="--sys-color-inkGold-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-blockRiot03" z_layer="Z-3" />
      <test_ids primary="lookout-job-2-apply" />
    </element>

    <!-- Pagination -->
    <element id="pagination" element_type="navigation" archetype="March" role="navigation" layout_role="pagination" x="420" y="740" width="1000" height="40">
      <component_mapping design_system_component="KR/Pagination/March" code_component="Pagination" variant="default" />
      <content content_type="dynamic" sample_text="Page 1 of 25 · Next / Previous" i18n_label_key="lookout.pagination" />
      <interaction patterns="click" states="default,active,disabled" on_click="Navigate to page" />
      <tokens color_token="--sys-color-worker-ash-base" typography_token="--sys-type-font-work-sans" shape_token="--sys-shape-blockRiot01" z_layer="Z-3" />
      <test_ids primary="lookout-pagination" />
    </element>
  </elements>

  <user_flow>
    <primary_path><![CDATA[
**Step 1: Land on job discovery**
- Sidebar shows filter options
- Job feed loads with default recommendations
- Jobs are ranked by relevance to user profile

**Step 2: Filter (optional)**
- User adjusts filters: category, location, salary, experience level
- Job feed updates in real-time
- Matching count updates

**Step 3: Browse jobs**
- User scrolls through job cards
- Each card shows title, company, location, salary range
- Visual indicators for match quality (star rating, badge)

**Step 4: Apply**
- Click "Apply" button on job card
- Modal or form appears for quick application
- User can customize application or use pre-filled resume/cover letter
- Confirmation on successful application

**Step 5: Pagination**
- User navigates to next page of results
- Feed updates with new jobs
    ]]></primary_path>
  </user_flow>

