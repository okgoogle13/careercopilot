<?xml version="1.0" encoding="UTF-8"?>
<wireframe version="6.0.0" screen_id="job_queue" design_system="kr-solidarity" mode="solidarity-only">
  <meta>
    <title>Job Queue: Job Discovery (Opportunities)</title>
    <description>Job search and discovery with filtering, smart matching, and application tracking. Placard-based feed with Strike CTAs and March filters.</description>
    <user_story>As a user, I can discover curated job opportunities aligned with my skills and apply with one click.</user_story>
    <emotional_register>Discovery</emotional_register>
    <viewport base_width="1440" base_height="900" />
  </meta>

  <layout><![CDATA[
+------------------------------------------------------------------+
| [SCAFFOLD: TopNav]                                               |
+------------------------------------------------------------------+
|  [SCAFFOLD: Sidebar filters]  | [PLACARD: Job feed]             |
|  [MARCH: Category filters]    | [PLACARD: Job card 1 — Apply]  |
|  [MARCH: Location filter]     | [PLACARD: Job card 2 — Apply]  |
|  [MARCH: Salary filter]       | [PLACARD: Job card 3 — Apply]  |
|  [MARCH: Experience level]    | [MARCH: Pagination]             |
|                               |                                 |
+------------------------------------------------------------------+
  ]]></layout>

