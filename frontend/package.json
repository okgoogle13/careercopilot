{
  "name": "frontend",
  "version": "0.0.0",
  "description": "CareerCopilot Frontend - React-based user interface",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "bundle-analysis": "vite build --mode analyze && node scripts/bundle-analyzer.js",
    "test": "echo 'No tests specified yet' && exit 0",
    "test:e2e": "echo 'No e2e tests specified yet' && exit 0",
    "test:all": "npx jest --runInBand --colors && npx playwright test",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.1",
    "framer-motion": "12.23.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hot-toast": "2.5.2",
    "react-router-dom": "7.8.0"
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "frontend"
  ],
  "author": "CareerCopilot Team",
  "license": "UNLICENSED"
}
