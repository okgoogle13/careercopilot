{
  "name": "careercopilot-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered career application assistant",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-vm-modules' vite",
    "build": "NODE_OPTIONS='--max-old-space-size=2048' tsc && vite build",
    "preview": "vite preview --port 3001 --host 0.0.0.0",
    "prepare": "husky || true",
    "pre-commit": "lint-staged",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.mjs",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.mjs --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.mjs --coverage",
    "test:update": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.mjs --updateSnapshot",
    "test:ui": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.mjs --watch",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.mjs --ci --coverage --passWithNoTests",
    "test:e2e": "NODE_ENV=test playwright test --config=playwright.config.ts",
    "test:e2e:mock": "NODE_ENV=test VITE_USE_MOCK_AUTH=true VITE_OFFLINE_MODE=true playwright test --config=playwright.config.ts",
    "test:e2e:headed": "NODE_ENV=test playwright test --config=playwright.config.ts --headed",
    "test:e2e:debug": "NODE_ENV=test playwright test --config=playwright.config.ts --debug",
    "test:e2e:ui": "NODE_ENV=test playwright test --config=playwright.config.ts --ui",
    "test:e2e:critical": "NODE_ENV=test playwright test tests/auth-application-flow.spec.js --config=playwright.config.ts",
    "test:e2e:critical:headed": "NODE_ENV=test playwright test tests/auth-application-flow.spec.js --config=playwright.config.ts --headed",
    "test:setup": "node scripts/setup-test-user.js",
    "playwright:report": "playwright show-report playwright-report",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "lint:types": "tsc --noEmit",
    "lint:format": "prettier --check .",
    "lint:format:fix": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "storybook:quiet": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules dist .turbo .eslintcache docs/api",
    "ts-fix": "tsc --noEmit --pretty --skipLibCheck --incremental false",
    "fix": "yarn fix:types && yarn fix:eslint && yarn format",
    "fix:types": "tsc --noEmit --pretty --skipLibCheck --incremental false --noUnusedLocals false --noUnusedParameters false || true",
    "fix:eslint": "eslint . --ext .ts,.tsx --fix --max-warnings=0",
    "docs": "jsdoc -c jsdoc.config.json",
    "docs:serve": "serve docs/api",
    "docs:clean": "rimraf docs/api",
    "docs:build": "yarn docs:clean && yarn docs"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@careercopilot/ui": "*",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/react": "^10.38.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.90.12",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.23.26",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-helmet-async": "^2.0.4",
    "react-hook-form": "^7.69.0",
    "react-is": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.23.1",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.1",
