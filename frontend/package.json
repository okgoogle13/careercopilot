{
  "name": "careercopilot-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered career application assistant",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-vm-modules' vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "prepare": "husky || true",
    "pre-commit": "lint-staged",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.js",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch --config=jest.config.js",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --config=jest.config.js",
    "test:update": "NODE_OPTIONS='--experimental-vm-modules' jest --updateSnapshot --config=jest.config.js",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' npx jest --config=jest.config.js --ci --runInBand --coverage --passWithNoTests",
    "test:e2e": "NODE_ENV=test playwright test --config=playwright.config.ts",
    "test:e2e:headed": "NODE_ENV=test playwright test --config=playwright.config.ts --headed",
    "test:e2e:debug": "NODE_ENV=test playwright test --config=playwright.config.ts --debug",
    "test:e2e:ui": "NODE_ENV=test playwright test --config=playwright.config.ts --ui",
    "playwright:report": "playwright show-report playwright-report",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "lint:types": "tsc --noEmit",
    "lint:format": "prettier --check .",
    "lint:format:fix": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules dist .next .turbo .eslintcache",
    "ts-fix": "tsc --noEmit --pretty --skipLibCheck --incremental false",
    "fix": "npm run fix:types && npm run fix:eslint && npm run format",
    "fix:types": "tsc --noEmit --pretty --skipLibCheck --incremental false --noUnusedLocals false --noUnusedParameters false || true",
    "fix:eslint": "eslint . --ext .ts,.tsx --fix --max-warnings=0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.4",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.13.1",
    "date-fns": "^3.0.0",
    "firebase": "^12.2.1",
    "motion": "^12.23.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^8.1.11",
    "@storybook/react": "^8.1.11",
    "@storybook/react-vite": "^8.1.11",
    "@storybook/test": "^8.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^4.2.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^0.8.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jiti": "^2.6.1",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "^8.1.11",
    "terser": "^5.44.0",
    "ts-jest": "^29.1.2",
    "ts-morph": "^27.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^5.0.0",
    "vite-plugin-checker": "^0.7.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.1.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
