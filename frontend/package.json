{
  "name": "careercopilot-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts --environment jsdom",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "verify-tests": "node scripts/verify-tests.js",
    "test:watch": "vitest watch --config vitest.config.ts --environment jsdom",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:ci": "vitest run --config vitest.config.ts --environment jsdom --coverage"
  },
  "dependencies": {
    "firebase": "^10.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@percy/cli": "^1.0.0",
    "@percy/playwright": "^1.0.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cypress": "^13.6.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^9.1.7",
    "jsdom": "^24.1.0",
    "lint-staged": "^16.1.5",
    "msw": "^2.10.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "5.4.5",
    "vitest": "^1.6.0",
    "vitest-dom": "^0.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --ext .ts,.tsx,.js,.jsx"
    ]
  }
}
