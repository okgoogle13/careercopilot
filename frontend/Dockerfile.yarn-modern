# Use an official Node.js runtime as a parent image
FROM node:18-alpine

# Enable Corepack and set working directory
ENV YARN_SILENT=0
WORKDIR /app

# Enable corepack to use the correct Yarn version (4.10.3)
RUN corepack enable

# Copy workspace configuration files
COPY package*.json ./
COPY yarn.lock ./
COPY frontend/package*.json ./frontend/

# Install dependencies using Yarn 4.x
# Use --ignore-engines to bypass engine checks and handle peer deps
RUN yarn install --ignore-engines

# Copy frontend source code
COPY frontend/ ./frontend/

# Build the frontend application
WORKDIR /app/frontend
RUN yarn build

# Expose the port and set the command
EXPOSE 3000
CMD ["yarn", "run", "preview"]
