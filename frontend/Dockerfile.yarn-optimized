# Use an official Node.js runtime as a parent image
FROM node:18-alpine

# Set the working directory in the container (project root)
WORKDIR /app

# Copy root package.json and yarn.lock for workspace setup
COPY package*.json ./
COPY yarn.lock ./

# Copy frontend package.json and yarn.lock
COPY frontend/package*.json ./frontend/
# Note: frontend/yarn.lock may not exist since it's a workspace

# Install all dependencies using Yarn
# This will install both root and frontend dependencies
RUN yarn install --legacy-peer-deps

# Copy the entire frontend source code
COPY frontend/ ./frontend/

# Change to frontend directory for build operations
WORKDIR /app/frontend

# Build the frontend application for production
RUN yarn build

# Expose the port the app runs on
EXPOSE 3000

# Serve the built app using Yarn preview command
CMD ["yarn", "run", "preview"]
