# Storybook Environment Variables
# This file is used to configure environment-specific settings for Storybook

# Environment (development, staging, production)
STORYBOOK_ENV=development

# API Configuration
VITE_API_URL=http://localhost:5001/api
VITE_FRONTEND_URL=http://localhost:3000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_OFFLINE_MODE=true

# Storybook-specific settings
STORYBOOK_DISABLE_TELEMETRY=true

# Environment-specific overrides
# These will override the above settings based on STORYBOOK_ENV
if [ "$STORYBOOK_ENV" = "staging" ]; then
  VITE_API_URL=https://us-central1-careercopilot-staging.cloudfunctions.net/api
  VITE_FRONTEND_URL=https://careercopilot-staging.web.app
  VITE_ENABLE_ANALYTICS=true

elif [ "$STORYBOOK_ENV" = "production" ]; then
  VITE_API_URL=https://us-central1-careercopilot-468811.cloudfunctions.net/api
  VITE_FRONTEND_URL=https://careercopilot-468811.web.app
  VITE_ENABLE_ANALYTICS=true
fi
