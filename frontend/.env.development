# Development Environment - Local Testing
#
# IMPORTANT: This file contains placeholder values.
# DO NOT commit real Firebase credentials to version control.
#
# For local development:
# 1. Copy your Firebase project configuration from the Firebase Console
# 2. Replace the placeholder values below with your actual development credentials
# 3. Ensure this file is listed in .gitignore to prevent accidental commits

# Backend API Configuration
VITE_API_URL=http://localhost:8000
VITE_ENVIRONMENT=development

# Network fallback mode (tries Firebase first, falls back to local auth)
VITE_USE_FALLBACK_AUTH=true
VITE_OFFLINE_MODE=true

# Firebase Configuration
VITE_FIREBASE_API_KEY=AIzaSyDJFFXqfDSBZ4yoGAjaA3p60fg4fAONpSg
VITE_FIREBASE_AUTH_DOMAIN=careercopilot-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=careercopilot-staging
VITE_FIREBASE_STORAGE_BUCKET=careercopilot-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=473068119033
VITE_FIREBASE_APP_ID=1:473068119033:web:c3151b80152724aaa21328

# Development Features
VITE_SHOW_DEBUG_INFO=true
VITE_ENABLE_DEV_TOOLS=true

