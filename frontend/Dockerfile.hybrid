# Use an official Node.js runtime as a parent image
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy workspace configuration files
COPY package*.json ./
COPY yarn.lock ./
COPY frontend/package*.json ./frontend/

# Temporarily remove packageManager and engine fields
RUN sed -i '/packageManager/d' package.json && sed -i '/"engles"/,/}/d' package.json

# Install dependencies using npm (works in Docker) but keep Yarn lock for consistency
RUN npm install --legacy-peer-deps

# Copy frontend source code
COPY frontend/ ./frontend/

# Build the frontend application using npm (but keep Yarn commands for consistency)
WORKDIR /app/frontend
RUN npm run build

# Expose the port and set the command
EXPOSE 3000
CMD ["npm", "run", "preview"]
