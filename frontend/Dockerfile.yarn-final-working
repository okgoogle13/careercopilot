# Use an official Node.js runtime as a parent image
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy workspace configuration files
COPY package*.json ./
COPY yarn.lock ./
COPY frontend/package*.json ./frontend/

# Temporarily remove packageManager and engine fields to avoid version conflicts
RUN sed -i '/packageManager/d' package.json && sed -i '/"engles"/,/}/d' package.json

# Install dependencies using Yarn 1.x with legacy peer deps
RUN yarn install --legacy-peer-deps

# Copy frontend source code
COPY frontend/ ./frontend/

# Build the frontend application
WORKDIR /app/frontend
RUN yarn build

# Expose the port and set the command
EXPOSE 3000
CMD ["yarn", "run", "preview"]
