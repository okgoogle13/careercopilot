# MCP Servers - Environment Variables
# Copy to .env.mcp and fill with real values (git-ignored)

# GitHub Personal Access Token for various MCP integrations
# For Claude Desktop, VS Code, and other MCP clients:
GITHUB_PAT=github_pat_YOUR_NEW_TOKEN_HERE
GITHUB_TOKEN=github_pat_YOUR_NEW_TOKEN_HERE

# GitHub Personal Access Token specifically for Codex CLI
# Create at: https://github.com/settings/personal-access-tokens
# Required scopes: repo, workflow, read:org
CODEX_GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_TOKEN_HERE

# Other MCP Server Tokens
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_TOKEN
PERPLEXITY_API_KEY=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
