# CareerCopilot Environment Template
# Copy this file to create environment-specific configurations
# DO NOT commit this file with real values

# ====================================
# ENVIRONMENT IDENTIFICATION
# ====================================
ENVIRONMENT=development  # development, staging, production

# ====================================
# FIREBASE/GOOGLE CLOUD CONFIGURATION
# ====================================
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GCP_PROJECT_ID=your-project-id
GOOGLE_CLOUD_PROJECT=your-project-id
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ====================================
# DATABASE CONFIGURATION
# ====================================
DATABASE_URL=sqlite:///data/careercopilot.db  # For development
# DATABASE_URL=postgresql://user:password@localhost/careercopilot  # For production

# ====================================
# AI SERVICE API KEYS
# ====================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# ====================================
# VECTOR DATABASE
# ====================================
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment-here
PINECONE_INDEX_NAME=your-pinecone-index-name-here

# ====================================
# SEARCH APIS
# ====================================
SERP_API_KEY=your-serp-api-key-here

# ====================================
# APPLICATION SETTINGS
# ====================================
DEBUG=true  # false for production
LOG_LEVEL=DEBUG  # INFO for production

# ====================================
# SECURITY SETTINGS
# ====================================
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====================================
# DATABASE CREDENTIALS
# ====================================
DB_USER=your_db_user
DB_PASS=your_db_password

# ====================================
# REDIS CONFIGURATION (for production)
# ====================================
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:password@host:6379/0

# ====================================
# PERFORMANCE SETTINGS
# ====================================
MAX_WORKERS=2  # Adjust based on environment
DB_POOL_SIZE=3  # Adjust based on load

# ====================================
# FEATURE FLAGS
# ====================================
ENABLE_MULTI_AGENT=true
ENABLE_ML_ANALYSIS=true
ENABLE_WEB_SEARCH=true
ENABLE_EMAIL_NOTIFICATIONS=false

# ====================================
# MONITORING (for production)
# ====================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-secure-grafana-password

# ====================================
# RATE LIMITING
# ====================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
