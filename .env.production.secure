# Google Cloud Services
VERTEX_AI_PROJECT_ID=careercopilot-468811
VERTEX_AI_LOCATION=us-central1

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration (non-sensitive defaults)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=careercopilot
DB_USER=careercopilot
# DB_PASSWORD retrieved from Secret Manager

# Redis Configuration
# REDIS_PASSWORD retrieved from Secret Manager

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT_SECRET_KEY retrieved from Secret Manager

# Caching Configuration
CACHE_TTL_HOURS=24
ENABLE_CACHE=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Monitoring
GRAFANA_USER=admin
# GRAFANA_PASSWORD should be set via Secret Manager if needed

# Performance Tuning
MAX_WORKERS=4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Feature Flags
ENABLE_MULTI_AGENT=true
ENABLE_ML_ANALYSIS=true
ENABLE_WEB_SEARCH=true
ENABLE_EMAIL_NOTIFICATIONS=false

# Firebase Genkit Configuration
GENKIT_ENV=prod
GENKIT_LOG_LEVEL=INFO
ENABLE_GENKIT_FLOWS=true

# AI Model Configuration
DEFAULT_AI_MODEL=gemini-1.5-pro
BACKUP_AI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
MAX_TOKENS=4096

# Note: Sensitive values (API keys, passwords) are retrieved from Google Secret Manager
# Run scripts/setup-secrets.py to configure secrets securely
