rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reusable function to validate user ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Reusable function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Reusable function to validate document ownership from resource data
    function isDocumentOwner() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Reusable function to validate document ownership from incoming request data
    function isRequestOwner() {
      return request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User documents subcollection
      match /documents/{documentId} {
        allow read, write: if isOwner(userId);

        // Document analyses subcollection
        match /analyses/{analysisId} {
          allow read, write: if isOwner(userId);
        }
      }

      // User profiles subcollection
      match /profiles/{profileId} {
        allow read, write: if isOwner(userId);
      }

      // User opportunities subcollection
      match /opportunities/{opportunityId} {
        allow read, write: if isOwner(userId);
      }

      // User job analyses subcollection
      match /job_analyses/{analysisId} {
        allow read, write: if isOwner(userId);
      }

      // User settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // User activity logs subcollection
      match /activity_logs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Global documents collection (if documents exist at root level)
    match /documents/{documentId} {
      // Allow read/write only if the document belongs to the authenticated user
      allow read, write: if isDocumentOwner() || isRequestOwner();
    }

    // Global opportunities collection (read-only for authenticated users)
    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only server can write global opportunities
    }

    // Jobs collection (read-only for authenticated users)
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only server can write jobs

      // Job applications subcollection
      match /applications/{applicationId} {
        allow read, write: if isDocumentOwner() || isRequestOwner();
      }
    }

    // Templates collection (read-only for authenticated users)
    match /templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only server can manage templates
    }

    // System-wide analytics (server-only)
    match /analytics/{analyticsId} {
      allow read, write: if false; // Only server can access analytics
    }

    // Public configurations (read-only for authenticated users)
    match /configurations/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only server can update configurations
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}