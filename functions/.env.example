# ====================================
# Firebase Configuration
# ====================================
GCLOUD_PROJECT=your-project-id
FIREBASE_CONFIG={"projectId":"your-project-id","databaseURL":"https://your-project-id.firebaseio.com","storageBucket":"your-project-id.appspot.com"}

# ====================================
# Environment
# ====================================
NODE_ENV=development

# ====================================
# API Keys and External Services
# ====================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Email Service (e.g., SendGrid, Mailgun)
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@yourdomain.com

# Storage
STORAGE_BUCKET=your-project-id.appspot.com

# ====================================
# Application Settings
# ====================================
# Security
JWT_SECRET=your-jwt-secret-key
COOKIE_SECRET=your-cookie-secret

# CORS
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # 100 requests per window

# ====================================
# Feature Flags
# ====================================
ENABLE_MAINTENANCE_MODE=false
ENABLE_NEW_FEATURE_X=false

# ====================================
# Monitoring and Logging
# ====================================
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info  # error, warn, info, debug

# ====================================
# Database
# ====================================
# Only if using external database
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379

# ====================================
# Third-party Integrations
# ====================================
# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ====================================
# Deployment
# ====================================
# For production overrides
# NODE_ENV=production
# GCLOUD_PROJECT=your-production-project-id
# FIREBASE_CONFIG={"projectId":"your-production-project-id",...}
