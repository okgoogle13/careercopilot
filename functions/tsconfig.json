{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2021",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "src/types"]
    },
    "types": ["node"]
  },
  "compileOnSave": true,
  "include": [
    "src/**/*",
    ".eslintrc.js",
    "custom-build.js",
    "index.js"
  ],
  "exclude": ["node_modules", "lib"]
}
