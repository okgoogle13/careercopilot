{
  "name": "functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Firebase - CareerCopilot backend services",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "build": "echo 'Functions build completed'",
    "logs": "firebase functions:log",
    "clean": "rm -rf node_modules .firebase"
  },
  "dependencies": {
    "firebase-admin": "12.7.0",
    "firebase-functions": "6.0.0"
  },
  "keywords": [
    "firebase",
    "cloud-functions",
    "serverless",
    "backend"
  ],
  "author": "CareerCopilot Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "firebase-tools": "^14.15.1"
  }
}
