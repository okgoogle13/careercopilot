{
  "name": "functions",
  "packageManager": "yarn@4.9.1",
  "dependencies": {
    "@genkit-ai/core": "^1.19.1",
    "@genkit-ai/firebase": "^1.19.1",
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/secret-manager": "^6.1.0",
    "@google-cloud/storage": "^7.17.2",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@types/pdfkit": "^0.17.3",
    "docx": "^9.5.1",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.6.0",
    "genkit": "^1.19.1",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google-cloud/firestore": "^7.11.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/supertest": "^2.0.15",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.27.5",
    "firebase": "^12.2.1",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^13.27.0",
    "jest": "^30.1.3",
    "jest-junit": "^16.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.14.0"
  },
  "scripts": {
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "build": "tsc",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest --passWithNoTests --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --passWithNoTests",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "test:rules": "jest --config=jest.rules.config.js",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "lint:fix": "eslint . --fix",
    "logs": "firebase functions:log",
    "clean": "rm -rf node_modules .firebase lib coverage",
    "genkit:init": "node src/genkit-setup.js",
    "genkit:dev": "npx genkit ui:start",
    "genkit:flow": "npx genkit flow:run"
  },
  "version": "1.0.0",
  "description": "This directory contains the Cloud Functions for Firebase that power the CareerCopilot backend services.",
  "main": "lib/index.js",
  "directories": {
    "lib": "lib"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "20"
  }
}
