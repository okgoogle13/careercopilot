 1: /* eslint-disable */
 2: // Salvaged from: prototype_v2.0/src/hooks/useAiOutputs.ts
 3: // Strategy: S1 — Behavior Seam Extraction (transcribe logic only)
 4: // Destination: /analysis route
 5: // Data seam: criteria and output data must be supplied by the consumer via props.
 6: //   The prototype embedded hardcoded mock criteria here — that coupling is removed.
 7: import { useState } from 'react';
 8: 
 9: export type AiOutputTab = 'resume' | 'cover' | 'ksc';
10: 
11: export interface AiCriterion {
12:   id: number;
13:   title: string;
14:   required: boolean;
15: }
16: 
17: export function useAiOutputs() {
18:   const [activeTab, setActiveTab] = useState<AiOutputTab>('ksc');
19:   const [ignoredCriteria, setIgnoredCriteria] = useState<number[]>([]);
20: 
21:   const toggleCriteria = (id: number) => {
22:     setIgnoredCriteria((prev) =>
23:       prev.includes(id) ? prev.filter((i) => i !== id) : [...prev, id]
24:     );
25:   };
26: 
27:   const handleCopy = (text: string) => {
28:     navigator.clipboard.writeText(text);
29:   };
30: 
31:   return {
32:     activeTab,
33:     setActiveTab,
34:     ignoredCriteria,
35:     toggleCriteria,
36:     handleCopy,
37:   };
38: }
</file>

