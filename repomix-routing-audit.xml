 58: /**
 59:  * ModeSync Component
 60:  * Automatically switches between modes based on the current route
 61:  */
 62: export function ModeSync() {
 63:   const location = useLocation();
 64:   const setMode = useModeStore((state) => state.setMode);
 65: 
 66:   useEffect(() => {
 67:     const requiredMode = getModeForRoute(location.pathname);
 68:     setMode(requiredMode);
 69: 
 70:     if (import.meta.env.DEV) {
 71:       console.log(`[ModeSync] Route: ${location.pathname} → Mode: ${requiredMode}`);
 72:     }
 73:   }, [location.pathname, setMode]);
 74: 
 75:   return null; // Logic-only component
 76: }
