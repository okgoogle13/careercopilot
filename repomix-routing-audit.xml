<file path="frontend/src/features/analysis/components/DocumentInput.tsx">
  1: /**
  2:  * CLASSIFICATION: Support Component Only
  3:  * Prototype-only component.
  4:  */
  5: import React, { useState, useCallback, useRef } from 'react';
  6: import { motion, AnimatePresence } from 'motion/react';
  7: import { UploadIcon } from './icons/UploadIcon';
  8: import { FileIcon } from './icons/FileIcon';
  9: import { TrashIcon } from './icons/TrashIcon';
 10: import { KrDarkSpring } from '@/design/tokens/motion-presets';
 11: 
 12: interface DocumentInputProps {
 13:   onProcess: (
 14:     files: File[],
 15:     rawText?: string,
 16:     fileData?: { data: string; mimeType: string }[]
 17:   ) => void;
 18:   isLoading: boolean;
 19:   hideTitle?: boolean;
 20:   onRawTextChange?: (text: string) => void;
 21:   initialRawText?: string;
 22:   submitLabel?: string;
 23: }
 24: 
 25: const MAX_FILES = 10; // Reduced for prototype stability
 26: const MAX_FILE_SIZE = 10 * 1024 * 1024; // 10MB limit
 27: const ALLOWED_TYPES = [
 28:   'application/pdf',
 29:   'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
 30:   'text/plain',
 31: ];
 32: 
 33: export const DocumentInput: React.FC<DocumentInputProps> = ({
 34:   onProcess,
 35:   isLoading,
 36:   hideTitle,
 37:   onRawTextChange,
 38:   initialRawText = '',
 39:   submitLabel,
 40: }) => {
 41:   const [files, setFiles] = useState<File[]>([]);
 42:   const [rawText, setRawText] = useState(initialRawText);
 43:   const [isDragging, setIsDragging] = useState(false);
 44:   const [error, setError] = useState<string | null>(null);
 45:   const [isReading, setIsReading] = useState(false);
 46:   const fileInputRef = useRef<HTMLInputElement>(null);
 47: 
 48:   const handleTextChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
 49:     const newText = e.target.value;
 50:     setRawText(newText);
 51:     if (onRawTextChange) {
 52:       onRawTextChange(newText);
 53:     }
 54:   };
 55: 
 56:   const readFileAsBase64 = (file: File): Promise<{ data: string; mimeType: string }> => {
 57:     return new Promise((resolve, reject) => {
 58:       const reader = new FileReader();
 59:       reader.onload = () => {
 60:         const base64String = (reader.result as string).split(',')[1];
 61:         resolve({ data: base64String, mimeType: file.type || 'application/octet-stream' });
 62:       };
 63:       reader.onerror = () => reject(new Error(`Failed to read file: ${file.name}`));
 64:       reader.readAsDataURL(file);
 65:     });
 66:   };
 67: 
 68:   const handleFiles = useCallback((incomingFiles: FileList | null) => {
 69:     if (!incomingFiles) return;
 70:     setError(null);
 71:     const newFiles = Array.from(incomingFiles).filter((file) => {
 72:       const extension = file.name.split('.').pop()?.toLowerCase();
 73:       const isValidExtension = ['pdf', 'docx', 'txt'].includes(extension || '');
 74: 
 75:       if (file.size > MAX_FILE_SIZE) {
 76:         setError(`File too large: ${file.name}. Max size is 10MB.`);
 77:         return false;
 78:       }
 79: 
 80:       if (!ALLOWED_TYPES.includes(file.type) && !isValidExtension) {
 81:         setError(`File type not supported: ${file.name}. Please use PDF, DOCX, or TXT.`);
 82:         return false;
 83:       }
 84:       return true;
 85:     });
 86: 
 87:     setFiles((prevFiles) => {
 88:       const combined = [...prevFiles, ...newFiles];
 89:       if (combined.length > MAX_FILES) {
 90:         setError(`You can upload a maximum of ${MAX_FILES} documents.`);
 91:         return combined.slice(0, MAX_FILES);
 92:       }
 93:       return combined;
 94:     });
 95: 
 96:     if (fileInputRef.current) {
 97:       fileInputRef.current.value = '';
 98:     }
 99:   }, []);
100: 
101:   const handleDragEnter = (e: React.DragEvent) => {
102:     e.preventDefault();
103:     e.stopPropagation();
104:     setIsDragging(true);
105:   };
106:   const handleDragLeave = (e: React.DragEvent) => {
107:     e.preventDefault();
108:     e.stopPropagation();
109:     setIsDragging(false);
110:   };
111:   const handleDragOver = (e: React.DragEvent) => {
112:     e.preventDefault();
113:     e.stopPropagation();
114:   };
115:   const handleDrop = (e: React.DragEvent) => {
116:     e.preventDefault();
117:     e.stopPropagation();
118:     setIsDragging(false);
119:     handleFiles(e.dataTransfer.files);
120:   };
121: 
122:   const removeFile = (index: number) => {
123:     setFiles((prev) => prev.filter((_, i) => i !== index));
124:   };
125: 
126:   const handleSubmit = async (e: React.FormEvent) => {
127:     e.preventDefault();
128:     if ((files.length > 0 || rawText.trim().length > 0) && !isLoading && !isReading) {
129:       setIsReading(true);
130:       setError(null);
131:       try {
132:         const fileData = await Promise.all(files.map(readFileAsBase64));
133:         onProcess(files, rawText.trim(), fileData);
134:       } catch (err) {
135:         setError(err instanceof Error ? err.message : 'Failed to process files. Please try again.');
136:       } finally {
137:         setIsReading(false);
138:       }
139:     }
140:   };
141: 
142:   return (
143:     <div
144:       className="p-10 bg-[var(--sys-color-charcoalBackground-steps-2)] border-l-4 border-l-[var(--sys-color-solidarityRed-base)] border-y border-r border-y-[var(--kr-color-concrete-grey-steps-0)] border-r-[var(--kr-color-concrete-grey-steps-0)] shadow-[var(--sys-shadow-elevation2Placard)] my-8 mx-auto max-w-6xl"
145:       style={{ borderRadius: 'var(--sys-shape-blockRiot02)' }}
146:     >
147:       {!hideTitle && (
148:         <h2 className="text-3xl type-solidarityProtest text-[var(--sys-color-paperWhite-base)] mb-4 uppercase tracking-tight">
149:           1. Upload Your Career Documents
150:         </h2>
151:       )}
152:       <div className="flex gap-2 mb-8">
153:         <span className="px-3 py-1 bg-[var(--sys-color-charcoalBackground-steps-2)] text-[var(--sys-color-worker-ash-base)] text-sm font-bold uppercase tracking-wider rounded-full border border-[var(--kr-color-concrete-grey-steps-0)]">
154:           Up to {MAX_FILES} documents
155:         </span>
156:         <span className="px-3 py-1 bg-[var(--sys-color-charcoalBackground-steps-2)] text-[var(--sys-color-worker-ash-base)] text-sm font-bold uppercase tracking-wider rounded-full border border-[var(--kr-color-concrete-grey-steps-0)]">
157:           PDF · DOCX · TXT
158:         </span>
159:       </div>
160:       <form onSubmit={handleSubmit}>
161:         <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
162:           <div
163:             className={`relative border-2 border-dashed p-12 text-center transition-all cursor-pointer
164:               ${isDragging ? 'border-[var(--sys-color-primary-base)] bg-[var(--sys-color-primaryContainer-base)]' : 'border-[var(--kr-color-concrete-grey-steps-0)] hover:border-[var(--sys-color-paperWhite-base)]'}`}
165:             style={{ borderRadius: 'var(--sys-shape-blockRiot01)' }}
166:             onDragEnter={handleDragEnter}
167:             onDragLeave={handleDragLeave}
168:             onDragOver={handleDragOver}
169:             onDrop={handleDrop}
170:             onClick={() => fileInputRef.current?.click()}
171:           >
172:             <input
173:               ref={fileInputRef}
174:               type="file"
175:               multiple
176:               accept=".pdf,.docx,.txt,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"
177:               onChange={(e) => handleFiles(e.target.files)}
178:               className="hidden"
179:               disabled={isLoading || isReading}
180:             />
181:             <div className="flex flex-col items-center text-[var(--sys-color-paperWhite-base)]">
182:               <motion.div
183:                 animate={{ scale: isDragging ? 1.2 : 1 }}
184:                 transition={KrDarkSpring}
185:               >
186:                 <UploadIcon className="w-16 h-16 mb-6 text-[var(--sys-color-solidarityRed-base)]" />
187:               </motion.div>
188:               <p className="text-xl font-bold uppercase tracking-wider mb-2">
189:                 Drag & drop files here
190:               </p>
191:               <p className="text-[var(--sys-color-worker-ash-base)]">or click to select</p>
192:             </div>
193:           </div>
194: 
195:           <div className="flex flex-col">
196:             <label
197:               htmlFor="rawText"
198:               className="text-xl type-solidarityProtest text-[var(--sys-color-paperWhite-base)] mb-4 uppercase tracking-tight"
199:             >
200:               Paste raw text instead
201:             </label>
202:             <textarea
203:               id="rawText"
204:               value={rawText}
205:               onChange={handleTextChange}
206:               placeholder="If your PDF fails to upload, paste your unformatted resume or job description here..."
207:               className="flex-grow p-6 bg-[var(--sys-color-charcoalBackground-steps-2)] border border-[var(--kr-color-concrete-grey-steps-0)] text-[var(--sys-color-paperWhite-base)] focus:border-[var(--sys-color-primary-base)] focus:outline-none focus:shadow-[var(--sys-shadow-elevation2Placard)] transition-all resize-y"
208:               style={{ borderRadius: 'var(--sys-shape-blockRiot01)', minHeight: '200px' }}
209:               disabled={isLoading || isReading}
210:             />
211:           </div>
212:         </div>
213: 
214:         {error && (
215:           <p className="text-[var(--sys-color-kr-charcoalRed-base)] font-bold mt-6 text-lg uppercase tracking-wider">
216:             {error}
217:           </p>
218:         )}
219: 
220:         {files.length > 0 && (
221:           <div className="mt-8">
222:             <h3 className="text-xl type-solidarityProtest text-[var(--sys-color-paperWhite-base)] mb-4 uppercase tracking-tight">
223:               Selected Files:
224:             </h3>
225:             <div className="max-h-60 overflow-y-auto space-y-3 pr-2">
226:               {files.map((file, index) => (
227:                 <div
228:                   key={`${file.name}-${index}`}
229:                   className="flex items-center justify-between bg-[var(--sys-color-charcoalBackground-steps-2)] border border-[var(--kr-color-concrete-grey-steps-0)] p-4 animate-fade-in"
230:                   style={{ borderRadius: 'var(--sys-shape-blockRiot01)' }}
231:                 >
232:                   <div className="flex items-center gap-4 overflow-hidden">
233:                     <FileIcon className="w-8 h-8 text-[var(--sys-color-inkGold-base)] flex-shrink-0" />
234:                     <div className="overflow-hidden">
235:                       <p className="text-lg font-bold text-[var(--sys-color-paperWhite-base)] truncate">
236:                         {file.name}
237:                       </p>
238:                       <p className="text-sm text-[var(--sys-color-worker-ash-base)] uppercase tracking-wider">
239:                         {(file.size / 1024).toFixed(1)} KB
240:                       </p>
241:                     </div>
242:                   </div>
243:                   <button
244:                     type="button"
245:                     onClick={(e) => {
246:                       e.stopPropagation();
247:                       removeFile(index);
248:                     }}
249:                     disabled={isLoading || isReading}
250:                     className="p-2 text-[var(--sys-color-worker-ash-base)] hover:text-[var(--sys-color-kr-charcoalRed-base)] hover:bg-[var(--sys-color-charcoalBackground-steps-3)] disabled:text-[var(--sys-color-concreteGrey-steps-0)] transition-colors"
251:                     style={{ borderRadius: 'var(--sys-shape-blockRiot01)' }}
252:                   >
253:                     <TrashIcon className="w-6 h-6" />
254:                   </button>
255:                 </div>
256:               ))}
257:             </div>
258:           </div>
259:         )}
260: 
261:         <div className="mt-10 flex justify-end min-h-[60px]">
262:           <AnimatePresence>
263:             {(files.length > 0 || rawText.trim().length > 0) && (
264:               <motion.button
