 48:     if (locale === 'US') {
 49:       return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
 50:     } else {
 51:       return date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
 52:     }
 53:   };
 54: 
 55:   return (
 56:     <div
 57:       className="p-10 max-w-4xl mx-auto"
 58:       style={{
 59:         backgroundColor: template.bgLight,
 60:         fontFamily: template.fontSans,
 61:         color: template.textColor,
 62:         lineHeight: '1.5',
 63:       }}
 64:     >
 65:       {/* Header - ATS Friendly */}
 66:       <div
 67:         className="text-center mb-8 border-b-2 pb-6"
 68:         style={{ borderColor: template.primaryColor }}
 69:       >
 70:         <h1
 71:           className="text-4xl font-bold uppercase tracking-tight mb-2"
 72:           style={{ color: template.primaryColor }}
 73:         >
 74:           {Personal_Information.FullName}
 75:         </h1>
 76:         {analysis.Headline_Suggestion && (
 77:           <h2
 78:             className="text-xl font-medium mb-4"
 79:             style={{ color: template.secondaryColor }}
 80:           >
 81:             {analysis.Headline_Suggestion}
 82:           </h2>
 83:         )}
 84:         {template.layout === 'single' && (
 85:           <div className="text-sm flex flex-wrap justify-center gap-4 font-medium">
 86:             <span>{Personal_Information.Email}</span>
 87:             <span style={{ color: template.accentColor }}>•</span>
 88:             <span>{Personal_Information.Phone}</span>
 89:             <span style={{ color: template.accentColor }}>•</span>
 90:             <span>{Personal_Information.Location}</span>
 91:           </div>
 92:         )}
 93:         {template.layout === 'single' &&
 94:           Personal_Information.Portfolio_Website_URLs?.length > 0 && (
 95:             <div
 96:               className="text-sm mt-2 font-semibold"
 97:               style={{ color: template.secondaryColor }}
 98:             >
 99:               {Personal_Information.Portfolio_Website_URLs.join(' | ')}
100:             </div>
101:           )}
102:       </div>
103: 
104:       {template.layout === 'single' ? (
105:         <SingleColumnResume
106:           careerData={careerData}
107:           analysis={analysis}
108:           template={template}
109:           locale={locale}
110:           achievements={achievements}
111:           suggestions={suggestions}
112:           isPolishing={isPolishing}
113:           formatDate={formatDate}
114:           getAchievementsForEntry={getAchievementsForEntry}
115:           applySuggestion={applySuggestion}
116:           discardSuggestion={discardSuggestion}
117:           handlePolish={handlePolish}
118:           workEntries={workEntries}
119:           educationEntries={educationEntries}
120:           tailoredSummary={tailoredSummary}
121:           setTailoredSummary={setTailoredSummary}
122:         />
123:       ) : (
124:         <TwoColumnResume
125:           careerData={careerData}
126:           analysis={analysis}
127:           template={template}
128:           locale={locale}
129:           achievements={achievements}
130:           suggestions={suggestions}
131:           isPolishing={isPolishing}
132:           formatDate={formatDate}
133:           getAchievementsForEntry={getAchievementsForEntry}
134:           applySuggestion={applySuggestion}
135:           discardSuggestion={discardSuggestion}
136:           handlePolish={handlePolish}
137:           workEntries={workEntries}
138:           educationEntries={educationEntries}
139:           tailoredSummary={tailoredSummary}
140:           setTailoredSummary={setTailoredSummary}
141:         />
142:       )}
143:     </div>
144:   );
145: };
