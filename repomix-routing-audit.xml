<file path="frontend/src/features/analysis/hooks/useATSScoring.ts">
 1: import { useState, useEffect, useCallback } from 'react';
 2: import { debounce } from 'lodash';
 3: import { ATSScorer } from '../services/atsScorer';
 4: import { ATSScoreResult, CoverLetterScoreResult, DocumentType } from '../../../types/career';
 5: 
 6: export function useATSScoring(
 7:   documentText: string,
 8:   jobDescription: string,
 9:   documentType: DocumentType = 'resume',
10:   debounceMs: number = 800
11: ) {
12:   const [score, setScore] = useState<ATSScoreResult | CoverLetterScoreResult | null>(null);
13:   const [isCalculating, setIsCalculating] = useState(false);
14:   /**
15:    * Orchestrator Decision: KR Solidarity v6.1 Authority Model
16:    * 1. Backend (/api/v1/ats-score) is the Source of Truth for final results.
17:    * 2. Client-side (ATSScorer) provides immediate heuristic feedback for UX speed.
18:    */
19:   const scorer = new ATSScorer();
20: 
21:   const calculate = useCallback(
22:     debounce((text: string, job: string, type: DocumentType) => {
23:       setIsCalculating(true);
24:       try {
25:         const result = scorer.calculateScore(text, job, type);
26:         setScore(result);
27:       } catch (error) {
28:         console.error('ATS scoring error:', error);
29:       } finally {
30:         setIsCalculating(false);
31:       }
32:     }, debounceMs),
33:     []
34:   );
35: 
36:   useEffect(() => {
37:     if (documentText && jobDescription) {
38:       calculate(documentText, jobDescription, documentType);
39:     }
40: 
41:     return () => {
42:       calculate.cancel();
43:     };
44:   }, [documentText, jobDescription, documentType, calculate]);
45: 
46:   return { score, isCalculating };
47: }
</file>

