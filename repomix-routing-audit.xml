<file path="frontend/src/features/onboarding/OnboardingProgress.tsx">
 1: import { Check } from 'lucide-react';
 2: 
 3: interface OnboardingProgressProps {
 4:   currentStep: number;
 5:   totalSteps: number;
 6:   steps: string[];
 7: }
 8: 
 9: /**
10:  * OnboardingProgress — step indicator for the onboarding sequence.
11:  *
12:  * Rendered in OnboardingPage (step 1) and IngestionPage (step 2) so users
13:  * always know where they are in the activation flow.
14:  */
15: export function OnboardingProgress({ currentStep, totalSteps, steps }: OnboardingProgressProps) {
16:   return (
17:     <div
18:       className="flex items-center justify-center"
19:       role="list"
20:       aria-label={`Onboarding progress: step ${currentStep} of ${totalSteps}`}
21:     >
22:       {steps.map((label, idx) => {
23:         const stepNumber = idx + 1;
24:         const isComplete = stepNumber < currentStep;
25:         const isActive = stepNumber === currentStep;
26: 
27:         return (
28:           <div
29:             key={label}
30:             role="listitem"
31:             className="flex items-center"
32:           >
33:             {/* Step node */}
34:             <div className="flex flex-col items-center gap-2">
35:               <div
36:                 className={`
37:                   w-8 h-8 rounded-march flex items-center justify-center text-sm font-bold border-2 transition-all duration-300
38:                   ${
39:                     isComplete
40:                       ? 'bg-ink-gold border-ink-gold text-asphalt-black'
41:                       : isActive
42:                         ? 'bg-transparent border-ink-gold text-ink-gold'
43:                         : 'bg-transparent border-concrete-grey/30 text-concrete-grey/30'
44:                   }
45:                 `}
46:                 aria-current={isActive ? 'step' : undefined}
47:               >
48:                 {isComplete ? (
49:                   <Check
50:                     className="w-4 h-4"
51:                     strokeWidth={3}
52:                   />
53:                 ) : (
54:                   stepNumber
55:                 )}
56:               </div>
57:               <span
58:                 className={`
59:                   text-[10px] font-annotation uppercase tracking-[0.15em] whitespace-nowrap
60:                   ${isActive ? 'text-ink-gold' : isComplete ? 'text-concrete-grey' : 'text-concrete-grey/30'}
61:                 `}
62:               >
63:                 {label}
64:               </span>
65:             </div>
66: 
67:             {/* Connector line between steps */}
68:             {idx < steps.length - 1 && (
69:               <div
70:                 className={`
71:                   h-px w-12 md:w-20 mx-2 mb-5 transition-all duration-300
72:                   ${isComplete ? 'bg-ink-gold/60' : 'bg-concrete-grey/20'}
73:                 `}
74:               />
75:             )}
76:           </div>
77:         );
78:       })}
79:     </div>
80:   );
81: }
82: 
83: export default OnboardingProgress;
</file>

