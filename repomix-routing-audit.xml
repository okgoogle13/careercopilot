105:             >
106:               <p className="text-label-medium">{step}</p>
107:             </motion.div>
108:           );
109:         })}
110:       </div>
111:     </div>
112:   );
113: }
114: 
115: function getStatusVariant(status: string): StatusBadgeVariant {
116:   const norm = status.toLowerCase();
