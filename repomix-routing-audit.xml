 71:     { id: 'recent-graduate', title: 'Recent Graduate' },
 72:     { id: 'career-change', title: 'Career Change' },
 73:     { id: 'senior-advancement', title: 'Senior Advancement' },
 74:     { id: 'international-applicant', title: 'International Applicant' },
 75:   ];
 76: 
 77:   useEffect(() => {
 78:     async function loadHero() {
