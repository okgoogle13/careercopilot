 21: 
 22: export function useDocumentExport({
 23:   activeTab,
 24:   analysis,
 25:   careerData,
 26:   selectedTemplate,
 27:   coverLetterContent,
 28:   resumeRef,
 29:   kscRef,
 30:   assetId,
