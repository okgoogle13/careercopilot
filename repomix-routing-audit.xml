<file path="frontend/src/features/dashboard/components/ATSTrendChart.tsx">
  1: /* eslint-disable */
  2: /**
  3:  * ATS Trend Chart
  4:  *
  5:  * Pure SVG sparkline showing ATS score trend across last N applications.
  6:  * Harvested from: sources/prototype_v2.0/src/components/feature/DashboardOverview.tsx
  7:  * Route owner: /dashboard (B19 — DashboardVisuals)
  8:  *
  9:  * No external chart libs. Uses --sys-color-* tokens only.
 10:  * Positive segments: --sys-color-inkGold-base
 11:  * Critical dip segments: --sys-color-solidarityRed-base
 12:  */
 13: 
 14: interface DataPoint {
 15:   label: string;
 16:   score: number;
 17: }
 18: 
 19: interface ATSTrendChartProps {
 20:   data?: DataPoint[];
 21:   height?: number;
 22: }
 23: 
 24: const DEFAULT_DATA: DataPoint[] = [
 25:   { label: 'App 1', score: 78 },
 26:   { label: 'App 2', score: 85 },
 27:   { label: 'App 3', score: 92 },
 28:   { label: 'App 4', score: 88 },
 29:   { label: 'App 5', score: 95 },
 30: ];
 31: 
 32: const WIDTH = 400;
 33: const HEIGHT = 160;
 34: const PADDING = { top: 16, right: 16, bottom: 32, left: 36 };
 35: 
 36: function toSvgCoords(
 37:   points: DataPoint[],
 38:   w: number,
 39:   h: number,
 40:   pad: typeof PADDING
 41: ): Array<{ x: number; y: number; score: number; label: string }> {
 42:   const innerW = w - pad.left - pad.right;
 43:   const innerH = h - pad.top - pad.bottom;
 44:   const minScore = 0;
 45:   const maxScore = 100;
 46: 
 47:   return points.map((pt, i) => ({
 48:     x: pad.left + (i / (points.length - 1)) * innerW,
 49:     y: pad.top + innerH - ((pt.score - minScore) / (maxScore - minScore)) * innerH,
 50:     score: pt.score,
 51:     label: pt.label,
 52:   }));
 53: }
 54: 
 55: export function ATSTrendChart({ data = DEFAULT_DATA, height = HEIGHT }: ATSTrendChartProps) {
 56:   const coords = toSvgCoords(data, WIDTH, height, PADDING);
 57:   const innerH = height - PADDING.top - PADDING.bottom;
 58:   const innerW = WIDTH - PADDING.left - PADDING.right;
 59: 
 60:   // Y-axis grid lines at 0, 50, 100
 61:   const gridLines = [0, 50, 100].map((v) => ({
 62:     y: PADDING.top + innerH - (v / 100) * innerH,
 63:     label: v,
 64:   }));
 65: 
 66:   return (
 67:     <div
 68:       style={{
 69:         backgroundColor: 'var(--sys-color-charcoalBackground-steps-2)',
 70:         borderColor: 'var(--kr-color-concrete-grey-steps-0)',
 71:         borderRadius: 'var(--sys-shape-placardTorn01)',
 72:       }}
 73:       className="p-6 border"
 74:     >
 75:       {/* Header */}
 76:       <div className="flex items-center justify-between mb-4">
 77:         <div>
 78:           <h3
 79:             style={{ color: 'var(--sys-color-paperWhite-base)' }}
 80:             className="font-display text-base font-bold uppercase tracking-tight"
 81:           >
 82:             ATS Score Trend
 83:           </h3>
 84:           <p
 85:             style={{ color: 'var(--sys-color-worker-ash-base)' }}
 86:             className="text-[10px] font-mono uppercase tracking-widest mt-0.5"
 87:           >
 88:             Last {data.length} applications
 89:           </p>
 90:         </div>
 91:         <div
 92:           style={{
 93:             color: 'var(--sys-color-solidarityRed-base)',
 94:             borderColor: 'var(--sys-color-solidarityRed-base)',
 95:             borderRadius: 'var(--sys-shape-blockRiot03)',
 96:           }}
 97:           className="px-3 py-1 border text-[9px] font-bold uppercase tracking-widest opacity-70"
 98:         >
 99:           Live Tracking
100:         </div>
101:       </div>
102: 
103:       {/* SVG Chart */}
104:       <svg
105:         viewBox={`0 0 ${WIDTH} ${height}`}
106:         width="100%"
107:         height={height}
108:         aria-label="ATS score trend chart"
109:         role="img"
110:       >
111:         {/* Grid lines */}
112:         {gridLines.map(({ y, label }) => (
113:           <g key={label}>
114:             <line
115:               x1={PADDING.left}
116:               y1={y}
117:               x2={WIDTH - PADDING.right}
118:               y2={y}
119:               stroke="var(--kr-color-concrete-grey-steps-0)"
120:               strokeOpacity={0.12}
121:               strokeWidth={1}
122:               strokeDasharray="4 4"
123:             />
124:             <text
125:               x={PADDING.left - 6}
126:               y={y + 4}
127:               textAnchor="end"
128:               fill="var(--sys-color-worker-ash-base)"
129:               fontSize={9}
130:               fontFamily="monospace"
131:               opacity={0.5}
132:             >
133:               {label}
134:             </text>
135:           </g>
136:         ))}
137: 
138:         {/* X-axis base line */}
139:         <line
140:           x1={PADDING.left}
141:           y1={PADDING.top + innerH}
142:           x2={WIDTH - PADDING.right}
143:           y2={PADDING.top + innerH}
144:           stroke="var(--kr-color-concrete-grey-steps-0)"
145:           strokeOpacity={0.2}
146:           strokeWidth={1}
147:         />
148: 
149:         {/* Segments — colored by direction */}
150:         {coords.slice(1).map((pt, i) => {
151:           const prev = coords[i];
152:           const isRising = pt.score >= prev.score;
153:           const strokeColor = isRising
154:             ? 'var(--sys-color-inkGold-base)'
155:             : 'var(--sys-color-solidarityRed-base)';
156:           return (
157:             <line
158:               key={i}
159:               x1={prev.x}
160:               y1={prev.y}
161:               x2={pt.x}
162:               y2={pt.y}
163:               stroke={strokeColor}
164:               strokeWidth={3}
165:               strokeLinecap="round"
166:             />
167:           );
168:         })}
169: 
170:         {/* Data point dots */}
171:         {coords.map((pt, i) => {
172:           const isLast = i === coords.length - 1;
173:           return (
174:             <g key={i}>
175:               <circle
176:                 cx={pt.x}
177:                 cy={pt.y}
178:                 r={isLast ? 6 : 4}
179:                 fill="var(--sys-color-charcoalBackground-steps-2)"
180:                 stroke={
181:                   isLast ? 'var(--sys-color-inkGold-base)' : 'var(--sys-color-worker-ash-base)'
182:                 }
183:                 strokeWidth={2}
184:               />
185:               {/* Score label above last point */}
186:               {isLast && (
187:                 <text
188:                   x={pt.x}
189:                   y={pt.y - 12}
190:                   textAnchor="middle"
191:                   fill="var(--sys-color-inkGold-base)"
192:                   fontSize={11}
