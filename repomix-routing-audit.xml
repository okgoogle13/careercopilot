<file path="frontend/src/features/analysis/components/ATSSignalBreakdown.tsx">
  1: /**
  2:  * ATS Signal Breakdown Component
  3:  *
  4:  * Displays the 4 sub-signals of the ATS analysis:
  5:  * - Keyword Density Score
  6:  * - Semantic Score
  7:  * - Education/Experience Score
  8:  * - Formatting Score
  9:  *
 10:  * Each signal is scaled to 0-100 for clarity and displayed using KR Solidarity v6.1
 11:  * semantic tokens.
 12:  */
 13: 
 14: import React from 'react';
 15: import { useAnalysisPipelineStore } from '@/stores/analysisPipelineStore';
 16: import { motion } from 'framer-motion';
 17: 
 18: interface ATSSignalBreakdownProps {
 19:   assetId: string;
 20: }
 21: 
 22: interface SignalDefinition {
 23:   key: keyof SignalBreakdown;
 24:   label: string;
 25:   description?: string;
 26: }
 27: 
 28: interface SignalBreakdown {
 29:   keywordDensityScore: number;
 30:   semanticScore: number;
 31:   educationExperienceScore: number;
 32:   formattingScore: number;
 33: }
 34: 
 35: /**
 36:  * Mapping of breakdown fields to display names and descriptions
 37:  */
 38: const SIGNAL_DEFINITIONS: SignalDefinition[] = [
 39:   {
 40:     key: 'keywordDensityScore',
 41:     label: 'Keyword Density',
 42:     description: 'How well your resume matches job keywords',
 43:   },
 44:   {
 45:     key: 'semanticScore',
 46:     label: 'Semantic Score',
 47:     description: 'Contextual relevance to the job',
 48:   },
 49:   {
 50:     key: 'educationExperienceScore',
 51:     label: 'Education & Experience',
 52:     description: 'Alignment of background with role',
 53:   },
 54:   {
 55:     key: 'formattingScore',
 56:     label: 'Formatting Score',
 57:     description: 'ATS parsing and readability',
 58:   },
 59: ];
 60: 
 61: /**
 62:  * Helper: Determine status color based on score threshold
 63:  */
 64: function getSignalStatus(score: number): 'excellent' | 'good' | 'acceptable' | 'poor' {
 65:   if (score >= 80) return 'excellent';
 66:   if (score >= 60) return 'good';
 67:   if (score >= 40) return 'acceptable';
 68:   return 'poor';
 69: }
 70: 
 71: /**
 72:  * Helper: Get semantic token color variable for a signal status
 73:  */
 74: function getStatusColor(status: 'excellent' | 'good' | 'acceptable' | 'poor'): string {
 75:   const colorMap = {
 76:     excellent: 'var(--kr-color-activist-smoke-green-base)',
 77:     good: 'var(--kr-color-ink-gold-base)',
 78:     acceptable: 'var(--kr-color-stencil-yellow-base)',
 79:     poor: 'var(--kr-color-solidarity-red-base)',
 80:   };
 81:   return colorMap[status];
 82: }
 83: 
 84: /**
 85:  * Individual signal card component
 86:  */
 87: function SignalCard({
 88:   signal,
 89:   score,
 90: }: {
 91:   signal: SignalDefinition;
 92:   score: number;
 93: }): React.ReactElement {
 94:   const status = getSignalStatus(score);
 95:   const statusColor = getStatusColor(status);
 96: 
 97:   return (
 98:     <motion.div
 99:       initial={{ opacity: 0, y: 8 }}
100:       animate={{ opacity: 1, y: 0 }}
101:       transition={{ duration: 0.3 }}
102:       style={{
103:         backgroundColor: 'var(--kr-color-charcoal-background-steps-1)',
104:         borderRadius: 'var(--kr-archetypes-placard-shape-base)',
105:         borderColor: 'var(--kr-color-concrete-grey-usage)',
106:         borderWidth: '1px',
107:         borderStyle: 'solid',
108:         boxShadow: 'var(--kr-shadow-elevation2-placard)',
109:       }}
110:       className="relative overflow-hidden transition-all duration-medium1 ease-m3-expressive backdrop-blur-xl p-6 flex flex-col justify-between h-full"
111:       data-archetype="placard"
112:     >
113:       <div className="mb-4">
114:         <h3
115:           className="text-sm font-semibold uppercase tracking-wider mb-1"
116:           style={{ color: 'var(--kr-color-worker-ash-base)' }}
117:         >
118:           {signal.label}
119:         </h3>
120:         {signal.description && (
121:           <p
122:             className="text-xs leading-relaxed"
123:             style={{ color: 'var(--kr-color-worker-ash-steps-1)' }}
124:           >
125:             {signal.description}
126:           </p>
127:         )}
128:       </div>
129: 
130:       <div className="flex flex-col items-center gap-2">
131:         <div
132:           className="text-4xl font-bold tabular-nums"
133:           style={{ color: statusColor }}
134:         >
135:           {score}
136:         </div>
137:         <div
138:           className="text-xs uppercase tracking-wider"
139:           style={{ color: statusColor }}
140:         >
141:           {status}
142:         </div>
143:       </div>
144: 
145:       {/* Progress bar visualization */}
146:       <div className="mt-4 w-full bg-charcoal-background-steps-0 rounded-full overflow-hidden">
147:         <motion.div
148:           className="h-2 rounded-full"
149:           style={{ backgroundColor: statusColor }}
150:           initial={{ width: 0 }}
151:           animate={{ width: `${score}%` }}
152:           transition={{ duration: 0.6, ease: 'easeOut' }}
153:         />
154:       </div>
155:     </motion.div>
156:   );
157: }
158: 
159: /**
160:  * Main component: Renders the 4 ATS signals
161:  */
162: export const ATSSignalBreakdown: React.FC<ATSSignalBreakdownProps> = ({ assetId }) => {
163:   const { getPipeline } = useAnalysisPipelineStore();
164:   const pipeline = getPipeline(assetId);
165:   const atsResult = pipeline?.atsResult;
166: 
167:   // If no breakdown data, show empty state
168:   if (!atsResult?.breakdown) {
169:     return (
170:       <div className="w-full">
171:         <div
172:           style={{
173:             backgroundColor: 'var(--kr-color-charcoal-background-steps-1)',
174:             borderRadius: 'var(--kr-archetypes-placard-shape-base)',
175:             borderColor: 'var(--kr-color-concrete-grey-usage)',
176:             borderWidth: '1px',
177:             borderStyle: 'solid',
178:           }}
179:           className="p-6"
180:           data-archetype="placard"
181:         >
182:           <div
183:             className="text-center py-8"
184:             style={{ color: 'var(--kr-color-worker-ash-base)' }}
185:           >
186:             <p className="text-sm">
187:               No ATS analysis available. Run an analysis to see signal breakdown.
188:             </p>
189:           </div>
190:         </div>
191:       </div>
192:     );
193:   }
194: 
195:   const breakdown = atsResult.breakdown as SignalBreakdown;
196: 
197:   return (
198:     <div className="w-full space-y-6">
199:       {/* Header */}
200:       <div className="mb-6">
201:         <h2
202:           className="text-xl font-bold mb-2"
203:           style={{ color: 'var(--kr-color-paper-white-base)' }}
204:         >
205:           ATS Signal Breakdown
206:         </h2>
207:         <p
208:           className="text-sm"
209:           style={{ color: 'var(--kr-color-worker-ash-base)' }}
210:         >
211:           Detailed analysis of your resume's performance across key ATS criteria
212:         </p>
213:       </div>
214: 
215:       {/* Signals Grid */}
216:       <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
217:         {SIGNAL_DEFINITIONS.map((signal) => (
218:           <SignalCard
219:             key={signal.key}
220:             signal={signal}
221:             score={breakdown[signal.key]}
222:           />
223:         ))}
224:       </div>
225:     </div>
226:   );
227: };
228: 
229: ATSSignalBreakdown.displayName = 'ATSSignalBreakdown';
</file>

<file path="frontend/src/features/analysis/components/EvidenceUploader.tsx">
 1: import { March, Placard, Strike } from '@/components/ui';
 2: import { m3Toast } from '@/utils/toast';
 3: import { uploadAndTagFile, type IngestionSourceType } from '@/api/ingestion.service';
 4: import { validateFile } from '@/utils/fileValidation';
 5: import { FileText, UploadCloud } from 'lucide-react';
 6: import React, { useState } from 'react';
 7: 
 8: type SourceType = IngestionSourceType;
 9: 
10: export const EvidenceUploader: React.FC = () => {
11:   const [isUploading, setIsUploading] = useState(false);
12:   const [selectedType, setSelectedType] = useState<SourceType>('ksc_response');
13: 
14:   const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
15:     const file = e.target.files?.[0];
16:     if (!file) return;
17: 
18:     const validation = validateFile(file, ['.pdf', '.docx', '.txt']);
19:     if (!validation.valid) {
20:       m3Toast.error('Invalid File', validation.error!);
21:       e.target.value = '';
22:       return;
23:     }
24: 
25:     setIsUploading(true);
26: 
27:     try {
28:       await uploadAndTagFile(file, () => {}, selectedType);
29:       m3Toast.success('Success', `Ingested ${file.name}`);
30:     } catch (error) {
31:       console.error(error);
32:       m3Toast.error('Upload Failed', error instanceof Error ? error.message : 'Upload failed');
33:     } finally {
34:       setIsUploading(false);
35:       e.target.value = '';
36:     }
37:   };
38: 
39:   const documentOptions: { value: SourceType; label: string }[] = [
40:     { value: 'ksc_response', label: 'KSC Response' },
41:     { value: 'cover_letter', label: 'Cover Letter' },
42:     { value: 'resume', label: 'Past Resume' },
43:   ];
44: 
45:   return (
46:     <Placard className="p-0 border-2 border-dashed border-[var(--sys-color-concreteGrey-base)]/30 bg-transparent overflow-hidden">
47:       <div className="p-6 flex items-center gap-4">
48:         <div className="w-12 h-12 rounded-march bg-[var(--sys-color-inkGold-base)]/10 flex items-center justify-center">
49:           <UploadCloud className="w-6 h-6 text-[var(--sys-color-inkGold-base)]" />
50:         </div>
51:         <div className="flex-grow">
52:           <h3 className="font-display text-lg font-bold text-[var(--sys-color-paperWhite-base)]">
53:             Strategic Evidence Uploader
54:           </h3>
55:           <p className="font-primary text-sm text-[var(--sys-color-concreteGrey-steps-3)]">
56:             Upload historical artifacts to enrich your professional vector.
57:           </p>
58:         </div>
59:       </div>
60: 
61:       <div className="px-6 pb-6 flex gap-4 items-center flex-wrap">
62:         <div className="min-w-[220px]">
63:           <March
64:             options={documentOptions}
65:             value={selectedType}
66:             onChange={(val: string) => setSelectedType(val as SourceType)}
67:             label="Knowledge Domain"
68:           />
69:         </div>
70: 
71:         <input
72:           type="file"
73:           id="file-upload"
74:           className="hidden"
75:           accept=".pdf,.docx,.txt"
76:           onChange={handleFileUpload}
77:           disabled={isUploading}
78:         />
79: 
80:         <label htmlFor="file-upload">
81:           <Strike
82:             variant="secondary"
83:             onClick={() => {}} // Controlled by label/input
84:             disabled={isUploading}
85:             isLoading={isUploading}
86:             iconLeft={<FileText className="w-5 h-5" />}
87:             className="h-[56px] px-8"
88:           >
89:             {isUploading ? 'Synthesizing...' : 'Seed Intelligence'}
90:           </Strike>
91:         </label>
92:       </div>
93:     </Placard>
94:   );
95: };
