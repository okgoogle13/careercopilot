<file path="frontend/src/features/documents/services/docxExport.ts">
  1: import { saveAs } from 'file-saver';
  2: import { Document, HeadingLevel, Packer, Paragraph, TextRun } from 'docx';
  3: 
  4: export type ExportableDocument =
  5:   | {
  6:       type: 'resume';
  7:       fileName: string;
  8:       title: string;
  9:       summary?: string;
 10:       skills?: string[];
 11:       experience?: Array<{
 12:         title: string;
 13:         company?: string;
 14:         duration?: string;
 15:         bullets?: string[];
 16:       }>;
 17:       education?: Array<{
 18:         degree: string;
 19:         school?: string;
 20:         year?: string;
 21:       }>;
 22:     }
 23:   | {
 24:       type: 'cover-letter';
 25:       fileName: string;
 26:       heading?: string;
 27:       content: string;
 28:     }
 29:   | {
 30:       type: 'ksc';
 31:       fileName: string;
 32:       criterion?: string;
 33:       content: string;
 34:     };
 35: 
 36: const asParagraphs = (content: string): Paragraph[] =>
 37:   content
 38:     .split(/\n{2,}/)
 39:     .map((paragraph) => paragraph.trim())
 40:     .filter(Boolean)
 41:     .map(
 42:       (text) =>
 43:         new Paragraph({
 44:           children: [new TextRun(text)],
 45:         })
 46:     );
 47: 
 48: const buildResumeParagraphs = (document: Extract<ExportableDocument, { type: 'resume' }>) => {
 49:   const paragraphs: Paragraph[] = [
 50:     new Paragraph({
 51:       heading: HeadingLevel.TITLE,
 52:       children: [new TextRun(document.title)],
 53:     }),
 54:   ];
 55: 
 56:   if (document.summary?.trim()) {
 57:     paragraphs.push(
 58:       new Paragraph({
 59:         heading: HeadingLevel.HEADING_1,
 60:         children: [new TextRun('Professional Summary')],
 61:       }),
 62:       ...asParagraphs(document.summary)
 63:     );
 64:   }
 65: 
 66:   if (document.skills?.length) {
 67:     paragraphs.push(
 68:       new Paragraph({
 69:         heading: HeadingLevel.HEADING_1,
 70:         children: [new TextRun('Skills')],
 71:       }),
 72:       new Paragraph({
 73:         children: [new TextRun(document.skills.join(', '))],
 74:       })
 75:     );
 76:   }
 77: 
 78:   if (document.experience?.length) {
 79:     paragraphs.push(
 80:       new Paragraph({
 81:         heading: HeadingLevel.HEADING_1,
 82:         children: [new TextRun('Experience')],
 83:       })
 84:     );
 85: 
 86:     document.experience.forEach((entry) => {
 87:       const headingBits = [entry.title, entry.company, entry.duration].filter(Boolean).join(' | ');
 88:       paragraphs.push(
 89:         new Paragraph({
 90:           heading: HeadingLevel.HEADING_2,
 91:           children: [new TextRun(headingBits)],
 92:         })
 93:       );
 94: 
 95:       entry.bullets?.filter(Boolean).forEach((bullet) => {
 96:         paragraphs.push(
 97:           new Paragraph({
 98:             bullet: { level: 0 },
 99:             children: [new TextRun(bullet)],
100:           })
101:         );
102:       });
103:     });
104:   }
105: 
106:   if (document.education?.length) {
107:     paragraphs.push(
108:       new Paragraph({
109:         heading: HeadingLevel.HEADING_1,
110:         children: [new TextRun('Education')],
111:       })
112:     );
113: 
114:     document.education.forEach((entry) => {
115:       paragraphs.push(
116:         new Paragraph({
117:           children: [
118:             new TextRun([entry.degree, entry.school, entry.year].filter(Boolean).join(' | ')),
119:           ],
120:         })
121:       );
122:     });
123:   }
124: 
125:   return paragraphs;
126: };
127: 
128: const ensureContent = (document: ExportableDocument) => {
129:   if (document.type === 'resume') {
130:     const hasResumeContent =
131:       document.summary?.trim() ||
132:       document.skills?.length ||
133:       document.experience?.length ||
134:       document.education?.length;
135: 
136:     if (!hasResumeContent) {
137:       throw new Error('Cannot export an empty document');
138:     }
139: 
140:     return;
141:   }
142: 
143:   if (!document.content.trim()) {
144:     throw new Error('Cannot export an empty document');
145:   }
146: };
147: 
148: export async function exportDocumentAsDocx(document: ExportableDocument): Promise<void> {
149:   ensureContent(document);
150: 
151:   const paragraphs =
152:     document.type === 'resume'
153:       ? buildResumeParagraphs(document)
154:       : [
155:           new Paragraph({
156:             heading: HeadingLevel.TITLE,
157:             children: [
158:               new TextRun(
159:                 document.type === 'cover-letter'
160:                   ? document.heading || 'Cover Letter'
161:                   : document.criterion || 'KSC Response'
162:               ),
163:             ],
164:           }),
165:           ...asParagraphs(document.content),
166:         ];
167: 
168:   const doc = new Document({
169:     sections: [
170:       {
171:         children: paragraphs,
172:       },
173:     ],
174:     creator: 'CareerCopilot',
175:     title:
176:       document.type === 'resume'
177:         ? document.title
178:         : document.type === 'cover-letter'
179:           ? document.heading || 'Cover Letter'
180:           : document.criterion || 'KSC Response',
181:   });
182: 
183:   const blob = await Packer.toBlob(doc);
184:   saveAs(blob, document.fileName);
185: }
</file>

