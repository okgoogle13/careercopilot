 24:     if (value >= 60) return 'text-[var(--sys-color-stencilYellow-base)]';
 25:     return 'text-[var(--sys-color-solidarityRed-base)]';
 26:   };
 27: 
 28:   const getScoreBg = (value: number) => {
 29:     if (documentType === 'coverLetter') {
 30:       if (value >= 90) return 'var(--sys-color-kr-activistSmokeGreen-base)';
