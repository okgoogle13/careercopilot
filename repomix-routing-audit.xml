 22: const atmosphericOverlay =
 23:   '/assets/kr-solidarity/abstract/kr-solidarity__atmospheric__texture--solidarity-chatgpt-image-f--v1.png';
 24: const wallpaper =
 25:   '/assets/kr-solidarity/texture/kr-solidarity__substrate__landmark--melbourne-laneway--v1.png';
 26: 
 27: export function ApplicationTracker() {
 28:   const queryClient = useQueryClient();
 29:   const [selectedApplicationId, setSelectedApplicationId] = useState<string | null>(null);
 30:   const [heroData, setHeroData] = useState<{
 31:     layers: any[];
 32:     typography: any;
 33:     animation: any;
 34:     safeZones?: any;
 35:     renderHints?: any;
 36:   } | null>(null);
 37: 
 38:   useEffect(() => {
 39:     async function loadHero() {
 40:       try {
 41:         const [manifest, registry] = await Promise.all([
 42:           fetch('/assets/kr-solidarity-manifest.json').then((r) => r.json()),
 43:           loadHeroRegistry(),
 44:         ]);
 45: 
 46:         const result = composeHero(
 47:           manifest as SolidarityManifest,
 48:           registry,
 49:           resolvePageHeroComposition('applications-board')
 50:         );
 51: 
 52:         if (result.valid) {
 53:           setHeroData({
 54:             layers: result.resolvedLayers,
 55:             typography: result.typography,
 56:             animation: result.animation ?? result.motion,
 57:             safeZones: result.safeZones,
 58:             renderHints: result.renderHints,
 59:           });
 60:         }
 61:       } catch (error) {
 62:         console.error('Failed to load tracker hero:', error);
 63:       }
 64:     }
 65: 
 66:     void loadHero();
 67:   }, []);
 68: 
 69:   const {
 70:     data: applications = [],
 71:     isLoading,
 72:     error,
 73:   } = useQuery({
 74:     queryKey: ['tracker-applications'],
 75:     queryFn: async () => applicationService.listApplications(),
 76:     retry: false,
 77:   });
 78: 
 79:   const trackerApplications = useMemo(() => applications.map(toTrackerApplication), [applications]);
 80: 
 81:   const moveApplication = useMutation({
