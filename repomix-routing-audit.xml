<file path="frontend/src/features/profile/components/VoiceProfileCreationPanel.tsx">
  1: /**
  2:  * Voice Profile Creation Panel
  3:  *
  4:  * Entry point component that combines the submission form and status display.
  5:  * Manages voice profile state and API integration.
  6:  */
  7: 
  8: import { useState, useCallback, useEffect } from 'react';
  9: import { useQuery } from '@tanstack/react-query';
 10: import { VoiceSampleSubmissionForm } from './VoiceSampleSubmissionForm';
 11: import { VoiceProfileStatusCard } from './VoiceProfileStatusCard';
 12: import { createVoiceProfile, getVoiceProfile } from '@/api/voiceProfileService';
 13: 
 14: export interface VoiceProfileCreationPanelProps {
 15:   onSuccess?: () => void;
 16:   onError?: (error: Error) => void;
 17: }
 18: 
 19: /**
 20:  * Main panel for voice profile creation and display.
 21:  * Integrates form submission with status display and error handling.
 22:  *
 23:  * Backend confirms creation but does not return profile attributes.
 24:  * `profileSaved` tracks local confirmation so the status card can
 25:  * exit the empty state and the form can collapse after a successful submit.
 26:  */
 27: export function VoiceProfileCreationPanel({ onSuccess, onError }: VoiceProfileCreationPanelProps) {
 28:   const [profileSaved, setProfileSaved] = useState(false);
 29:   const [savedAt, setSavedAt] = useState<string | undefined>();
 30:   const [loading, setLoading] = useState(false);
 31:   const [error, setError] = useState<string | null>(null);
 32: 
 33:   const { data: existingProfile, isLoading: isLoadingProfile } = useQuery({
 34:     queryKey: ['voiceProfile'],
 35:     queryFn: getVoiceProfile,
 36:   });
 37: 
 38:   useEffect(() => {
 39:     if (existingProfile) {
 40:       setProfileSaved(true);
 41:       if (existingProfile.savedAt) {
 42:         setSavedAt(existingProfile.savedAt);
 43:       }
 44:     }
 45:   }, [existingProfile]);
 46: 
 47:   const handleSubmit = useCallback(
 48:     async (sample: string) => {
 49:       setLoading(true);
 50:       setError(null);
 51: 
 52:       try {
 53:         await createVoiceProfile([sample]);
 54: 
 55:         setProfileSaved(true);
 56:         setSavedAt(new Date().toISOString());
 57: 
 58:         if (onSuccess) {
 59:           onSuccess();
 60:         }
 61:       } catch (err) {
 62:         const errorMessage = err instanceof Error ? err.message : 'Failed to create voice profile';
 63:         setError(errorMessage);
 64: 
 65:         if (onError) {
 66:           onError(err instanceof Error ? err : new Error(errorMessage));
 67:         }
 68:       } finally {
 69:         setLoading(false);
 70:       }
 71:     },
 72:     [onSuccess, onError]
 73:   );
 74: 
 75:   return (
 76:     <div className="space-y-6">
 77:       {/* Status Card */}
 78:       <VoiceProfileStatusCard
 79:         profileSaved={profileSaved}
 80:         savedAt={savedAt}
 81:         loading={loading || isLoadingProfile}
 82:       />
 83: 
 84:       {/* Submission Form — hidden once a profile is confirmed saved */}
 85:       {!profileSaved && (
 86:         <VoiceSampleSubmissionForm
 87:           onSubmit={handleSubmit}
 88:           loading={loading}
 89:           error={error}
 90:         />
 91:       )}
 92: 
 93:       {/* Update affordance — allows re-submission after a profile exists */}
 94:       {profileSaved && !loading && (
 95:         <button
 96:           type="button"
 97:           onClick={() => {
 98:             setProfileSaved(false);
 99:             setSavedAt(undefined);
100:             setError(null);
101:           }}
102:           style={{
103:             color: 'var(--sys-color-concreteGrey-base)',
104:             borderColor: 'var(--sys-color-concreteGrey-base)',
105:             borderRadius: 'var(--sys-shape-blockRiot03)',
106:           }}
107:           className="w-full px-6 py-3 border font-display font-bold text-xs uppercase tracking-wide opacity-60 hover:opacity-90 transition-opacity"
108:         >
109:           Update Writing Sample
110:         </button>
111:       )}
112:     </div>
113:   );
114: }
</file>

