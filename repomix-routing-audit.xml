 31: const getScoreColor = (score: number): string => {
 32:   if (score >= 85) return 'var(--sys-color-primary)';
 33:   if (score >= 70) return 'var(--sys-color-tertiary)';
 34:   return 'var(--sys-color-error)';
 35: };
