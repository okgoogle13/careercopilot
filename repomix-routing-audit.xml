  1: import { useState, useCallback } from 'react';
  2: import { motion, AnimatePresence } from 'framer-motion';
  3: import { Upload, FileText, CheckCircle2, AlertCircle, Loader2 } from 'lucide-react';
  4: import { cn } from '@/lib/utils';
  5: import { Button } from '@careercopilot/ui'; // Assuming shadcn button exists
  6: import { validateFile } from '@/utils/fileValidation';
  7: 
  8: import { useAuth } from '@/context/AuthContext';
  9: 
 10: interface ResumeUploaderProps {
 11:   onUploadSuccess?: (data: any) => void;
 12: }
 13: 
 14: export default function ResumeUploader({ onUploadSuccess }: ResumeUploaderProps) {
 15:   const { session } = useAuth();
 16:   const [isDragging, setIsDragging] = useState(false);
 17:   const [status, setStatus] = useState<'idle' | 'uploading' | 'success' | 'error'>('idle');
 18:   const [errorMessage, setErrorMessage] = useState('');
 19: 
 20:   const handleDragOver = useCallback((e: React.DragEvent) => {
 21:     e.preventDefault();
 22:     setIsDragging(true);
 23:   }, []);
 24: 
 25:   const handleDragLeave = useCallback((e: React.DragEvent) => {
 26:     e.preventDefault();
 27:     setIsDragging(false);
 28:   }, []);
 29: 
 30:   const handleDrop = useCallback(async (e: React.DragEvent) => {
 31:     e.preventDefault();
 32:     setIsDragging(false);
 33: 
 34:     const files = Array.from(e.dataTransfer.files);
 35:     if (files.length === 0) return;
 36: 
 37:     await processUpload(files[0]);
 38:   }, []);
 39: 
 40:   const handleFileSelect = useCallback(async (e: React.ChangeEvent<HTMLInputElement>) => {
 41:     if (e.target.files && e.target.files.length > 0) {
 42:       await processUpload(e.target.files[0]);
 43:     }
 44:   }, []);
 45: 
 46:   const processUpload = async (file: File) => {
 47:     const validation = validateFile(file, ['.pdf', '.txt']);
 48:     if (!validation.valid) {
 49:       setStatus('error');
 50:       setErrorMessage(validation.error!);
 51:       return;
 52:     }
 53: 
 54:     setStatus('uploading');
 55:     setErrorMessage('');
 56: 
 57:     try {
 58:       const formData = new FormData();
 59:       formData.append('files', file);
 60: 
 61:       const token = session?.access_token || null;
 62:       const headers: Record<string, string> = {};
 63:       if (token) {
 64:         headers['Authorization'] = `Bearer ${token}`;
 65:       }
 66: 
 67:       const response = await fetch('/api/v1/ingest', {
 68:         method: 'POST',
 69:         body: formData,
 70:         headers: headers,
 71:       });
 72: 
 73:       if (!response.ok) {
 74:         const errorText = await response.text();
 75:         throw new Error(`Upload failed: ${errorText}`);
 76:       }
 77: 
 78:       const data = await response.json();
 79:       setStatus('success');
 80: 
 81:       if (onUploadSuccess) {
 82:         onUploadSuccess(data);
 83:       }
 84:     } catch (err) {
 85:       console.error(err);
 86:       setStatus('error');
 87:       setErrorMessage(err instanceof Error ? err.message : 'Unknown error');
 88:     }
 89:   };
 90: 
 91:   return (
 92:     <div className="w-full max-w-2xl mx-auto p-6">
 93:       <div className="mb-6 text-center">
 94:         <h2 className="text-display-small font-bold text-on-surface mb-2">Upload Your Resume</h2>
 95:         <p className="text-body-large text-on-surface-variant">
 96:           Drop your PDF here to build your Career DNA profile
 97:         </p>
 98:       </div>
 99: 
100:       <motion.div
101:         className={cn(
102:           'relative border-2 border-dashed rounded-tech min-h-[300px] flex flex-col items-center justify-center p-8 transition-colors cursor-pointer overflow-hidden',
103:           isDragging
104:             ? 'border-primary bg-primary-container/20'
105:             : 'border-[var(--kr-color-concrete-grey-steps-0)] bg-surface-container'
106:         )}
107:         onDragOver={handleDragOver}
108:         onDragLeave={handleDragLeave}
109:         onDrop={handleDrop}
110:         onClick={() => document.getElementById('resume-input')?.click()}
111:         whileHover={{ scale: 1.01 }}
112:         whileTap={{ scale: 0.99 }}
113:       >
114:         <input
115:           id="resume-input"
116:           type="file"
117:           accept=".pdf,.txt"
118:           className="hidden"
119:           onChange={handleFileSelect}
120:         />
121: 
122:         <AnimatePresence>
123:           {status === 'idle' && (
124:             <motion.div
125:               key="idle"
126:               initial={{ opacity: 0, y: 10 }}
127:               animate={{ opacity: 1, y: 0 }}
128:               exit={{ opacity: 0, y: -10 }}
129:               className="flex flex-col items-center"
130:             >
131:               <div className="w-20 h-20 rounded-march bg-surface-container-high flex items-center justify-center mb-4 shadow-sm">
132:                 <Upload className="w-8 h-8 text-primary" />
133:               </div>
134:               <p className="text-title-medium font-bold text-on-surface mb-1">
135:                 Drag & Drop or Click to Upload
136:               </p>
137:               <p className="text-label-large text-tertiary">PDF or TXT up to 10MB</p>
138:             </motion.div>
139:           )}
140: 
141:           {status === 'uploading' && (
142:             <motion.div
143:               key="uploading"
144:               initial={{ opacity: 0, scale: 0.8 }}
145:               animate={{ opacity: 1, scale: 1 }}
146:               exit={{ opacity: 0, scale: 0.8 }}
147:               className="flex flex-col items-center"
148:             >
149:               <Loader2 className="w-16 h-16 text-primary animate-spin mb-4" />
150:               <p className="text-title-medium font-bold text-primary animate-pulse">
151:                 Analyzing Career DNA...
152:               </p>
153:               <p className="text-body-medium text-on-surface-variant mt-2">
154:                 Extracting skills, timeline, and achievements
155:               </p>
156:             </motion.div>
157:           )}
158: 
159:           {status === 'success' && (
160:             <motion.div
161:               key="success"
162:               initial={{ opacity: 0, scale: 0.8 }}
163:               animate={{ opacity: 1, scale: 1 }}
164:               className="flex flex-col items-center"
165:             >
166:               <div className="w-20 h-20 rounded-march bg-[var(--kr-color-charcoal-background-steps-2)] flex items-center justify-center mb-4">
167:                 <CheckCircle2 className="w-10 h-10 text-[var(--kr-color-ink-gold-base)]" />
168:               </div>
169:               <p className="text-title-medium font-bold text-[var(--kr-color-ink-gold-base)]">
170:                 Analysis Complete!
171:               </p>
172:               <Button
173:                 className="mt-6"
174:                 variant="outlined"
175:                 onClick={(e) => {
176:                   e.stopPropagation();
