 48:         borderStyle: 'solid',
 49:         padding: '1.5rem',
 50:       }}
 51:     >
 52:       <div className="flex items-center justify-between mb-4">
 53:         <h3 className="text-lg font-bold text-[var(--sys-color-paperWhite-base)]">
