<file path="frontend/src/features/dashboard/OnboardingChecklist.tsx">
  1: import { motion } from 'framer-motion';
  2: import { CheckCircle2, Circle, X } from 'lucide-react';
  3: import { useEffect, useState } from 'react';
  4: import { useNavigate } from 'react-router-dom';
  5: import { Placard } from '@/components/ui';
  6: import { useUserStore } from '@/stores/userStore';
  7: import { KrDarkSpring } from '@/design/tokens/motion-presets';
  8: 
  9: const STORAGE_KEY = 'cc_onboarding_checklist';
 10: /** Single key that stores both progress and dismissed flag. */
 11: export const CHECKLIST_DISMISSED_KEY = 'cc_onboarding_checklist_dismissed';
 12: const MILESTONE_PREFIX = 'cc_milestone_';
 13: 
 14: interface ChecklistItem {
 15:   id: string;
 16:   label: string;
 17:   description: string;
 18:   route: string;
 19:   ctaLabel: string;
 20: }
 21: 
 22: const CHECKLIST_ITEMS: ChecklistItem[] = [
 23:   {
 24:     id: 'upload_resume',
 25:     label: 'Upload your resume',
 26:     description: 'AI extracts and organises your career history automatically.',
 27:     route: '/profile',
 28:     ctaLabel: 'Upload now →',
 29:   },
 30:   {
 31:     id: 'run_ats',
 32:     label: 'Run your first ATS score',
 33:     description: 'Paste any job ad to see how well your resume matches in seconds.',
 34:     route: '/analysis',
 35:     ctaLabel: 'Score resume →',
 36:   },
 37:   {
 38:     id: 'generate_cover_letter',
 39:     label: 'Generate a tailored cover letter',
 40:     description: 'Produce a personalised cover letter from any job URL in under a minute.',
 41:     route: '/generation',
 42:     ctaLabel: 'Write letter →',
 43:   },
 44:   {
 45:     id: 'create_ksc',
 46:     label: 'Create your first KSC response',
 47:     description: 'Nail Key Selection Criteria with guided STAR-method prompts.',
 48:     route: '/generation',
 49:     ctaLabel: 'Write KSC →',
 50:   },
 51: ];
 52: 
 53: function loadProgress(): Record<string, boolean> {
 54:   try {
 55:     const raw = localStorage.getItem(STORAGE_KEY);
 56:     if (!raw) return {};
 57:     const parsed: unknown = JSON.parse(raw);
 58:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) return {};
 59:     // Keep only boolean values to match Record<string, boolean>
 60:     return Object.fromEntries(
 61:       Object.entries(parsed).filter(([, v]) => typeof v === 'boolean')
 62:     ) as Record<string, boolean>;
 63:   } catch {
 64:     return {};
 65:   }
 66: }
 67: 
 68: function saveProgress(progress: Record<string, boolean>) {
 69:   try {
 70:     localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
 71:   } catch {
 72:     // silently ignore storage errors
 73:   }
 74: }
 75: 
 76: interface OnboardingChecklistProps {
 77:   /** Called when the user manually dismisses the checklist. */
 78:   onDismiss?: () => void;
 79: }
 80: 
 81: /**
 82:  * OnboardingChecklist — activation checklist shown on the Dashboard for new users.
 83:  *
 84:  * Tracks completion in localStorage. Hides automatically once all items are done,
 85:  * or when the user explicitly dismisses it.
 86:  *
 87:  * H3 recommendation from docs/analysis/user-journey-analysis.md
 88:  */
 89: export function OnboardingChecklist({ onDismiss }: OnboardingChecklistProps) {
 90:   const [progress, setProgress] = useState<Record<string, boolean>>(loadProgress);
 91:   const [dismissed, setDismissed] = useState(false);
 92:   const { hasCompletedIngestion, hasMaster } = useUserStore();
 93:   const navigate = useNavigate();
 94: 
 95:   const completedCount = CHECKLIST_ITEMS.filter((item) => progress[item.id]).length;
 96:   const allComplete = completedCount === CHECKLIST_ITEMS.length;
 97: 
 98:   useEffect(() => {
 99:     saveProgress(progress);
100:   }, [progress]);
101: 
102:   useEffect(() => {
103:     const nextProgress: Record<string, boolean> = {
104:       ...progress,
105:       upload_resume: hasCompletedIngestion || hasMaster || progress.upload_resume,
106:     };
107: 
108:     for (const id of ['run_ats', 'generate_cover_letter', 'create_ksc']) {
109:       if (!nextProgress[id] && localStorage.getItem(`${MILESTONE_PREFIX}${id}`) === 'true') {
110:         nextProgress[id] = true;
111:       }
112:     }
113: 
114:     const changed = Object.keys(nextProgress).some((key) => nextProgress[key] !== progress[key]);
115:     if (changed) {
116:       setProgress(nextProgress);
117:     }
118:   }, [hasCompletedIngestion, hasMaster, progress]);
119: 
120:   const markComplete = (id: string) => {
121:     setProgress((prev) => ({ ...prev, [id]: true }));
122:   };
123: 
124:   const handleCta = (item: ChecklistItem) => {
125:     markComplete(item.id);
126:     navigate(item.route);
127:   };
128: 
129:   const handleDismiss = () => {
130:     setDismissed(true);
131:     onDismiss?.();
132:   };
133: 
134:   if (dismissed) return null;
135: 
136:   const itemVariants = {
137:     hidden: { opacity: 0, x: -10 },
138:     show: (i: number) => ({
139:       opacity: 1,
140:       x: 0,
141:       transition: { delay: i * 0.08, type: 'spring' as const, stiffness: 300, damping: 30 },
142:     }),
143:   };
144: 
145:   return (
146:     <motion.div
147:       initial={{ opacity: 0, y: 20 }}
148:       animate={{ opacity: 1, y: 0 }}
149:       exit={{ opacity: 0, y: -10 }}
150:       transition={KrDarkSpring}
151:     >
152:       <Placard
153:         elevation="raised"
154:         className="p-8 md:p-10 border-ink-gold/20 bg-asphalt-black/40 relative overflow-hidden"
155:       >
156:         {/* Subtle gold glow */}
157:         <div className="absolute inset-0 bg-gradient-to-br from-ink-gold/5 via-transparent to-transparent pointer-events-none" />
158: 
159:         <div className="relative z-10">
160:           {/* Header */}
161:           <div className="flex items-start justify-between mb-6 gap-4">
162:             <div>
163:               <p className="font-annotation text-[10px] text-ink-gold uppercase tracking-[0.4em] opacity-70 mb-1">
164:                 [ ACTIVATION.PROTOCOL ]
165:               </p>
166:               <h2 className="font-display text-2xl font-black text-paper-white uppercase tracking-tight">
167:                 Get started
168:               </h2>
169:               <p className="font-primary text-sm text-concrete-grey opacity-70 mt-1">
170:                 {allComplete
171:                   ? "All done — you're fully set up! 🎉"
172:                   : `${completedCount} of ${CHECKLIST_ITEMS.length} complete`}
173:               </p>
174:             </div>
175:             <button
176:               onClick={handleDismiss}
177:               className="text-concrete-grey/40 hover:text-concrete-grey transition-colors p-1 flex-shrink-0"
178:               aria-label="Dismiss getting started checklist"
179:             >
180:               <X className="w-5 h-5" />
181:             </button>
182:           </div>
183: 
184:           {/* Progress bar */}
185:           <div className="h-1 w-full bg-white/5 rounded-march overflow-hidden mb-8">
186:             <motion.div
187:               initial={{ width: 0 }}
188:               animate={{ width: `${(completedCount / CHECKLIST_ITEMS.length) * 100}%` }}
189:               transition={{ duration: 0.6, ease: 'circOut' }}
190:               className="h-full bg-ink-gold"
191:             />
192:           </div>
193: 
194:           {/* Checklist items */}
195:           <ul className="space-y-4">
196:             {CHECKLIST_ITEMS.map((item, idx) => {
197:               const done = Boolean(progress[item.id]);
198:               return (
199:                 <motion.li
200:                   key={item.id}
201:                   custom={idx}
202:                   variants={itemVariants}
203:                   initial="hidden"
204:                   animate="show"
205:                   className={`flex items-start gap-4 p-4 rounded-[8px] border transition-all duration-300 ${
206:                     done
207:                       ? 'border-ink-gold/10 bg-ink-gold/5 opacity-60'
208:                       : 'border-concrete-grey/10 bg-transparent hover:border-ink-gold/20 hover:bg-ink-gold/5'
209:                   }`}
210:                 >
211:                   {/* Icon */}
212:                   <div className="flex-shrink-0 mt-0.5">
213:                     {done ? (
214:                       <CheckCircle2 className="w-5 h-5 text-ink-gold" />
215:                     ) : (
216:                       <Circle className="w-5 h-5 text-concrete-grey/30" />
217:                     )}
218:                   </div>
219: 
220:                   {/* Content */}
221:                   <div className="flex-1 min-w-0">
222:                     <p
223:                       className={`font-primary text-sm font-semibold ${done ? 'text-concrete-grey line-through' : 'text-paper-white'}`}
224:                     >
225:                       {item.label}
226:                     </p>
227:                     {!done && (
228:                       <p className="font-primary text-xs text-concrete-grey/60 mt-0.5">
229:                         {item.description}
230:                       </p>
231:                     )}
232:                   </div>
233: 
234:                   {/* CTA */}
235:                   {!done && (
236:                     <button
237:                       onClick={() => handleCta(item)}
238:                       className="flex-shrink-0 font-annotation text-[10px] text-ink-gold uppercase tracking-widest hover:text-paper-white transition-colors whitespace-nowrap"
239:                     >
240:                       {item.ctaLabel}
241:                     </button>
242:                   )}
243:                 </motion.li>
244:               );
245:             })}
246:           </ul>
247:         </div>
248:       </Placard>
249:     </motion.div>
250:   );
251: }
252: 
253: export default OnboardingChecklist;
</file>

