<file path="tools/ci/check-all.ts">
 1: // check-all.ts — Run all CI truth-alignment checks and summarise results.
 2: // Usage:  npx tsx tools/ci/check-all.ts
 3: 
 4: import { execSync } from 'child_process';
 5: import * as path from 'path';
 6: import { fileURLToPath } from 'url';
 7: 
 8: const __filename = fileURLToPath(import.meta.url);
 9: const __dirname = path.dirname(__filename);
10: const ROOT = path.resolve(__dirname, '../..');
11: 
12: interface CheckDef {
13:   name: string;
14:   cmd: string;
15: }
16: 
17: const CHECKS: CheckDef[] = [
18:   { name: 'Route Integrity',     cmd: 'npx tsx tools/ci/check-route-integrity.ts' },
19:   { name: 'Screen Pairs',        cmd: 'npx tsx tools/ci/check-screen-pairs.ts' },
20:   { name: 'Capability Alignment', cmd: 'npx tsx tools/ci/check-capability-alignment.ts' },
21: ];
22: 
23: function main() {
24:   console.log('🔍 Running Three-Truth Alignment checks...\n');
25: 
26:   let pass = 0;
27:   let fail = 0;
28: 
29:   for (const check of CHECKS) {
30:     try {
31:       const out = execSync(check.cmd, { cwd: ROOT, encoding: 'utf-8', stdio: 'pipe' });
32:       console.log(`✅ ${check.name}`);
33:       if (out.trim()) console.log(`   ${out.trim()}`);
34:       pass++;
35:     } catch (err: unknown) {
36:       const e = err as { stdout?: string; stderr?: string };
37:       console.error(`❌ ${check.name} FAILED`);
38:       const output = (e.stdout ?? '') + (e.stderr ?? '');
39:       for (const line of output.split('\n').filter(Boolean)) {
40:         console.error(`   ${line}`);
41:       }
42:       fail++;
43:     }
44:   }
45: 
46:   console.log(`\n────────────────────────────────`);
47:   console.log(`Result: ${pass} passed, ${fail} failed`);
48:   if (fail > 0) {
49:     process.exit(1);
50:   }
51: }
52: 
53: main();
</file>

<file path="tools/ci/check-screen-pairs.ts">
 1: // check-screen-pairs.ts — Phase 3.2: CI Screen Pair Check
 2: // Verifies every screens/NN_*/ directory has a .wireframe.xml, a .tsx file,
 3: // and a mapping.json. CI fails if any screen is unpaired.
 4: // Also validates mapping.json has required fields.
 5: // Usage:  npx tsx tools/ci/check-screen-pairs.ts
 6: 
 7: import * as fs from 'fs';
 8: import * as path from 'path';
 9: import { fileURLToPath } from 'url';
10: 
11: const __filename = fileURLToPath(import.meta.url);
12: const __dirname = path.dirname(__filename);
13: const ROOT = path.resolve(__dirname, '../..');
14: const SCREENS_DIR = path.join(ROOT, 'frontend/src/screens');
15: 
16: interface CheckResult {
17:   screenId: string;
18:   passed: boolean;
19:   missing: string[];
20:   warnings: string[];
21: }
22: 
23: const REQUIRED_MAPPING_FIELDS = ['wireframe_path', 'screen_component_path', 'route'];
24: 
25: function main() {
26:   const screenDirs = fs.readdirSync(SCREENS_DIR, { withFileTypes: true })
27:     .filter((d) => d.isDirectory() && /^\d{2}_/.test(d.name))
28:     .sort((a, b) => a.name.localeCompare(b.name));
29: 
30:   const results: CheckResult[] = [];
31: 
32:   for (const dir of screenDirs) {
33:     const dirPath = path.join(SCREENS_DIR, dir.name);
34:     const files = fs.readdirSync(dirPath);
35:     const missing: string[] = [];
36:     const warnings: string[] = [];
37: 
38:     const hasWireframe = files.some((f) => f.endsWith('.wireframe.xml'));
39:     const hasTsx = files.some((f) => f.endsWith('.tsx') && !f.includes('.test.'));
40:     const hasMappingFile = files.includes('mapping.json');
41: 
42:     if (!hasWireframe) missing.push('.wireframe.xml');
43:     if (!hasTsx) missing.push('.tsx');
44:     if (!hasMappingFile) missing.push('mapping.json');
45: 
46:     // Validate mapping.json fields if present
47:     if (hasMappingFile) {
48:       try {
49:         const mapping = JSON.parse(fs.readFileSync(path.join(dirPath, 'mapping.json'), 'utf-8'));
50:         for (const field of REQUIRED_MAPPING_FIELDS) {
51:           if (!mapping[field]) {
52:             warnings.push(`mapping.json missing field: "${field}"`);
53:           }
54:         }
55:       } catch (_e) {
56:         missing.push('valid mapping.json (parse failed)');
57:       }
58:     }
59: 
60:     results.push({
61:       screenId: dir.name,
62:       passed: missing.length === 0,
63:       missing,
64:       warnings,
65:     });
66:   }
67: 
68:   const failures = results.filter((r) => !r.passed);
69:   const warns = results.filter((r) => r.passed && r.warnings.length > 0);
70: 
71:   if (failures.length === 0 && warns.length === 0) {
72:     console.log(`✅ Screen pair check passed — all ${results.length} screens are correctly paired`);
73:     process.exit(0);
74:   }
75: 
76:   console.log('\nScreen Pair Check:');
77:   for (const r of failures) {
78:     console.error(`  ❌ ${r.screenId}: missing ${r.missing.join(', ')}`);
79:   }
80:   for (const r of warns) {
81:     for (const w of r.warnings) {
82:       console.warn(`  ⚠️  ${r.screenId}: ${w}`);
83:     }
84:   }
85: 
86:   console.log(`\n${results.length} screens checked: ${failures.length} unpaired, ${warns.length} with warnings`);
87:   if (failures.length > 0) {
88:     process.exit(1);
89:   }
90: }
91: 
92: main();
</file>

