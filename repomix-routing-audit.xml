<file path="tools/ci/check-capability-alignment.ts">
 1: // check-capability-alignment.ts — Phase 3.3: CI Capability Truth Check
 2: // Validates that every apiDep in ROUTE_REGISTRY exists in the codebase
 3: // and matches an endpoint documented in the OpenAPI snapshot or API usage manifest.
 4: // Usage:  npx tsx tools/ci/check-capability-alignment.ts
 5: 
 6: import * as fs from 'fs';
 7: import * as path from 'path';
 8: import { fileURLToPath } from 'url';
 9: 
10: const __filename = fileURLToPath(import.meta.url);
11: const __dirname = path.dirname(__filename);
12: const ROOT = path.resolve(__dirname, '../..');
13: 
14: const REGISTRY_PATH = path.join(ROOT, 'frontend/src/config/route-registry.ts');
15: const API_DIR = path.join(ROOT, 'frontend/src/api');
16: 
17: function main() {
18:   console.log('Capability Alignment Check:\n');
19: 
20:   if (!fs.existsSync(REGISTRY_PATH)) {
21:     console.error('❌ Route registry not found');
22:     process.exit(1);
23:   }
24: 
25:   // We read the registry content to extract apiDeps via regex
26:   const registryText = fs.readFileSync(REGISTRY_PATH, 'utf-8');
27: 
28:   // Extract all apiDeps strings
29:   const apiDepMatch = registryText.match(/apiDeps: \[[^\]]*\]/g);
30:   const declaredDeps = new Set<string>();
31: 
32:   if (apiDepMatch) {
33:     for (const m of apiDepMatch) {
34:       const endpoints = m.match(/['"`]([^'"`]+)['"`]/g);
35:       if (endpoints) {
36:         endpoints.forEach(e => declaredDeps.add(e.replace(/['"`]/g, '')));
37:       }
38:     }
39:   }
40: 
41:   let errors = 0;
42:   let warnings = 0;
43: 
44:   console.log(`Verifying ${declaredDeps.size} unique Capability IDs in frontend/src/api/...\n`);
45: 
46:   for (const dep of declaredDeps) {
47:     // Check if the service file exists
48:     // Capability IDs match file names (e.g., 'authService' -> 'authService.ts')
49:     const serviceFile = path.join(API_DIR, `${dep}.ts`);
50:     const exists = fs.existsSync(serviceFile);
51: 
52:     if (exists) {
53:       console.log(`✅ [FOUND] ${dep} -> ${path.relative(ROOT, serviceFile)}`);
54:     } else {
55:       console.error(`❌ [MISSING] ${dep} - No corresponding file ${path.relative(ROOT, serviceFile)}`);
56:       errors++;
57:     }
58:   }
59: 
60:   console.log(`\nTotal: ${errors} errors, ${warnings} warnings`);
61: 
62:   if (errors > 0) {
63:     console.error('\nFAIL: One or more declared API dependencies are missing from the codebase.');
64:     process.exit(1);
65:   } else {
66:     console.log('\nPASS: All declared API dependencies are verified as present in the codebase.');
67:   }
68: }
69: 
70: main();
</file>

