 10: import { Edit, Target, Trash2, TrendingUp } from 'lucide-react';
 11: import React from 'react';
 12: 
 13: export interface Profile {
 14:   id: string;
 15:   name: string;
 16:   role: string;
 17:   activeApplications: number;
 18:   atsScore: number;
 19:   lastUpdated: string;
 20:   avatarColor?: string;
 21: }
 22: 
 23: export interface ProfileCardProps extends Profile {
 24:   onEdit: () => void;
 25:   onDelete: () => void;
 26:   isSelected?: boolean;
 27:   decorImage?: string;
 28:   variant?: 'default' | 'illustrated';
