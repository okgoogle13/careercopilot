  2: // Validates every entry in ROUTE_REGISTRY has a resolvable component file
  3: // and, where screenId is set, a matching screens/ directory.
  4: // Usage:  npx tsx tools/ci/check-route-integrity.ts
  5: 
  6: import * as fs from 'fs';
  7: import * as path from 'path';
  8: import { fileURLToPath } from 'url';
  9: 
 10: const __filename = fileURLToPath(import.meta.url);
 11: const __dirname = path.dirname(__filename);
 12: const ROOT = path.resolve(__dirname, '../..');
 13: const ROUTES_JSON = path.join(ROOT, 'docs/manifests/routes.json');
 14: const SCREENS_DIR = path.join(ROOT, 'frontend/src/screens');
 15: const FEATURES_DIR = path.join(ROOT, 'frontend/src/features');
 16: const SRC_DIR = path.join(ROOT, 'frontend/src');
 17: 
 18: interface RouteManifestEntry {
 19:   path: string;
 20:   component: string;
 21:   importSource: string;
 22:   auth: boolean;
 23:   layout: string;
 24: }
 25: 
 26: type Severity = 'error' | 'warning';
 27: interface CheckResult {
 28:   severity: Severity;
 29:   route: string;
 30:   message: string;
 31: }
 32: 
 33: function resolveImport(importSource: string): string | null {
 34:   if (importSource === 'UNKNOWN') return null;
 35:   if (importSource === 'react-router-dom') return importSource;
 36:   const base = importSource.replace(/^\.\//, '');
 37:   const candidates = [
 38:     path.join(SRC_DIR, base + '.tsx'),
 39:     path.join(SRC_DIR, base + '.ts'),
 40:     path.join(SRC_DIR, base, 'index.tsx'),
 41:     path.join(SRC_DIR, base, 'index.ts'),
 42:   ];
 43:   return candidates.find(fs.existsSync) ?? null;
 44: }
 45: 
 46: function main() {
 47:   if (!fs.existsSync(ROUTES_JSON)) {
 48:     console.error('❌ routes.json not found — run scan-routes.ts first');
 49:     process.exit(1);
 50:   }
 51:   const { routes }: { routes: RouteManifestEntry[] } = JSON.parse(fs.readFileSync(ROUTES_JSON, 'utf-8'));
 52: 
 53:   const screenIds = fs.readdirSync(SCREENS_DIR).filter((d) =>
 54:     /^\d{2}_/.test(d) && fs.statSync(path.join(SCREENS_DIR, d)).isDirectory()
 55:   );
 56: 
 57:   const results: CheckResult[] = [];
 58: 
 59:   for (const route of routes) {
 60:     // Skip wildcard
 61:     if (route.path === '*') continue;
 62: 
 63:     // 1. Check component file resolves
 64:     const resolved = resolveImport(route.importSource);
 65:     if (!resolved) {
 66:       const isNonFeature = !route.importSource.includes('/features/');
 67:       results.push({
 68:         severity: isNonFeature ? 'warning' : 'error',
 69:         route: route.path,
 70:         message: `Component "${route.importSource}" cannot be resolved.${isNonFeature ? ' (non-features/ source — migration required)' : ''}`,
 71:       });
 72:     }
 73: 
 74:     // 2. Check non-prototype routes source from features/
 75:     if (!route.importSource.includes('/features/') &&
 76:         route.importSource !== 'react-router-dom' &&
 77:         !route.importSource.includes('/pages/') &&  // pages/ is known legacy
 78:         route.importSource !== 'UNKNOWN' &&
 79:         !route.path.startsWith('/kr/') &&
 80:         !route.path.startsWith('/prototype') &&
 81:         route.path !== '/test-tokens') {
 82:       results.push({
 83:         severity: 'warning',
 84:         route: route.path,
 85:         message: `Route sources from "${route.importSource}" — expected features/ for production routes`,
 86:       });
 87:     }
 88:   }
 89: 
 90:   // Summary
 91:   const errors = results.filter((r) => r.severity === 'error');
 92:   const warnings = results.filter((r) => r.severity === 'warning');
 93: 
 94:   if (results.length === 0) {
 95:     console.log('✅ Route integrity check passed — all routes valid');
 96:     process.exit(0);
 97:   }
 98: 
 99:   console.log(`\nRoute Integrity Check:`);
100:   for (const r of errors) {
101:     console.error(`  ❌ [ERROR] ${r.route}: ${r.message}`);
102:   }
103:   for (const r of warnings) {
104:     console.warn(`  ⚠️  [WARN]  ${r.route}: ${r.message}`);
105:   }
106: 
107:   console.log(`\nTotal: ${errors.length} errors, ${warnings.length} warnings`);
108:   if (errors.length > 0) {
109:     process.exit(1);
110:   }
111: }
112: 
113: main();
</file>

