<file path="frontend/src/features/profile/components/VoiceSampleSubmissionForm.tsx">
  1: /**
  2:  * Voice Sample Submission Form
  3:  *
  4:  * Form for submitting a writing sample used to establish the user's voice profile.
  5:  */
  6: 
  7: import { useCallback } from 'react';
  8: import { useForm } from 'react-hook-form';
  9: import { z } from 'zod';
 10: import { zodResolver } from '@hookform/resolvers/zod';
 11: 
 12: const voiceSampleSchema = z.object({
 13:   writingSample: z
 14:     .string()
 15:     .min(50, 'At least 50 characters needed — a short paragraph is enough.')
 16:     .max(5000, 'Writing sample must not exceed 5000 characters'),
 17: });
 18: 
 19: type VoiceSampleFormData = z.infer<typeof voiceSampleSchema>;
 20: 
 21: export interface VoiceSampleSubmissionFormProps {
 22:   onSubmit: (sample: string) => Promise<void>;
 23:   loading?: boolean;
 24:   error?: string | null;
 25: }
 26: 
 27: export function VoiceSampleSubmissionForm({
 28:   onSubmit,
 29:   loading = false,
 30:   error = null,
 31: }: VoiceSampleSubmissionFormProps) {
 32:   const {
 33:     register,
 34:     handleSubmit,
 35:     formState: { errors, isSubmitting },
 36:     reset,
 37:   } = useForm<VoiceSampleFormData>({
 38:     resolver: zodResolver(voiceSampleSchema),
 39:     defaultValues: {
 40:       writingSample: '',
 41:     },
 42:   });
 43: 
 44:   const onFormSubmit = useCallback(
 45:     async (data: VoiceSampleFormData) => {
 46:       try {
 47:         await onSubmit(data.writingSample);
 48:         reset();
 49:       } catch (err) {
 50:         // Error surfaced via the error prop from the parent
 51:       }
 52:     },
 53:     [onSubmit, reset]
 54:   );
 55: 
 56:   const isProcessing = loading || isSubmitting;
 57: 
 58:   return (
 59:     <form
 60:       onSubmit={handleSubmit(onFormSubmit)}
 61:       className="w-full"
 62:     >
 63:       <div className="space-y-4">
 64:         {/* Prompt — Reflection register */}
 65:         <div
 66:           className="text-sm leading-relaxed"
 67:           style={{ color: 'var(--sys-color-paperWhite-base)' }}
 68:         >
 69:           <p className="opacity-80">
 70:             Paste anything you have written — a cover letter, an email, a short reflection. A
 71:             paragraph is enough. We will take it from there.
 72:           </p>
 73:         </div>
 74: 
 75:         {/* Textarea */}
 76:         <textarea
 77:           {...register('writingSample')}
 78:           placeholder="Your words go here..."
 79:           disabled={isProcessing}
 80:           style={{
 81:             backgroundColor: 'var(--sys-color-charcoalBackground-steps-2)',
 82:             color: 'var(--sys-color-paperWhite-base)',
 83:             borderColor: errors.writingSample
 84:               ? 'var(--sys-color-kr-charcoalRed-base)'
 85:               : 'var(--sys-color-concreteGrey-base)',
 86:             borderRadius: 'var(--sys-shape-blockRiot02)',
 87:           }}
 88:           className="w-full p-4 border-2 transition-colors duration-200 min-h-[200px] font-primary text-base resize-none focus:outline-none focus:border-opacity-100"
 89:         />
 90: 
 91:         {/* Validation error */}
 92:         {errors.writingSample && (
 93:           <div
 94:             style={{ color: 'var(--sys-color-kr-charcoalRed-base)' }}
 95:             className="text-sm font-medium"
 96:           >
 97:             {errors.writingSample.message}
 98:           </div>
 99:         )}
100: 
101:         {/* Submission error */}
102:         {error && (
103:           <div
104:             style={{
105:               backgroundColor: 'var(--sys-color-kr-charcoalRed-base)',
106:               color: 'var(--sys-color-paperWhite-base)',
107:               borderRadius: 'var(--sys-shape-blockRiot02)',
108:             }}
109:             className="p-4 text-sm"
110:           >
111:             {error}
112:           </div>
113:         )}
114: 
115:         {/* Submit */}
116:         <button
117:           type="submit"
118:           disabled={isProcessing}
119:           style={{
120:             backgroundColor: isProcessing
121:               ? 'var(--sys-color-concreteGrey-base)'
122:               : 'var(--sys-color-solidarityRed-base)',
123:             color: 'var(--sys-color-charcoalBackground-base)',
124:             borderRadius: 'var(--sys-shape-blockRiot03)',
125:             opacity: isProcessing ? 0.6 : 1,
126:           }}
127:           className="w-full px-6 py-3 font-display font-bold text-sm uppercase tracking-wide transition-all duration-200 disabled:cursor-not-allowed hover:opacity-90"
128:         >
129:           {isProcessing ? 'Reading your voice...' : 'Record My Voice'}
130:         </button>
131:       </div>
132:     </form>
133:   );
134: }
</file>

