  1: /**
  2:  * ELECTRIC ALCHEMIST: PROFILE COMPARISON FEATURE
  3:  *
  4:  * Side-by-side profile comparison with design system tokens.
  5:  */
  6: 
  7: import React, { useState } from 'react';
  8: import { ArrowLeftRight as SwapHoriz, Download, Share } from 'lucide-react';
  9: import { Button } from '@careercopilot/ui';
 10: import { Card } from '@careercopilot/ui';
 11: import { Badge } from '@careercopilot/ui';
 12: import { Tabs, TabsList, TabsTrigger, TabsContent } from '@careercopilot/ui';
 13: 
 14: // Mock component to satisfy build until custom components are migrated
 15: const ATSScoreCircle = ({ score, size }: { score: number; size?: string }) => (
 16:   <div
 17:     className={`p-2 rounded-march border-2 border-primary flex items-center justify-center font-bold ${size === 'small' ? 'w-10 h-10 text-xs' : 'w-20 h-20 text-lg'}`}
 18:   >
 19:     {score}
 20:   </div>
 21: );
 22: 
 23: interface ProfileData {
 24:   id: string;
 25:   name: string;
 26:   role: string;
 27:   activeApplications: number;
 28:   atsScore: number;
 29:   lastUpdated: string;
 30:   avatarColor: string;
 31:   skills: string[];
 32:   experience: {
 33:     company: string;
 34:     position: string;
 35:     duration: string;
 36:     highlights: string[];
 37:   }[];
 38: }
 39: 
 40: interface ProfileComparisonProps {
 41:   leftProfile?: ProfileData;
