<file path="frontend/src/features/analysis/services/atsScorer.ts">
  1: import nlp from 'compromise';
  2: import {
  3:   ATSScoreResult,
  4:   CoverLetterScoreResult,
  5:   DocumentType,
  6:   ScoringWeights,
  7: } from '../../../types/career';
  8: 
  9: export class ATSScorer {
 10:   private resumeWeights: ScoringWeights = {
 11:     keywordMatch: 0.45,
 12:     skillsAlignment: 0.25,
 13:     jobTitleMatch: 0.15,
 14:     experienceRelevance: 0.1,
 15:     formatCompliance: 0.05,
 16:   };
 17: 
 18:   private coverLetterWeights = {
 19:     keywordDensity: 0.45,
 20:     keywordPlacement: 0.18,
 21:     skillsAlignment: 0.22,
 22:     formatCompliance: 0.15,
 23:   };
 24: 
 25:   public calculateScore(
 26:     documentText: string,
 27:     jobDescription: string,
 28:     documentType: DocumentType = 'resume'
 29:   ): ATSScoreResult | CoverLetterScoreResult {
 30:     if (documentType === 'coverLetter') {
 31:       return this.calculateCoverLetterScore(documentText, jobDescription);
 32:     }
 33:     return this.calculateResumeScore(documentText, jobDescription);
 34:   }
 35: 
 36:   private calculateResumeScore(resumeText: string, jobDescription: string): ATSScoreResult {
 37:     const jobKeywords = this.extractKeywords(jobDescription);
 38:     const resumeKeywords = this.extractKeywords(resumeText);
 39: 
 40:     const keywordMatchScore = this.scoreKeywordMatch(resumeKeywords, jobKeywords, resumeText);
 41:     const skillsScore = this.scoreSkillsAlignment(resumeText, jobDescription);
 42:     const jobTitleScore = this.scoreJobTitleMatch(resumeText, jobDescription);
 43:     const experienceScore = this.scoreExperienceRelevance(resumeText, jobDescription);
 44:     const formatScore = this.scoreFormatCompliance(resumeText);
 45: 
 46:     const overallScore = Math.round(
 47:       keywordMatchScore * this.resumeWeights.keywordMatch +
 48:         skillsScore * this.resumeWeights.skillsAlignment +
 49:         jobTitleScore * this.resumeWeights.jobTitleMatch +
 50:         experienceScore * this.resumeWeights.experienceRelevance +
 51:         formatScore * this.resumeWeights.formatCompliance
 52:     );
 53: 
 54:     return {
 55:       overallScore,
 56:       summary:
 57:         'Manual local scan completed. For deep semantic analysis, use the AI Studio Harvest.',
 58:       breakdown: {
 59:         keywordDensityScore: keywordMatchScore,
 60:         jobTitleScore: jobTitleScore,
 61:         semanticScore: skillsScore,
 62:         educationExperienceScore: experienceScore,
 63:         formattingScore: formatScore,
 64:       },
 65:       matchedKeywords: this.getMatchedKeywords(resumeKeywords, jobKeywords),
 66:       missingKeywords: this.getMissingKeywords(resumeKeywords, jobKeywords),
 67:       recommendations: this.generateSuggestions(
 68:         resumeText,
 69:         jobDescription,
 70:         keywordMatchScore,
 71:         skillsScore
 72:       ),
 73:       keywordDensity: this.calculateKeywordDensity(resumeText, jobKeywords),
 74:     };
 75:   }
 76: 
 77:   private calculateCoverLetterScore(
 78:     coverLetterText: string,
 79:     jobDescription: string
 80:   ): CoverLetterScoreResult {
 81:     const jobKeywords = this.extractKeywords(jobDescription);
 82:     const coverLetterKeywords = this.extractKeywords(coverLetterText);
 83: 
 84:     const keywordMatchScore = this.scoreKeywordMatch(
 85:       coverLetterKeywords,
 86:       jobKeywords,
 87:       coverLetterText,
 88:       'coverLetter'
 89:     );
 90:     const placementScore = this.scoreKeywordPlacement(coverLetterText, jobKeywords);
 91:     const skillsScore = this.scoreSkillsAlignment(coverLetterText, jobDescription);
 92:     const formatScore = this.scoreCoverLetterFormat(coverLetterText);
 93: 
 94:     const narrativeScore = this.scoreNarrativeQuality(coverLetterText);
 95:     const personalizationScore = this.scorePersonalization(coverLetterText, jobDescription);
 96:     const toneScore = this.scoreToneProfessionalism(coverLetterText);
 97:     const lengthScore = this.scoreLengthCompliance(coverLetterText);
 98: 
 99:     const overallScore = Math.round(
100:       keywordMatchScore * this.coverLetterWeights.keywordDensity +
101:         placementScore * this.coverLetterWeights.keywordPlacement +
102:         skillsScore * this.coverLetterWeights.skillsAlignment +
103:         formatScore * this.coverLetterWeights.formatCompliance
104:     );
105: 
106:     const callToActionPresent = this.detectCallToAction(coverLetterText);
107: 
108:     return {
109:       overallScore,
110:       summary: 'Manual local scan completed. Narrative and tone analyzed based on heuristics.',
111:       breakdown: {
112:         keywordDensityScore: keywordMatchScore,
113:         jobTitleScore: 100, // Not applicable for CL
114:         semanticScore: skillsScore,
115:         educationExperienceScore: 100, // Not applicable for CL
116:         formattingScore: formatScore,
117:       },
118:       matchedKeywords: this.getMatchedKeywords(coverLetterKeywords, jobKeywords),
119:       missingKeywords: this.getMissingKeywords(coverLetterKeywords, jobKeywords),
120:       recommendations: this.generateCoverLetterSuggestions(
121:         coverLetterText,
122:         jobDescription,
123:         placementScore,
124:         formatScore,
125:         callToActionPresent
126:       ),
127:       keywordDensity: this.calculateKeywordDensity(coverLetterText, jobKeywords),
128:       keywordPlacement: placementScore,
129:       narrativeQuality: narrativeScore,
130:       personalizationScore: personalizationScore,
131:       toneProfessionalism: toneScore,
132:       lengthCompliance: lengthScore,
133:       callToActionPresent,
134:     };
135:   }
136: 
137:   private extractKeywords(text: string): Set<string> {
138:     const doc = nlp(text.toLowerCase());
139:     const nouns = doc.nouns().out('array');
140:     const verbs = doc.verbs().out('array');
141:     const adjectives = doc.adjectives().out('array');
142: 
143:     // Filter out common words and short tokens
144:     const stopWords = new Set([
145:       'the',
146:       'and',
147:       'for',
148:       'with',
149:       'that',
150:       'this',
151:       'from',
152:       'your',
153:       'their',
154:       'will',
155:       'have',
156:       'been',
157:       'were',
158:       'was',
159:       'are',
160:       'has',
161:     ]);
162: 
163:     const keywords = [...nouns, ...verbs, ...adjectives]
164:       .map((k) => k.trim())
165:       .filter((k) => k.length > 2 && !stopWords.has(k) && /^[a-z\s]+$/.test(k));
166: 
167:     return new Set(keywords);
168:   }
169: 
170:   private scoreKeywordMatch(
171:     docKeywords: Set<string>,
172:     jobKeywords: Set<string>,
173:     text: string,
174:     type: DocumentType = 'resume'
175:   ): number {
176:     if (jobKeywords.size === 0) return 100;
177: 
178:     const exactMatches = [...jobKeywords].filter((kw) => docKeywords.has(kw));
179:     const baseScore = (exactMatches.length / jobKeywords.size) * 100;
180: 
181:     // Simple semantic bonus based on word overlap in sentences
182:     const sentences = text.toLowerCase().split(/[.!?]+/);
183:     let bonus = 0;
184:     jobKeywords.forEach((kw) => {
185:       if (!docKeywords.has(kw)) {
186:         const foundInSentence = sentences.some((s) => s.includes(kw));
187:         if (foundInSentence) bonus += 2;
188:       }
189:     });
190: 
191:     return Math.min(100, baseScore + bonus);
192:   }
193: 
194:   private scoreSkillsAlignment(text: string, jobDescription: string): number {
195:     const commonSkills = [
196:       'python',
197:       'javascript',
198:       'react',
199:       'typescript',
200:       'node.js',
201:       'sql',
202:       'aws',
203:       'docker',
204:       'kubernetes',
205:       'git',
206:       'communication',
207:       'leadership',
208:       'problem-solving',
209:       'teamwork',
210:       'agile',
211:       'scrum',
212:       'project management',
213:       'data analysis',
214:       'customer service',
215:       'sales',
216:       'marketing',
217:       'design',
218:       'ui/ux',
219:       'ndis',
220:       'trauma-informed',
221:     ];
222: 
223:     const jobSkills = commonSkills.filter((skill) => jobDescription.toLowerCase().includes(skill));
224:     if (jobSkills.length === 0) return 100;
225: 
226:     const resumeSkills = jobSkills.filter((skill) => text.toLowerCase().includes(skill));
227:     return (resumeSkills.length / jobSkills.length) * 100;
228:   }
229: 
230:   private scoreJobTitleMatch(text: string, jobDescription: string): number {
231:     const jobTitleMatch = jobDescription.match(/Job Title:?\s*([^\n]+)/i);
232:     if (!jobTitleMatch) return 100;
233: 
234:     const targetTitle = jobTitleMatch[1].toLowerCase();
235:     return text.toLowerCase().includes(targetTitle) ? 100 : 50;
236:   }
237: 
238:   private scoreExperienceRelevance(text: string, jobDescription: string): number {
239:     const yearsMatch = jobDescription.match(/(\d+)\+?\s*years?/i);
240:     if (!yearsMatch) return 100;
241: 
242:     const requiredYears = parseInt(yearsMatch[1]);
243:     const resumeYears = text.match(/(\d+)\+?\s*years?/gi);
244: 
245:     if (!resumeYears) return 50;
246: 
247:     const maxYears = Math.max(...resumeYears.map((y) => parseInt(y)));
248:     return maxYears >= requiredYears ? 100 : (maxYears / requiredYears) * 100;
249:   }
250: 
251:   private scoreKeywordPlacement(coverLetterText: string, keywords: Set<string>): number {
252:     const paragraphs = coverLetterText.split('\n\n').filter((p) => p.trim().length > 0);
253: 
254:     if (paragraphs.length === 0 || keywords.size === 0) return 0;
255: 
256:     const firstParaKeywords = [...keywords].filter((kw) =>
257:       paragraphs[0].toLowerCase().includes(kw)
258:     ).length;
259: 
260:     const otherParaKeywords = [...keywords].filter((kw) =>
261:       paragraphs.slice(1).join(' ').toLowerCase().includes(kw)
262:     ).length;
263: 
264:     const placementScore =
265:       (firstParaKeywords / keywords.size) * 60 + (otherParaKeywords / keywords.size) * 40;
266: 
267:     return Math.min(100, placementScore);
268:   }
269: 
270:   private scoreCoverLetterFormat(text: string): number {
271:     let score = 100;
272:     const paragraphs = text.split('\n\n').filter((p) => p.trim().length > 0);
273:     if (paragraphs.length < 3) score -= 20;
274:     if (text.includes('Table') || text.includes('Chart')) score -= 20;
275:     return Math.max(0, score);
276:   }
277: 
278:   private scoreFormatCompliance(text: string): number {
279:     let score = 100;
280:     if (text.includes('Table') || text.includes('Chart')) score -= 20;
281:     if (text.length < 500) score -= 30;
282:     return Math.max(0, score);
283:   }
284: 
285:   private scoreNarrativeQuality(text: string): number {
286:     let score = 100;
287:     const paragraphs = text.split('\n\n').filter((p) => p.trim().length > 0);
288:     if (paragraphs.length < 3) score -= 20;
289:     if (paragraphs.length > 6) score -= 10;
290: 
291:     const hasMetrics = /\d+%|\d+\+|increased|improved|reduced|generated/i.test(text);
292:     if (!hasMetrics) score -= 15;
293: 
294:     return Math.max(0, score);
295:   }
296: 
297:   private scorePersonalization(text: string, jobDescription: string): number {
298:     let score = 100;
299:     const companyNameMatch =
300:       jobDescription.match(/Company:?\s*([^\n]+)/i) ||
301:       jobDescription.match(/at\s+([A-Z][a-zA-Z\s&]+?)[\.,\s]/);
302:     const companyName = companyNameMatch ? companyNameMatch[1].trim() : null;
303: 
304:     if (companyName && !text.toLowerCase().includes(companyName.toLowerCase())) {
305:       score -= 30;
306:     }
307: 
308:     const genericPhrases = [
309:       'to whom it may concern',
310:       'dear hiring manager',
311:       'i am writing to apply',
312:     ];
313:     genericPhrases.forEach((phrase) => {
314:       if (text.toLowerCase().includes(phrase)) score -= 10;
315:     });
316: 
317:     return Math.max(0, score);
318:   }
319: 
320:   private scoreToneProfessionalism(text: string): number {
321:     let score = 100;
322:     const hasGreeting = /dear\s+[a-z]+/i.test(text);
323:     if (!hasGreeting) score -= 20;
324: 
325:     const hasClosing = /sincerely|regards|respectfully|best/i.test(text);
326:     if (!hasClosing) score -= 20;
327: 
328:     return Math.max(0, score);
329:   }
330: 
331:   private scoreLengthCompliance(text: string): number {
332:     const wordCount = text.split(/\s+/).length;
333:     if (wordCount >= 300 && wordCount <= 400) return 100;
334:     if (wordCount < 200) return 40;
335:     return 70;
336:   }
337: 
338:   private detectCallToAction(text: string): boolean {
339:     const ctaPatterns = ['look forward to', 'would welcome', 'eager to discuss', 'available for'];
340:     return ctaPatterns.some((pattern) => text.toLowerCase().includes(pattern));
341:   }
342: 
343:   private calculateKeywordDensity(text: string, keywords: Set<string>): Record<string, number> {
344:     const words = text.toLowerCase().split(/\s+/);
345:     const wordCount = words.length;
346:     const density: Record<string, number> = {};
347: 
348:     keywords.forEach((keyword) => {
349:       const occurrences = (text.toLowerCase().match(new RegExp(keyword.toLowerCase(), 'g')) || [])
350:         .length;
351:       density[keyword] = parseFloat(((occurrences / wordCount) * 100).toFixed(2));
352:     });
353: 
354:     return density;
355:   }
356: 
357:   private getMatchedKeywords(docKeywords: Set<string>, jobKeywords: Set<string>): string[] {
358:     return [...jobKeywords].filter((kw) => docKeywords.has(kw));
359:   }
360: 
361:   private getMissingKeywords(docKeywords: Set<string>, jobKeywords: Set<string>): string[] {
362:     return [...jobKeywords].filter((kw) => !docKeywords.has(kw));
363:   }
364: 
365:   private generateSuggestions(
366:     text: string,
367:     jobDescription: string,
368:     keywordScore: number,
369:     skillsScore: number
370:   ): string[] {
371:     const suggestions: string[] = [];
372:     if (keywordScore < 60)
373:       suggestions.push('Add more keywords from the job description to improve match rate');
374:     if (skillsScore < 70)
375:       suggestions.push('Include specific technical skills mentioned in the job posting');
376:     return suggestions;
377:   }
378: 
379:   private generateCoverLetterSuggestions(
380:     text: string,
381:     jobDescription: string,
382:     placementScore: number,
383:     formatScore: number,
384:     hasCTA: boolean
385:   ): string[] {
386:     const suggestions: string[] = [];
387:     if (placementScore < 60)
388:       suggestions.push('Include more job description keywords in your opening paragraph');
389:     if (formatScore < 80)
390:       suggestions.push('Ensure simple paragraph formatting without tables or complex structures');
391:     if (!hasCTA) suggestions.push('Add a call to action expressing interest in an interview');
392:     return suggestions;
393:   }
394: }
</file>

