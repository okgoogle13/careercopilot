 18: 
 19:   // Sync achievements if careerData changes from outside
 20:   useEffect(() => {
 21:     setAchievements(careerData.Structured_Achievements);
 22:   }, [careerData.Structured_Achievements]);
 23: 
 24:   const handlePolish = async (achId: string, field: keyof StructuredAchievement) => {
 25:     setIsPolishing(`${achId}-${String(field)}`);
 26:     try {
 27:       const ach = achievements.find((a) => a.Achievement_ID === achId);
 28:       if (!ach) return;
 29:       const polishedText = await genkitService.refineAchievementField(ach, field as string);
 30:       setSuggestions((prev) => ({ ...prev, [`${achId}-${String(field)}`]: polishedText }));
 31:     } catch (error) {
 32:       console.error('Failed to polish text:', error);
 33:       alert('Failed to polish text. Please try again.');
 34:     } finally {
 35:       setIsPolishing(null);
 36:     }
 37:   };
 38: 
 39:   const applySuggestion = (achId: string, field: keyof StructuredAchievement) => {
 40:     const suggestion = suggestions[`${achId}-${String(field)}`];
 41:     if (!suggestion) return;
 42: 
 43:     const updatedAchievements = achievements.map((a) =>
 44:       a.Achievement_ID === achId ? { ...a, [field]: suggestion } : a
 45:     );
 46: 
 47:     setAchievements(updatedAchievements);
 48: 
 49:     if (onUpdate) {
 50:       onUpdate({
 51:         ...careerData,
 52:         Structured_Achievements: updatedAchievements,
 53:       });
 54:     }
 55: 
 56:     setSuggestions((prev) => {
 57:       const next = { ...prev };
 58:       delete next[`${achId}-${String(field)}`];
 59:       return next;
 60:     });
 61:   };
 62: 
 63:   const discardSuggestion = (achId: string, field: keyof StructuredAchievement) => {
 64:     setSuggestions((prev) => {
 65:       const next = { ...prev };
 66:       delete next[`${achId}-${String(field)}`];
 67:       return next;
 68:     });
 69:   };
 70: 
 71:   const getAchievementsForEntry = (entryId: string) => {
 72:     const entryAchievements = achievements.filter((a) => a.Entry_ID === entryId);
 73: 
 74:     return entryAchievements.sort((a, b) => {
 75:       const aIsRecommended = analysis.Recommended_Achievement_IDs.includes(a.Achievement_ID);
 76:       const bIsRecommended = analysis.Recommended_Achievement_IDs.includes(b.Achievement_ID);
 77:       if (aIsRecommended && !bIsRecommended) return -1;
 78:       if (!aIsRecommended && bIsRecommended) return 1;
 79:       return 0;
 80:     });
 81:   };
 82: 
 83:   const workEntries = careerData.Career_Entries.filter(
 84:     (e) => e.Entry_Type === 'Work Experience'
 85:   ).sort((a, b) => new Date(b.StartDate).getTime() - new Date(a.StartDate).getTime());
 86: 
 87:   const educationEntries = careerData.Career_Entries.filter((e) => e.Entry_Type === 'Education');
 88: 
 89:   return {
 90:     achievements,
 91:     tailoredSummary,
 92:     setTailoredSummary,
 93:     isPolishing,
 94:     suggestions,
 95:     handlePolish,
 96:     applySuggestion,
 97:     discardSuggestion,
 98:     getAchievementsForEntry,
 99:     workEntries,
100:     educationEntries,
101:   };
102: }
</file>

