 17:   onUpdate?: (data: CareerDatabase) => void;
 18: }
 19: 
 20: export const TailoredResumeView: React.FC<TailoredResumeViewProps> = ({
 21:   careerData,
 22:   analysis,
 23:   template,
 24:   locale = 'US',
 25:   onUpdate,
 26: }) => {
 27:   const { Personal_Information } = careerData;
 28: 
 29:   const {
 30:     achievements,
 31:     tailoredSummary,
