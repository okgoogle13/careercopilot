 32: }: UseDocumentExportProps) {
 33:   const { setExportUrl } = useAnalysisPipelineStore();
 34: 
 35:   const exportToPDF = async (documentType?: 'resume' | 'coverLetter' | 'ksc') => {
 36:     const target = documentType || activeTab;
 37: 
 38:     // Attempt server-rendered export for resume and cover letter
 39:     if (target === 'resume' && assetId) {
 40:       try {
 41:         const result = await exportService.exportResume({
 42:           content: { career_data: careerData, analysis },
 43:           job_title: jobTitle,
 44:           format: 'pdf',
 45:         });
 46:         if (result.success && result.download_url) {
 47:           setExportUrl(assetId, 'resume', result.download_url);
 48:           window.open(result.download_url, '_blank');
 49:           return;
 50:         }
 51:       } catch {
 52:         // fall through to client-side export
 53:       }
 54:     }
 55: 
 56:     if (target === 'coverLetter' && assetId) {
 57:       try {
 58:         const content = coverLetterContent || analysis?.Cover_Letter_Draft || '';
 59:         const result = await exportService.exportCoverLetter({
 60:           content,
 61:           job_title: jobTitle,
 62:           format: 'pdf',
 63:         });
 64:         if (result.success && result.download_url) {
 65:           setExportUrl(assetId, 'cover-letter', result.download_url);
 66:           window.open(result.download_url, '_blank');
 67:           return;
 68:         }
 69:       } catch {
 70:         // fall through to client-side export
 71:       }
 72:     }
 73: 
 74:     // Client-side fallback
 75:     let element: HTMLElement | null = null;
 76:     let filename = 'Document.pdf';
 77: 
 78:     if (target === 'resume' && resumeRef.current) {
 79:       element = resumeRef.current;
 80:       filename = 'Tailored_Resume.pdf';
 81:     } else if (target === 'ksc' && kscRef.current) {
 82:       element = kscRef.current;
 83:       filename = 'KSC_Responses.pdf';
 84:     } else if (target === 'coverLetter' && analysis) {
 85:       element = document.createElement('div');
 86:       element.innerHTML = `
 87:         <div style="font-family: ${selectedTemplate.fontSans}; padding: 40px; color: ${selectedTemplate.textColor}; max-width: 800px; margin: auto;">
 88:           <h1 style="color: ${selectedTemplate.primaryColor}; border-bottom: 2px solid ${selectedTemplate.primaryColor}; padding-bottom: 10px; margin-bottom: 30px; text-transform: uppercase;">Cover Letter</h1>
 89:           <div style="white-space: pre-wrap; line-height: 1.6;">${coverLetterContent || analysis.Cover_Letter_Draft}</div>
 90:         </div>
 91:       `;
 92:       filename = 'Cover_Letter.pdf';
 93:     }
 94: 
 95:     if (element) {
 96:       const opt = {
 97:         margin: 10,
 98:         filename: filename,
 99:         image: { type: 'jpeg' as const, quality: 0.98 },
100:         html2canvas: { scale: 2 },
101:         jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' as const },
102:       };
103:       html2pdf().set(opt).from(element).save();
104:     }
105:   };
106: 
107:   const getFullResumeText = () => {
108:     if (!analysis) return '';
109:     let md = `${careerData.Personal_Information.FullName}\n\n`;
110:     md += `Email: ${careerData.Personal_Information.Email} | Phone: ${careerData.Personal_Information.Phone} | Location: ${careerData.Personal_Information.Location}\n\n`;
111:     md += `Professional Summary\n${analysis.Tailored_Summary}\n\n`;
112:     md += `Professional Experience\n`;
113: 
114:     const workEntries = careerData.Career_Entries.filter(
115:       (e) => e.Entry_Type === ('Work Experience' as any)
116:     ).sort((a, b) => new Date(b.StartDate).getTime() - new Date(a.StartDate).getTime());
117: 
118:     workEntries.forEach((entry) => {
119:       const entryAchievements = careerData.Structured_Achievements.filter(
120:         (a) => a.Entry_ID === entry.Entry_ID
121:       );
122:       if (entryAchievements.length > 0) {
123:         md += `${entry.Role}\n${entry.Organization} | ${entry.StartDate} - ${entry.EndDate}\n\n`;
124:         entryAchievements.forEach((ach) => {
125:           md += `- ${ach.Action_Verb} ${ach.Noun_Task} ${ach.Strategy} resulting in ${ach.Outcome}.\n`;
126:         });
127:         md += '\n';
128:       }
129:     });
130: 
131:     md += `Skills\n${careerData.Master_Skills_Inventory.map((s) => s.Skill_Name).join(', ')}\n`;
132:     return md;
133:   };
134: 
135:   const exportToMarkdown = (documentType?: 'resume' | 'coverLetter' | 'ksc') => {
136:     const target = documentType || activeTab;
137:     if (target === 'resume' && analysis) {
138:       const md = getFullResumeText();
139:       const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
140:       saveAs(blob, 'Tailored_Resume.md');
141:     } else if (target === 'coverLetter' && analysis) {
