142: 
143:         {isLoading ? (
144:           <div className="rounded-placard border border-concrete-grey/10 p-8">
145:             <p className="font-mono text-sm text-concrete-grey uppercase tracking-[0.18em]">
146:               Loading tracker board…
147:             </p>
148:           </div>
149:         ) : trackerApplications.length === 0 ? (
150:           <EmptyState
151:             icon={FileText}
152:             title="No applications yet"
153:             description="Track every role you apply to. Start by generating your first application pack."
154:             ctaLabel="Add your first application →"
155:             ctaHref="/apply"
156:             className="border-concrete-grey/25 bg-asphalt-black/35"
157:           />
158:         ) : (
159:           <>
160:             <div className="flex gap-6 overflow-x-auto pb-8 snap-x">
161:               {TRACKER_COLUMNS.map((column) => (
162:                 <KanbanColumn
163:                   key={column.id}
