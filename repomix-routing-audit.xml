 79:         </div>
 80:       </div>
 81: 
 82:       {/* Stepper Section - M3 Expressive Pebble Shape Tabs */}
 83:       <div className="flex gap-2">
 84:         {steps.map((step, idx) => {
 85:           const isCompleted = idx < currentStep;
 86:           const isCurrent = idx === currentStep;
 87: 
 88:           return (
 89:             <motion.div
 90:               key={idx}
 91:               className={`
 92:                 flex-1 px-4 py-3 text-center
 93:                 ${
 94:                   isCurrent
 95:                     ? 'bg-primary-container text-on-primary-container font-bold shadow-sm'
 96:                     : isCompleted
 97:                       ? 'bg-secondary-container text-on-secondary-container'
 98:                       : 'bg-surface-container-high text-on-surface-variant'
 99:                 }
100:               `}
101:               style={{ clipPath: 'var(--md-ref-shape-pebble)' }}
102:               whileHover={{ scale: 1.02 }}
103:               whileTap={{ scale: 0.98 }}
