 42: /**
 43:  * AuthPage Bridge
 44:  * Handles /auth canonical route with mode detection
 45:  */
 46: function AuthPage() {
 47:   const location = useLocation();
 48:   const searchParams = new URLSearchParams(location.search);
 49:   const mode = (searchParams.get('mode') as 'login' | 'register') || 'login';
 50: 
 51:   return (
 52:     <Scaffold>
 53:       <AuthModal mode={mode} />
 54:     </Scaffold>
 55:   );
 56: }
