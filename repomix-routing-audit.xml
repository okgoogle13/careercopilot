139:                   'Optimal match. Good chance of passing ATS.'}
140:                 {score.overallScore >= 70 &&
141:                   score.overallScore < 80 &&
142:                   'Acceptable match. Some optimization recommended.'}
143:                 {score.overallScore < 70 && 'Failing match. High risk of automatic rejection.'}
144:               </>
145:             ) : (
146:               <>
147:                 {score.overallScore >= 80 && 'Excellent match! Your document is highly optimized.'}
148:                 {score.overallScore >= 60 &&
149:                   score.overallScore < 80 &&
150:                   'Good match, but some optimization could help.'}
151:                 {score.overallScore < 60 && 'Needs significant optimization to pass ATS filters.'}
152:               </>
153:             )}
154:           </p>
155:         </motion.div>
156:       )}
157:     </div>
158:   );
159: }
</file>

