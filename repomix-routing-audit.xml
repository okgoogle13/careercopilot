<file path="frontend/src/features/applications/trackerTypes.ts">
 1: import type { Application, ApplicationStatus, ApplicationUpdate } from '@/api/applicationService';
 2: 
 3: export type TrackerStage = 'applied' | 'interviewing' | 'offer' | 'rejected' | 'archived';
 4: 
 5: export interface TrackerColumnDefinition {
 6:   id: TrackerStage;
 7:   name: string;
 8:   description: string;
 9: }
10: 
11: export const TRACKER_COLUMNS: TrackerColumnDefinition[] = [
12:   { id: 'applied', name: 'Applied', description: 'Application submitted' },
13:   { id: 'interviewing', name: 'Interviewing', description: 'Interview process active' },
14:   { id: 'offer', name: 'Offer', description: 'Offer or advanced-stage discussion' },
15:   { id: 'rejected', name: 'Rejected', description: 'Application closed out' },
16:   { id: 'archived', name: 'Archived', description: 'Hidden from the active board' },
17: ];
18: 
19: export interface TrackerApplication extends Application {
20:   trackerStage: TrackerStage;
21:   locationLabel: string;
22:   appliedLabel: string;
23: }
24: 
25: export interface ApplicationEditPayload {
26:   jobTitle?: string;
27:   companyName?: string;
28:   jobDescription?: string;
29:   notes?: string;
30: }
31: 
32: export function mapStatusToTrackerStage(status: ApplicationStatus): TrackerStage {
33:   switch (status) {
34:     case 'interviewing':
35:       return 'interviewing';
36:     case 'offer':
37:       return 'offer';
38:     case 'rejected':
39:       return 'rejected';
40:     case 'archived':
41:       return 'archived';
42:     case 'withdrawn':
43:       return 'archived';
44:     case 'draft':
45:     case 'applied':
46:     default:
47:       return 'applied';
48:   }
49: }
50: 
51: export function mapTrackerStageToStatus(stage: TrackerStage): ApplicationStatus {
52:   switch (stage) {
53:     case 'interviewing':
54:       return 'interviewing';
55:     case 'offer':
56:       return 'offer';
57:     case 'rejected':
58:       return 'rejected';
59:     case 'archived':
60:       return 'archived';
61:     case 'applied':
62:     default:
63:       return 'applied';
64:   }
65: }
66: 
67: export function toTrackerApplication(application: Application): TrackerApplication {
68:   return {
69:     ...application,
70:     trackerStage: mapStatusToTrackerStage(application.status),
71:     locationLabel:
72:       application.applicationMetadata?.location ??
73:       application.metadata?.location ??
74:       'Location pending',
75:     appliedLabel: application.appliedDate
76:       ? new Date(application.appliedDate).toLocaleDateString()
77:       : 'Not submitted',
78:   };
79: }
80: 
81: export function buildApplicationUpdatePayload(
82:   patch: Partial<ApplicationEditPayload> & { status?: ApplicationStatus }
83: ): ApplicationUpdate {
84:   return {
85:     ...patch,
86:   };
87: }
