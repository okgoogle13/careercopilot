 78: export const RequireAuth = () => {
 79:   const { user, loading } = useAuth();
 80:   const location = useLocation();
 81: 
 82:   // Check for demo/guest mode.
 83:   // NOTE: '?dev=bypass' override is handled centrally in AuthContext.tsx for dev simulation.
 84:   const searchParams = new URLSearchParams(location.search);
 85:   const isDemoMode = searchParams.get('demo') === 'true';
 86: 
 87:   if (loading) {
 88:     return (
 89:       <div className="min-h-screen bg-[var(--sys-color-charcoalBackground-base)] flex items-center justify-center text-[var(--sys-color-worker-ash-base)]">
 90:         Loading...
 91:       </div>
 92:     );
 93:   }
 94: 
 95:   // Allow access if authenticated OR in demo mode
 96:   if (!user && !isDemoMode) {
 97:     return (
 98:       <Navigate
 99:         to="/auth"
100:         replace
101:       />
102:     );
103:   }
104: 
105:   return <Outlet />;
106: };
