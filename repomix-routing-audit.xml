<file path="frontend/src/config/routeModeMap.ts">
 1: /**
 2:  * Route-to-Mode Mapping Configuration
 3:  *
 4:  * ⚠️  DO NOT EDIT MANUALLY.
 5:  * This map is derived automatically from ROUTE_REGISTRY in route-registry.ts.
 6:  * To change a route's mode, update the `mode` field there.
 7:  */
 8: 
 9: import { ROUTE_REGISTRY } from './route-registry';
10: import type { AppMode } from '../stores/useModeStore';
11: 
12: export interface RouteModeConfig {
13:   path: string;
14:   mode: AppMode;
15:   exact?: boolean;
16: }
17: 
18: /**
19:  * Route-to-mode mapping derived from ROUTE_REGISTRY.
20:  * Sorted by path length descending (longest/most specific first).
21:  */
22: export const ROUTE_MODE_MAP: RouteModeConfig[] = ROUTE_REGISTRY.map((r) => ({
23:   path: r.path,
24:   mode: r.mode,
25: }));
26: 
27: /**
28:  * Determine the appropriate mode for a given pathname
29:  * Uses longest-match-first algorithm to handle nested routes correctly
30:  *
31:  * Example:
32:  * getModeForRoute('/documents/upload') → 'KrDark' (matches /documents)
33:  * getModeForRoute('/unknown') → 'KrDark' (default fallback)
34:  *
35:  * @param pathname - Current route pathname
36:  * @returns AppMode ('KrDark' | 'KrDark')
37:  */
38: export function getModeForRoute(pathname: string): AppMode {
39:   // Sort routes by path length descending (longest/most specific first)
40:   const sortedRoutes = [...ROUTE_MODE_MAP].sort((a, b) => b.path.length - a.path.length);
41: 
42:   // Find first matching route
43:   const matchedRoute = sortedRoutes.find((route) => {
44:     if (route.exact) {
45:       // Exact match required
46:       return pathname === route.path;
47:     }
48:     // Prefix match (route path is start of pathname)
49:     return pathname.startsWith(route.path);
50:   });
51: 
52:   // Return matched mode or default to KrDark for unknown routes
53:   return matchedRoute?.mode ?? 'KrDark';
54: }
55: 
56: /**
57:  * Check if a route should have automatic mode switching enabled
58:  * Can be extended to exclude specific routes from auto-switching
59:  *
60:  * @param pathname - Current route pathname
61:  * @returns boolean - Whether auto-switching should apply
62:  */
63: export function shouldAutoSwitchMode(pathname: string): boolean {
64:   // List of routes that should NOT trigger auto-switching
65:   // (can be extended as needed)
66:   const excludedPaths: string[] = [
67:     // Future: Add paths like '/admin/*' if manual control needed
68:   ];
69: 
70:   // Return true if pathname is NOT in excluded list
71:   return !excludedPaths.some((excluded) => pathname.startsWith(excluded));
72: }
73: 
74: /**
75:  * Helper to get all routes for a specific mode
76:  * Useful for testing and documentation
77:  *
78:  * @param mode - Mode to filter routes by
79:  * @returns Array of route paths for the given mode
80:  */
81: export function getRoutesForMode(mode: AppMode): string[] {
82:   return ROUTE_MODE_MAP.filter((route) => route.mode === mode).map((route) => route.path);
83: }
</file>

<file path="frontend/src/features/applications/components/ApplicationArchiveAction.tsx">
 1: import { applicationService } from '@/api/applicationService';
 2: import { Strike } from '@/components/ui';
 3: import { useMutation } from '@tanstack/react-query';
 4: 
 5: export interface ApplicationArchiveActionProps {
 6:   applicationId: string;
 7:   isArchived: boolean;
 8:   onArchive: () => void;
 9:   onRestore: () => void;
10: }
11: 
12: export const ApplicationArchiveAction = ({
13:   applicationId,
14:   isArchived,
15:   onArchive,
16:   onRestore,
17: }: ApplicationArchiveActionProps): React.ReactElement => {
18:   const archiveApplication = useMutation({
19:     mutationFn: async () =>
20:       applicationService.updateApplication(applicationId, { status: 'archived' }),
21:     onSuccess: () => {
22:       onArchive();
23:     },
24:   });
25: 
26:   const restoreApplication = useMutation({
27:     mutationFn: async () =>
28:       applicationService.updateApplication(applicationId, { status: 'applied' }),
29:     onSuccess: () => {
30:       onRestore();
31:     },
32:   });
33: 
34:   const isPending = archiveApplication.isPending || restoreApplication.isPending;
35: 
36:   return (
37:     <Strike
38:       variant={isArchived ? 'secondary' : 'destructive'}
39:       size="sm"
40:       className="w-full"
41:       onClick={() => {
42:         if (isArchived) {
43:           restoreApplication.mutate();
44:         } else {
45:           archiveApplication.mutate();
46:         }
47:       }}
48:       isLoading={isPending}
49:     >
50:       {isArchived ? 'Restore Application' : 'Archive Application'}
51:     </Strike>
52:   );
53: };
54: 
55: export default ApplicationArchiveAction;
</file>

