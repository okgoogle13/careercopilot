 13: 
 14: interface UseStudioMatchProps {
 15:   careerData: CareerDatabase;
 16:   job: JobOpportunity;
 17:   onUpdate?: (data: CareerDatabase) => void;
 18:   userId?: string;
 19:   onAnalyze: (careerData: CareerDatabase, job: JobOpportunity) => Promise<MatchAnalysis>;
 20:   onSave: (userId: string, data: CareerDatabase) => Promise<void>;
 21: }
 22: 
 23: export function useStudioMatch({
 24:   careerData,
 25:   job,
 26:   onUpdate,
 27:   userId,
 28:   onAnalyze,
 29:   onSave,
 30: }: UseStudioMatchProps) {
 31:   const [analysis, setAnalysis] = useState<MatchAnalysis | null>(null);
 32:   const [isLoading, setIsLoading] = useState(false);
 33:   const [error, setError] = useState<string | null>(null);
 34: 
 35:   const [activeTab, setActiveTab] = useState<
 36:     'resume' | 'coverLetter' | 'ksc' | 'analysis' | 'export'
 37:   >('analysis');
 38:   const [completedSteps, setCompletedSteps] = useState<string[]>(['analysis']);
 39: 
 40:   const [selectedTemplate, setSelectedTemplate] = useState<TemplateStyle>(RESUME_TEMPLATES[0]);
 41:   const [showAudit, setShowAudit] = useState(false);
 42:   const [coverLetterContent, setCoverLetterContent] = useState('');
 43:   const [isSaving, setIsSaving] = useState(false);
 44:   const [saveSuccess, setSaveSuccess] = useState(false);
 45:   const [locale, setLocale] = useState<'US' | 'UK/AU'>('US');
 46:   const [hasSelectionCriteria, setHasSelectionCriteria] = useState(false);
 47: 
 48:   const resumeRef = useRef<HTMLDivElement>(null);
 49:   const kscRef = useRef<HTMLDivElement>(null);
 50: 
 51:   const { exportToPDF, exportToDOCX, getFullResumeText } = useDocumentExport({
 52:     activeTab,
 53:     analysis,
 54:     careerData,
 55:     selectedTemplate,
 56:     coverLetterContent,
 57:     resumeRef,
 58:     kscRef,
 59:   });
 60: 
 61:   const jobDescriptionText = `${job.Job_Title} at ${job.Company_Name}\n${job.Key_Responsibilities?.join('\n') || ''}\n${job.Required_Hard_Skills?.join('\n') || ''}`;
 62: 
 63:   const resumeScoring = useATSScoring(getFullResumeText(), jobDescriptionText, 'resume');
 64:   const coverLetterScoring = useATSScoring(coverLetterContent, jobDescriptionText, 'coverLetter');
 65: 
 66:   const [isGeneratingCoverLetter, setIsGeneratingCoverLetter] = useState(false);
 67:   const [isGeneratingKSC, setIsGeneratingKSC] = useState(false);
 68:   const [coverLetterInstructions, setCoverLetterInstructions] = useState('');
 69:   const [kscInstructions, setKscInstructions] = useState('');
 70: 
 71:   const unlockStep = (step: string) => {
 72:     if (!completedSteps.includes(step)) {
 73:       setCompletedSteps((prev) => [...prev, step]);
 74:     }
 75:     setActiveTab(step as any);
 76:   };
 77: 
 78:   const handleAnalyze = async () => {
 79:     setIsLoading(true);
 80:     setError(null);
 81:     try {
 82:       let result = await onAnalyze(careerData, job);
 83:       if (result.Overall_Fit_Score < 70) {
 84:         const retryResult = await onAnalyze(careerData, job);
 85:         if (retryResult.Overall_Fit_Score > result.Overall_Fit_Score) {
 86:           result = retryResult;
 87:         }
 88:       }
 89:       setAnalysis(result);
 90:       setCoverLetterContent(result.Cover_Letter_Draft || '');
 91:       setHasSelectionCriteria(
 92:         !!result.KSC_Responses_Drafts && result.KSC_Responses_Drafts.length > 0
 93:       );
 94:       setActiveTab('analysis');
 95:       setCompletedSteps(['analysis']);
 96:     } catch (err) {
 97:       setError(err instanceof Error ? err.message : 'Unknown error');
 98:     } finally {
 99:       setIsLoading(false);
100:     }
101:   };
102: 
103:   const handleGenerateCoverLetter = async () => {
104:     setIsGeneratingCoverLetter(true);
105:     try {
106:       const result = await genkitService.generateCoverLetter(
107:         careerData,
108:         job,
109:         coverLetterInstructions
110:       );
111:       setAnalysis((prev) =>
112:         prev
113:           ? {
114:               ...prev,
115:               Cover_Letter_Draft: result.Cover_Letter_Draft,
116:               Cover_Letter_Audit: result.Cover_Letter_Audit as any,
117:             }
118:           : null
119:       );
120:       setCoverLetterContent(result.Cover_Letter_Draft);
121:       unlockStep('coverLetter');
122:       setCoverLetterInstructions('');
123:     } catch (err) {
124:       console.error('Failed to generate cover letter:', err);
125:     } finally {
126:       setIsGeneratingCoverLetter(false);
127:     }
128:   };
129: 
130:   const handleGenerateKSC = async () => {
131:     setIsGeneratingKSC(true);
132:     try {
133:       const result = await genkitService.generateKSCResponses(careerData, job, kscInstructions);
134:       setAnalysis((prev) =>
135:         prev ? { ...prev, KSC_Responses_Drafts: result.KSC_Responses_Drafts as any } : null
136:       );
137:       setHasSelectionCriteria(true);
138:       unlockStep('ksc');
139:       setKscInstructions('');
140:     } catch (err) {
141:       console.error('Failed to generate KSC:', err);
142:     } finally {
143:       setIsGeneratingKSC(false);
144:     }
145:   };
146: 
147:   const saveDocument = async (content: string) => {
148:     if (!userId || !analysis || !onUpdate) return;
149:     const newDoc: SavedDocument = {
150:       id: crypto.randomUUID(),
151:       jobTitle: job.Job_Title,
152:       companyName: job.Company_Name,
153:       dateSaved: new Date().toISOString(),
154:       coverLetter: content,
155:       tailoredSummary: analysis.Tailored_Summary,
156:     };
157: 
158:     const updatedData = {
159:       ...careerData,
160:       Saved_Documents: [...(careerData.Saved_Documents || []), newDoc],
161:     };
162: 
163:     await onSave(userId!, updatedData);
164:     onUpdate(updatedData);
165:   };
166: 
167:   // Fix hook path from `useAutoSave`
168:   const {
169:     isSaving: isAutoSaving,
170:     lastSaved,
171:     save,
172:   } = useAutoSave(userId, coverLetterContent, saveDocument);
173: 
174:   const handleSaveToProfile = async () => {
175:     setIsSaving(true);
176:     try {
177:       await save(coverLetterContent);
178:       setSaveSuccess(true);
179:       setTimeout(() => setSaveSuccess(false), 3000);
180:     } catch (err) {
181:       console.error('Failed to save document:', err);
182:     } finally {
183:       setIsSaving(false);
184:     }
185:   };
186: 
187:   const handleCopyToClipboard = () => {
188:     const text =
189:       activeTab === 'resume'
190:         ? getFullResumeText()
191:         : activeTab === 'coverLetter'
192:           ? coverLetterContent
193:           : analysis?.KSC_Responses_Drafts?.map((k) => `${k.KSC_Prompt}\n${k.Response}`).join(
194:               '\n\n'
195:             ) || '';
196:     navigator.clipboard.writeText(text);
197:     alert('Copied to clipboard for ATS parsing!');
198:   };
199: 
200:   return {
201:     analysis,
202:     isLoading,
203:     error,
204:     activeTab,
205:     setActiveTab,
206:     completedSteps,
207:     selectedTemplate,
208:     setSelectedTemplate,
209:     showAudit,
210:     setShowAudit,
211:     coverLetterContent,
212:     setCoverLetterContent,
213:     isSaving,
214:     saveSuccess,
215:     locale,
216:     setLocale,
217:     hasSelectionCriteria,
218:     resumeRef,
219:     kscRef,
220:     exportToPDF,
221:     exportToDOCX,
222:     resumeScoring,
223:     coverLetterScoring,
224:     isGeneratingCoverLetter,
225:     isGeneratingKSC,
226:     coverLetterInstructions,
227:     setCoverLetterInstructions,
228:     kscInstructions,
229:     setKscInstructions,
230:     handleAnalyze,
231:     handleGenerateCoverLetter,
232:     handleGenerateKSC,
233:     handleSaveToProfile,
234:     handleCopyToClipboard,
235:     unlockStep,
236:     isAutoSaving,
237:     lastSaved,
