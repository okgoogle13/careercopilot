230: export function LayoutSlopAuditor({ onInteraction }: { onInteraction?: () => void }) {
231:   const [isMonitoring, setIsMonitoring] = useState(false);
232:   const [violations, setViolations] = useState<string[]>([]);
233:   const [currentDelta, setCurrentDelta] = useState({ dw: 0, dh: 0 });
234:   const [testType, setTestType] = useState<'correct' | 'wrong'>('correct');
235:   const [isHovered, setIsHovered] = useState(false);
236:   const elementRef = useRef<HTMLDivElement>(null);
237:   const baselineRef = useRef<{ width: number; height: number } | null>(null);
238: 
239:   useEffect(() => {
240:     if (!isMonitoring || !elementRef.current) return;
241: 
242:     const observer = new ResizeObserver((entries) => {
243:       for (const entry of entries) {
244:         const { width, height } = entry.contentRect;
245: 
246:         if (!baselineRef.current) {
247:           baselineRef.current = { width, height };
248:           return;
249:         }
250: 
251:         const dW = Math.abs(width - baselineRef.current.width);
252:         const dH = Math.abs(height - baselineRef.current.height);
253: 
254:         setCurrentDelta({ dw: dW, dh: dH });
255: 
256:         if (dW > 0.5 || dH > 0.5) {
257:           const timestamp = new Date().toLocaleTimeString([], {
258:             hour12: false,
259:             minute: '2-digit',
260:             second: '2-digit',
261:           });
262:           setViolations((prev) => {
263:             const msg = `[${timestamp}] SLOP: ${dW.toFixed(1)}px width | ${dH.toFixed(1)}px height`;
264:             if (prev[0]?.split('] ')[1] === msg.split('] ')[1]) return prev; // Avoid duplicates
265:             return [msg, ...prev].slice(0, 5);
266:           });
267:         }
268:       }
269:     });
270: 
271:     observer.observe(elementRef.current);
272:     return () => observer.disconnect();
273:   }, [isMonitoring, testType]);
274: 
275:   const start = () => {
276:     baselineRef.current = null;
277:     setViolations([]);
278:     setCurrentDelta({ dw: 0, dh: 0 });
279:     setIsMonitoring(true);
280:     onInteraction?.();
281:   };
282: 
283:   return (
284:     <div className="p-8 bg-surface-container rounded-strike border border-[var(--kr-color-concrete-grey-steps-0)] space-y-6 shadow-xl">
285:       <div className="flex flex-wrap items-center justify-between gap-4">
286:         <h3 className="text-title-large font-bold flex items-center gap-2">
287:           <AlertTriangle className="w-6 h-6 text-warning" />
288:           Layout Slop Auditor
289:         </h3>
290:         <Strike
291:           variant={isMonitoring ? 'destructive' : 'primary'}
292:           size="sm"
293:           onClick={isMonitoring ? () => setIsMonitoring(false) : start}
294:           className={cn(isMonitoring && 'animate-pulse')}
295:         >
296:           {isMonitoring ? 'STOP / RESET' : 'START AUDIT'}
297:         </Strike>
298:       </div>
299: 
300:       <div className="flex gap-2 p-1 bg-surface-dim rounded-strike border border-outline/20 w-fit">
301:         <button
302:           type="button"
303:           onClick={() => {
304:             setTestType('correct');
305:             setViolations([]);
306:             baselineRef.current = null;
307:           }}
308:           className={`px-4 py-1.5 rounded-strike text-[10px] font-bold uppercase transition-all ${testType === 'correct' ? 'bg-primary text-on-primary shadow-sm' : 'text-on-surface/60 hover:text-on-surface'}`}
309:         >
310:           Optimal (GRAD)
311:         </button>
312:         <button
313:           type="button"
314:           onClick={() => {
315:             setTestType('wrong');
316:             setViolations([]);
317:             baselineRef.current = null;
318:           }}
319:           className={`px-4 py-1.5 rounded-strike text-[10px] font-bold uppercase transition-all ${testType === 'wrong' ? 'bg-error text-on-error shadow-sm' : 'text-on-surface/60 hover:text-on-surface'}`}
320:         >
321:           Sloppy (Weight)
322:         </button>
323:       </div>
324: 
325:       <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
326:         <div
327:           className="h-44 bg-surface-dim rounded-strike border-2 border-dashed border-outline/40 flex items-center justify-center relative overflow-hidden group hover:border-primary/40 transition-colors"
328:           onMouseEnter={() => setIsHovered(true)}
329:           onMouseLeave={() => setIsHovered(false)}
330:         >
331:           <div className="absolute top-2 left-3 text-[9px] font-mono opacity-20 uppercase tracking-[0.2em]">
332:             Interaction Zone
333:           </div>
334:           {testType === 'correct' ? (
335:             <motion.div
336:               ref={elementRef}
337:               className="text-2xl font-display text-worker-ash cursor-help"
338:               style={{ fontVariationSettings: "'wght' 400, 'GRAD' 0" }}
339:               animate={{
340:                 fontVariationSettings: isHovered
341:                   ? "'wght' 400, 'GRAD' 150'"
342:                   : "'wght' 400, 'GRAD' 0'",
343:               }}
344:               transition={KrDarkSpring}
345:             >
346:               Stable Layout
347:             </motion.div>
348:           ) : (
349:             <motion.div
350:               ref={elementRef}
351:               className="text-2xl font-display text-solidarity-crimson cursor-help"
352:               initial={{ fontWeight: 400 }}
353:               animate={{ fontWeight: isHovered ? 800 : 400 }}
354:               transition={KrDarkSpring}
355:             >
356:               Reflow Risk
357:             </motion.div>
358:           )}
359:           {isHovered && (
360:             <div className="absolute bottom-2 text-[8px] font-mono text-primary animate-bounce">
361:               INTERACTING...
362:             </div>
363:           )}
364:         </div>
365: 
366:         <div
367:           className={cn(
368:             'p-5 rounded-strike border transition-all duration-500 flex flex-col gap-4',
369:             violations.length
370:               ? 'bg-error/5 border-error/40'
371:               : isMonitoring
372:                 ? 'bg-primary/5 border-primary/40'
373:                 : 'bg-surface-dim border-outline/20'
374:           )}
375:         >
376:           <div className="flex justify-between items-center">
377:             <div className="flex items-center gap-2 text-xs font-bold uppercase tracking-wider">
378:               {violations.length ? (
379:                 <div className="w-2 h-2 rounded-full bg-error animate-ping" />
380:               ) : (
381:                 <div
382:                   className={`w-2 h-2 rounded-full ${isMonitoring ? 'bg-primary animate-pulse' : 'bg-outline'}`}
383:                 />
384:               )}
385:               {violations.length
386:                 ? 'Violations Logged'
387:                 : isMonitoring
388:                   ? 'Monitoring Active'
389:                   : 'Auditor Idle'}
390:             </div>
391:             {isMonitoring && (
392:               <div className="text-[10px] font-mono opacity-60">
393:                 ΔW: {currentDelta.dw.toFixed(1)}px
394:               </div>
395:             )}
396:           </div>
397: 
398:           <div className="flex-grow space-y-2 text-[10px] font-mono overflow-y-auto max-h-24 custom-scrollbar">
399:             {violations.length ? (
400:               violations.map((v, i) => (
401:                 <div
402:                   key={i}
403:                   className="flex gap-2 text-error animate-in fade-in slide-in-from-left-1 border-b border-error/10 pb-1"
404:                 >
405:                   <span className="opacity-40">!</span>
406:                   {v}
407:                 </div>
408:               ))
409:             ) : (
410:               <div className="text-on-surface-variant/50 leading-relaxed italic">
411:                 {isMonitoring
412:                   ? "Move cursor over the Interaction Zone. Stable layouts use 'GRAD' (0px shift); sloppy layouts shift bounding box width via standard 'wght'."
413:                   : "Click 'Start Audit' to initialize baseline dimensions."}
414:               </div>
415:             )}
416:           </div>
417:         </div>
418:       </div>
419:     </div>
420:   );
421: }
