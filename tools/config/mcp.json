{
  "_comment": "Claude Desktop / legacy MCP config. The canonical single source of truth is .vscode/mcp.json. Update that file first, then keep this in sync. Run 'python3 scripts/validate-mcp.py' to verify both configs.",
  "mcpServers": {
    "flash-sidekick": {
      "command": "python3",
      "args": ["servers/flash_sidekick.py"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "design-system-sidekick": {
      "command": "python3",
      "args": ["servers/design_system_sidekick.py"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "vision-scorer-mcp": {
      "command": "python3",
      "args": ["servers/vision_scorer_mcp.py"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "perplexity": {
      "command": "python3",
      "args": ["servers/perplexity_server.py"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "task-router": {
      "command": "python3",
      "args": ["servers/task_router_mcp.py"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git", "--repository", "."]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
